    end)

    task.delay(0.15, function()
        TweenService:Create(titleLbl, TweenFast, {TextTransparency = 0}):Play()
    end)
    task.delay(0.25, function()
        TweenService:Create(contentLbl, TweenFast, {TextTransparency = 0}):Play()
    end)

    local duration = options.Duration or 3
    TweenService:Create(progressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    task.spawn(function()
        task.wait(duration)
        TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        TweenService:Create(notifStroke, TweenFast, {Transparency = 1}):Play()
        TweenService:Create(titleLbl, TweenFast, {TextTransparency = 1}):Play()
        TweenService:Create(contentLbl, TweenFast, {TextTransparency = 1}):Play()
        task.delay(0.35, function() notif:Destroy() end)
    end)
end

