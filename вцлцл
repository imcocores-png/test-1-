    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 1)
    indCorner.Parent = indicator

    local pageFrame = Instance.new("Frame")
    pageFrame.Name = name .. "Page"
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.Visible = false
    pageFrame.ZIndex = 3
    pageFrame.Parent = PagesFrame

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.FillDirection = Enum.FillDirection.Horizontal
    pageLayout.Parent = pageFrame

    local tabData = {
        Button = tabBtn,
        Page = pageFrame,
        Name = name,
        Indicator = indicator
    }

    tabBtn.MouseButton1Click:Connect(function()
        playSound(UI_CLICK, 0.2)
        if CurrentTab then
            TweenService:Create(CurrentTab.Button, TweenFast, {
                BackgroundColor3 = Colors.TabIdle,
                TextColor3 = Colors.TextDim,
                TextTransparency = 0.3
            }):Play()
            TweenService:Create(CurrentTab.Indicator, TweenFast, {Size = UDim2.new(0, 0, 0, 2)}):Play()
            
            for _, child in pairs(CurrentTab.Page:GetChildren()) do
                if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                    TweenService:Create(child, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = 1
                    }):Play()
                end
            end
            task.delay(0.1, function() CurrentTab.Page.Visible = false end)
        end
        
        TweenService:Create(tabBtn, TweenFast, {
            BackgroundColor3 = Colors.TabActive,
            TextColor3 = Colors.Accent,
            TextTransparency = 0
        }):Play()
        TweenService:Create(indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, 2)
        }):Play()
        
        pageFrame.Visible = true
        
        for i, child in pairs(pageFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                child.BackgroundTransparency = 1
                task.delay(i * 0.05, function()
                    TweenService:Create(child, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0
                    }):Play()
                end)
            end
        end
        
        CurrentTab = tabData
    end)

    tabBtn.MouseEnter:Connect(function()
        if CurrentTab ~= tabData then
            playSound(UI_HOVER, 0.05)
            TweenService:Create(tabBtn, TweenFast, {
                BackgroundColor3 = Colors.TabHover,
                TextTransparency = 0
            }):Play()
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 4, 0, 30)
            }):Play()
        end
    end)

    tabBtn.MouseLeave:Connect(function()
        if CurrentTab ~= tabData then
            TweenService:Create(tabBtn, TweenFast, {
                BackgroundColor3 = Colors.TabIdle,
                TextTransparency = 0.3
            }):Play()
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 30)
            }):Play()
        end
    end)

    Tabs[name] = tabData
    return tabData
end

