    TweenService:Create(Main, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 520, 0, 420),
        Position = UDim2.new(0.5, -260, 0.5, -210),
        BackgroundTransparency = 0
    }):Play()
    
    task.delay(0.3, function()
        TweenService:Create(MainStroke, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            Transparency = 0,
            Color = Colors.Accent
        }):Play()
        task.delay(0.6, function()
            TweenService:Create(MainStroke, TweenInfo.new(0.5), {
                Color = Color3.fromRGB(40, 40, 50)
            }):Play()
        end)
    end)
    
    task.spawn(function()
        while leavesRunning and Main.Parent do
            createLeaf()
            task.wait(math.random(0.3, 0.8))
        end
    end)
end

