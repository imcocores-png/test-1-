-- ====================== ANTI GRAB ULTRA (всё-в-одном) ======================
local aguOn = false
local aguConns = {}

local function applyGrabUltra(char)
    if not char or not aguOn then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local head = char:FindFirstChild("Head", 5)
        if not (hum and hrp and head) then return end
        local IsHeld = LocalPlayer:FindFirstChild("IsHeld")

        local function disableCons()
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                    v.BallSocketConstraint.Enabled = false
                    if v:FindFirstChild("RagdollLimbPart") then
                        v.RagdollLimbPart.WeldConstraint.Enabled = false
                    end
                end
            end
        end
        disableCons()

        -- WATCER 1: IsHeld -> полный бой (Unbind-спам + анкор + ходьба + состояние)
        if IsHeld then
            table.insert(aguConns, IsHeld:GetPropertyChangedSignal("Value"):Connect(function()
                if not aguOn or not IsHeld.Value then return end
                hrp.Anchored = true
                task.spawn(function()
                    while aguOn and IsHeld.Value do
                        pcall(function()
                            ReplicatedStorage.CharacterEvents.Struggle:FireServer("Unbind")
                            ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.Anchored = true
                            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * 0.5)
                            hum.Sit = false
                            hum.AutoRotate = true
                        end)
                        task.wait()
                    end
                    pcall(function()
                        ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                        hrp.Anchored = head:FindFirstChild("PartOwner") ~= nil
                    end)
                end)
            end))
        end

        -- WATCHER 2: PartOwner на голове (мгновенная реакция)
        table.insert(aguConns, head.ChildAdded:Connect(function(obj)
            if obj.Name == "PartOwner" and aguOn then
                task.spawn(function()
                    while aguOn and (head:FindFirstChild("PartOwner") or (IsHeld and IsHeld.Value)) do
                        pcall(function()
                            ReplicatedStorage.CharacterEvents.Struggle:FireServer("Unbind")
                            ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                        end)
                        task.wait()
                    end
                end)
            end
        end))

        -- WATCHER 3: WeldHRP (голова не отлетает)
        local weldHRP = hrp:WaitForChild("WeldHRP", 5)
        if weldHRP then
            table.insert(aguConns, weldHRP.Changed:Connect(function()
                if weldHRP.Enabled and aguOn then
                    task.spawn(function()
                        hum.AutoRotate = true
                        hum.HipHeight = 1
                        while weldHRP.Enabled and aguOn and hrp.Parent do
                            pcall(function() head.CFrame = hrp.CFrame + Vector3.new(0, 1.35, 0) end)
                            task.wait()
                        end
                        if hum.Parent then hum.HipHeight = 0 end
                    end)
                end
            end))
        end
    end)
end

DefGroup:AddCheckbox("AntiGrabUltra", {
    Text = "Anti Grab ULTRA (All-in-One)",
    Default = false,
    Callback = function(Value)
        aguOn = Value
        for _, c in ipairs(aguConns) do pcall(function() c:Disconnect() end) end
