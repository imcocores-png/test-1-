DefKick:AddCheckbox("AntiKickPCLD", {
    Text = "Anti Kick (PCLD)",
    Default = false,
    Callback = function(v)
        pcldOn = v
        if v then
            pcldTask = task.spawn(function()
                Library:Notify({Title = "Kiop", Content = "Anti Kick PCLD ON", Duration = 3})
                while pcldOn do
                    pcall(function()
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if not (hum and hrp and hum.Health > 0) then task.wait(1) continue end

                        -- ищем наш PCLD (детектор позиции рядом с нами)
                        local myPCLD = nil
                        for _, obj in ipairs(Workspace:GetChildren()) do
                            if obj.Name == "PlayerCharacterLocationDetector" then
                                if (obj.Position - hrp.Position).Magnitude <= 3 then
                                    myPCLD = obj
                                    break
                                end
                            end
                        end

                        -- спамим ownership на PCLD — сервер думает что мы легально владеем позицией
                        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                        local sno = GE and GE:FindFirstChild("SetNetworkOwner")
                        if sno then
                            if myPCLD then
                                pcall(function() sno:FireServer(myPCLD, myPCLD.CFrame) end)
                            end
                            -- и на себя
                            pcall(function() sno:FireServer(hrp, hrp.CFrame) end)
                        end
                    end)
                    task.wait(0.1)
                end
            end)
        else
            if pcldTask then task.cancel(pcldTask); pcldTask = nil end
        end
    end
