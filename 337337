                                    end
                                    if not kunai then
                                        local t = tick()
                                        while canSpawn and not canSpawn.Value
                                            and UI.state.ShurikenAK
                                            and tick() - t < 5 do
                                            task.wait(0.1)
                                        end
                                        if not UI.state.ShurikenAK then return end
                                        task.spawn(function()
                                            pcall(function()
                                                spawnRF:InvokeServer("NinjaShuriken",
                                                    hrp.CFrame * CFrame.new(0, 12, 20),
                                                    Vector3.new(0, 0, 0))
                                            end)
                                        end)
                                        local inv2 = workspace:FindFirstChild(
                                            LocalPlayer.Name .. "SpawnedInToys")
                                        if inv2 then
                                            kunai = inv2:WaitForChild("NinjaShuriken", 3)
                                        end
                                        if not kunai then
                                            local house = sakFindHouse()
                                            if house then
                                                kunai = house:WaitForChild("NinjaShuriken", 2)
                                            end
                                        end
                                        if kunai then kunai.Name = "AntiKick" end
                                    end
                                    if kunai and kunai.Parent
                                        and kunai:FindFirstChild("StickyPart") then
                                        local sp = kunai.StickyPart
                                        local weld = sp:FindFirstChild("StickyWeld")
                                        local stuck = weld and weld.Part1 ~= nil
                                        local far =
                                            (hrp.Position - sp.Position).Magnitude >= 20
                                        if far then
                                            local mt2 = ReplicatedStorage:FindFirstChild("MenuToys")
                                            local destroy = mt2 and mt2:FindFirstChild("DestroyToy")
                                            if destroy then
