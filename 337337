local function ensureKickAlign(tHRP)
    if tHRP:FindFirstChild("KickAlign") then return end
    local oldBp = tHRP:FindFirstChildOfClass("BodyPosition")
    if oldBp then oldBp:Destroy() end

    local att0 = Instance.new("Attachment")
    att0.Name = "KickAtt0"
    att0.Parent = tHRP

    local att1 = Instance.new("Attachment")
    att1.Name = "KickAtt1"
    att1.Parent = workspace.Terrain

    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "KickAlign"
    alignPos.Attachment0 = att0
    alignPos.Attachment1 = att1
    alignPos.MaxForce = math.huge
    alignPos.Responsiveness = 200
    alignPos.Parent = tHRP

    local alignRot = Instance.new("AlignOrientation")
    alignRot.Name = "KickRot"
    alignRot.Attachment0 = att0
    alignRot.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignRot.CFrame = CFrame.new()
    alignRot.MaxTorque = math.huge
    alignRot.Responsiveness = 200
    alignRot.Parent = tHRP
end

--========================================================================--
--  KICK = 1 OWNER / 1 DESTROY (frame alternation)                          --
--                                                                          --
--  Pro base: one frame owner -> one frame destroy. Destroy frame WITHOUT   --
--  sno so the server really sees the victim in the air without grab ->     --
--  Flying. ~30 destroys/sec, every 2 frames. Stable: warmup after grab,    --
--  auto regrab if the grab actually fell off.                              --
--                                                                          --
--  FAR victim: FETCH - tp to the victim, sno spam, tp both back: me home,  --
--  victim above my head.                                                   --
--========================================================================--
local function runAccelerating(name, isActive, stopAt)
    local myChar = getChar()
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and myHRP) then return end
    local savedPos = myHRP.CFrame

    local grabbed = false
    local lastConfirmed = 0
    local regrabUntil = 0
    local frameCount = 0

    while isActive() and RunService.Heartbeat:Wait() do
        frameCount += 1

        local target = Players:FindFirstChild(name)
        if not target or not target.Parent then break end

        myChar = getChar()
        myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHead = myChar and myChar:FindFirstChild("Head")

        local tChar = target.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

        if not (myChar and myHRP and myHead) or not (tHRP and tHum) or tHum.Health <= 0 then
            continue
        end

        local dist = (tHRP.Position - myHRP.Position).Magnitude

        if dist <= 30 then
            ensureKickAlign(tHRP)

            local align = tHRP:FindFirstChild("KickAlign")
            if align and align.Attachment1 then
                align.Attachment1.WorldPosition = myHead.Position + Vector3.new(0, Kick.HoldHeight, 0)
            end
            local rot = tHRP:FindFirstChild("KickRot")
            if rot then
                rot.CFrame = CFrame.Angles(0, 0, 0)
            end

            tHum.PlatformStand = true

            local confirmed = CheckForPartOwner(tHRP)
                or (target:FindFirstChild("IsHeld") and target.IsHeld.Value)

            if not grabbed then
                -- WAITING FOR GRAB: sno every frame
                sno(tHRP)
                if confirmed then
                    grabbed = true
                    lastConfirmed = tick()
                    regrabUntil = tick() + Kick.Warmup
                end
            else
                if confirmed then
                    lastConfirmed = tick()
                end

                if tick() - lastConfirmed > Kick.LostGrace then
                    -- grab really lost -> regrab (sno only)
                    grabbed = false
                    sno(tHRP)
                elseif tick() < regrabUntil then
                    -- warmup / regrab: sno only
                    sno(tHRP)
                else
                    -- 1 OWNER / 1 DESTROY: destroy every N frames, frame WITHOUT sno
                    if frameCount % Kick.DestroyEvery == 0 then
                        pcall(function()
                            DestroyGrabRemote:FireServer(tHRP)
                        end)
                        if not Kick.SkipSnoOnDestroy then
                            sno(tHRP)
                        end
                    else
                        sno(tHRP)
                    end
                end
            end
        else
            -- FETCH: tp to victim -> sno spam -> tp both: me home, victim above me
            local fetchStart = tick()
            pcall(function()
                myChar:PivotTo(tHRP.CFrame * CFrame.new(0, 2, 4))
            end)
            ensureKickAlign(tHRP)

            while isActive() and tick() - fetchStart < Kick.FetchTime do
                task.wait(0.05)
                sno(tHRP)

                myChar = getChar()
                local mh = myChar and myChar:FindFirstChild("Head")
                local al = tHRP:FindFirstChild("KickAlign")
                if al and al.Attachment1 and mh then
                    al.Attachment1.WorldPosition = mh.Position + Vector3.new(0, Kick.HoldHeight, 0)
                end
            end

            pcall(function()
                myChar:PivotTo(savedPos)
                tHRP.CFrame = savedPos * CFrame.new(0, Kick.HoldHeight, 0)

                myChar = getChar()
                local mh = myChar and myChar:FindFirstChild("Head")
                local al = tHRP:FindFirstChild("KickAlign")
                if al and al.Attachment1 and mh then
                    al.Attachment1.WorldPosition = mh.Position + Vector3.new(0, Kick.HoldHeight, 0)
                end
            end)

            grabbed = false
        end

        if stopAt and os.clock() >= stopAt then break end
    end

    -- CLEANUP
    local target = Players:FindFirstChild(name)
    if target and target.Character then
        local tH = target.Character:FindFirstChild("HumanoidRootPart")
        if tH then
            local align = tH:FindFirstChild("KickAlign")
            local rot = tH:FindFirstChild("KickRot")
            local att0 = tH:FindFirstChild("KickAtt0")
            if align then
                if align.Attachment1 then align.Attachment1:Destroy() end
                align:Destroy()
            end
            if rot then rot:Destroy() end
            if att0 then att0:Destroy() end
            local th = target.Character:FindFirstChildOfClass("Humanoid")
            if th then th.PlatformStand = false end
            pcall(function()
                DestroyGrabRemote:FireServer(tH)
            end)
        end
    end
    pcall(function()
        local c = getChar()
        if c then c:PivotTo(savedPos) end
    end)
end

--========================================================================--
--  KICK V2 = LOOPGRAB V2 (blink method - slow but rock solid)              --
--========================================================================--
local function runLoopGrabV2(name, isActive, stopAt)
    local etc = {}
    local char = getChar()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hrp) then return end

    local BodyPos = nil
    local oldCF = nil

    local ok, err = pcall(function()
        while isActive() and RunService.RenderStepped:Wait() do
            etc.TargetPLR = Players:FindFirstChild(name)
            if not etc.TargetPLR then continue end

            char = getChar()
            hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hrp) then continue end

            local tChar = etc.TargetPLR.Character
            etc.Head = tChar and tChar:FindFirstChild("Head")
            etc.Root = tChar and tChar:FindFirstChild("HumanoidRootPart")
            etc.Hum = tChar and tChar:FindFirstChild("Humanoid")
            BodyPos = etc.Root and etc.Root:FindFirstChild("BodyPosition")

            if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0)
                and (hrp.Position - etc.Root.Position).Magnitude <= 30 then

                if not BodyPos then
                    BodyPos = Instance.new("BodyPosition")
                    BodyPos.MaxForce = Vector3.new(Huge())
                    BodyPos.Parent = etc.Root
                    BodyPos.P = 75000
                    BodyPos.D = 12000
                    BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)
                end
                BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)

                local isHeld = etc.TargetPLR:FindFirstChild("IsHeld")
                if (etc.Root.Position.Y <= hrp.Position.Y + 15)
                    and isHeld and isHeld.Value then
                    for _, v in pairs(tChar:GetChildren()) do
                        if v:IsA("Part") then
                            v.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)
                        end
                    end
                end

                etc.Root.AssemblyAngularVelocity = Vector3.zero
                etc.Root.AssemblyLinearVelocity = Vector3.zero
                etc.Hum.PlatformStand = true

                sno(etc.Root)
                RunService.RenderStepped:Wait()
                sno(etc.Root)
                pcall(function() DestroyGrabRemote:FireServer(etc.Root) end)
                RunService.RenderStepped:Wait()
                sno(etc.Root)
                RunService.RenderStepped:Wait()
                pcall(function() DestroyGrabRemote:FireServer(etc.Root) end)
            else
                if not etc.Head or not etc.Hum or etc.Hum.Health == 0 then
                    local plr = etc.TargetPLR
                    local respawned = false
                    local conn
                    pcall(function()
                        conn = plr.CharacterAdded:Connect(function() respawned = true end)
                    end)
                    local t0 = os.clock()
                    while isActive() and plr.Parent and not respawned
                        and not (plr.Character and plr.Character:FindFirstChild("Head"))
                        and os.clock() - t0 < 10 do
                        task.wait(0.1)
                    end
                    if conn then pcall(function() conn:Disconnect() end) end

                    etc.Head = FWD(plr.Character, "Head", 5)
                    etc.Hum = FWD(plr.Character, "Humanoid", 5)
                    etc.Root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if etc.Root then
                        BodyPos = Instance.new("BodyPosition")
                        BodyPos.MaxForce = Vector3.new(Huge())
                        BodyPos.Parent = etc.Root
                        BodyPos.P = 75000
                        BodyPos.D = 12000
                        BodyPos.Position = hrp.Position + Vector3.new(0, 15, 0)
                    end
                end

                oldCF = hrp.CFrame
                while (etc.Head and etc.Head.Parent and etc.Hum and etc.Hum.Health ~= 0)
                    and task.wait(0.01) and isActive() do
                    etc.TargetPLR = Players:FindFirstChild(name)
                    if not etc.TargetPLR then break end
                    local inPlot = etc.TargetPLR:FindFirstChild("InPlot")
                    if inPlot and inPlot.Value then continue end

                    local tc = etc.TargetPLR.Character
                    etc.Head = tc and tc:FindFirstChild("Head")
                    etc.Hum = tc and tc:FindFirstChild("Humanoid")
                    if not etc.Head or not etc.Hum then break end

                    char = getChar()
                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not (char and hrp) then break end

                    char:PivotTo(etc.Head.CFrame * CFrame.new(0, 10, 0))
                    sno(etc.Head)

                    if CheckForPartOwner(etc.Head) then break end
                end

                if hrp and hrp.Parent and oldCF then
                    hrp.CFrame = oldCF
                end

                if etc.Head and etc.Head.Parent and CheckForPartOwner(etc.Head)
                    and etc.TargetPLR and etc.TargetPLR.Character
                    and hrp and hrp.Parent then
                    for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)
                        end
                    end
                end
            end

            if stopAt and os.clock() >= stopAt then break end
        end

        if etc.Root then
            for _, v in pairs(etc.Root:GetChildren()) do
                if v.Name == "BodyPosition" then
                    v:Destroy()
                end
            end
        end
    end)

    local target = Players:FindFirstChild(name)
    local tRoot = (target and target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")) or etc.Root
    if tRoot then
        for _, v in pairs(tRoot:GetChildren()) do
            if v.Name == "BodyPosition" then v:Destroy() end
        end
    end
    if not ok then warn("[Ethereal Kick V2] " .. tostring(err)) end
end

--========================================================================--
--  BRING / FLING                                                           --
--========================================================================--
local function runHold(name, mode, isActive, stopAt)
    local etc = {}
    local char = getChar()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hrp) then return end

    while isActive() and RunService.RenderStepped:Wait() do
        etc.TargetPLR = Players:FindFirstChild(name)
        if not etc.TargetPLR then break end

        char = getChar()
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and hrp) then continue end

        local tChar = etc.TargetPLR.Character
        etc.Head = tChar and tChar:FindFirstChild("Head")
        etc.Root = tChar and tChar:FindFirstChild("HumanoidRootPart")
        etc.Hum = tChar and tChar:FindFirstChild("Humanoid")

        if not (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0) then
            continue
        end

        if (hrp.Position - etc.Root.Position).Magnitude <= 30 then
            local BodyPos = etc.Root:FindFirstChild("BodyPosition")
            if not BodyPos then
                BodyPos = Instance.new("BodyPosition")
                BodyPos.MaxForce = Vector3.new(Huge())
                BodyPos.P = 75000
                BodyPos.D = 12000
                BodyPos.Parent = etc.Root
            end
            BodyPos.Position = hrp.Position + Vector3.new(0, Kick.HoldHeight, 0)

            etc.Root.AssemblyAngularVelocity = Vector3.zero
            etc.Root.AssemblyLinearVelocity = Vector3.zero
            etc.Hum.PlatformStand = true

            sno(etc.Root)

            if mode == "fling" then
                pcall(function()
                    etc.Root.AssemblyAngularVelocity = Vector3.new(0, 6e5, 0)
                end)
            end
        else
            local oldCF = hrp.CFrame
            local t0 = os.clock()
            while isActive() and task.wait(0.01) and os.clock() - t0 < 5 do
                local tc = etc.TargetPLR.Character
                etc.Head = tc and tc:FindFirstChild("Head")
                if not etc.Head then break end
                char = getChar()
                hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not (char and hrp) then break end
                char:PivotTo(etc.Head.CFrame * CFrame.new(0, 10, 0))
                sno(etc.Head)
                if CheckForPartOwner(etc.Head) then break end
            end
            if hrp and hrp.Parent then hrp.CFrame = oldCF end

            if etc.TargetPLR and etc.TargetPLR.Character and etc.Head and CheckForPartOwner(etc.Head)
                and hrp and hrp.Parent then
                for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                    if v:IsA("BasePart") then
                        v.CFrame = hrp.CFrame * CFrame.new(0, Kick.HoldHeight, 0)
                    end
                end
            end
        end

        if stopAt and os.clock() >= stopAt then break end
    end

    local target = Players:FindFirstChild(name)
    local tRoot = target and target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")
    if tRoot then
        for _, v in pairs(tRoot:GetChildren()) do
            if v.Name == "BodyPosition" then v:Destroy() end
        end
    end
end

--========================================================================--
--  DISPATCH                                                                --
--========================================================================--
local function kickRun(name, method, isActive, oneShot)
    local target = Players:FindFirstChild(name or "")
    if not target or not target.Parent then
        UI.notify("Target not found: " .. tostring(name))
        return
    end

    local stopAt
    if method == "Bring" or method == "Fling" then
        stopAt = os.clock() + Kick.HoldTime
    elseif oneShot then
        stopAt = os.clock() + 150
    end

    local function active()
        if isActive then return isActive() end
        return Players:FindFirstChild(name) ~= nil
    end

    if method == "Kick" then
        runAccelerating(name, active, stopAt)
    elseif method == "Kick V2" then
        runLoopGrabV2(name, active, stopAt)
    elseif method == "Fling" then
        runHold(name, "fling", active, stopAt)
    else
        runHold(name, "bring", active, stopAt)
    end
end

