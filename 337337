--========================================================================--
--  MISC: BREAK SAFE ZONES (plots)                                          --
--========================================================================--
pcall(function()
    -- v99: Break Plot rebuilt from scratch on the proven sticky physics:
    -- a shuriken is welded to the plot area with a huge CFrame offset, which
    -- breaks the safe zone physics - items you spawn (burgers too) stop
    -- despawning and can be placed / spawned inside the safe zone.
    -- The barrier parts become walk-through. All of it in ONE toggle.

    local StickyEvent = nil
    pcall(function()
        local pe = ReplicatedStorage:FindFirstChild("PlayerEvents")
            or ReplicatedStorage:WaitForChild("PlayerEvents", 5)
        StickyEvent = pe and (pe:FindFirstChild("StickyPartEvent")
            or pe:WaitForChild("StickyPartEvent", 5))
    end)

    local SetOwnerRF = nil
    pcall(function()
        local grab = ReplicatedStorage:FindFirstChild("GrabEvents")
            or ReplicatedStorage:WaitForChild("GrabEvents", 5)
        SetOwnerRF = grab and (grab:FindFirstChild("SetNetworkOwner")
            or grab:WaitForChild("SetNetworkOwner", 5))
    end)

    local SpawnToyRF = nil
    local DestroyToyRF = nil
    pcall(function()
        local mt = ReplicatedStorage:FindFirstChild("MenuToys")
            or ReplicatedStorage:WaitForChild("MenuToys", 5)
        SpawnToyRF = mt and (mt:FindFirstChild("SpawnToyRemoteFunction")
            or mt:WaitForChild("SpawnToyRemoteFunction", 5))
        DestroyToyRF = mt and mt:FindFirstChild("DestroyToy")
    end)

    local CF_BIG = CFrame.new(1099511627776, 1099511627776, 1099511627776,
        1, 0, 0, 0, 1, 0, 0, 0, 1)

    local function bpMyPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, b in ipairs(owners:GetChildren()) do
                    local ok, val = pcall(function() return b.Value end)
                    if ok and val == LocalPlayer.Name then
                        return plot
                    end
                end
            end
        end
        return nil
    end

    local function bpFindToys()
        -- our shurikens in the toys folder or inside our plot folder
        local found = {}
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if inv then
            for _, t in ipairs(inv:GetChildren()) do
                if (t.Name == "Noclipped" or t.Name == "NinjaShuriken")
                    and t:FindFirstChild("StickyPart") then
                    table.insert(found, t)
                end
            end
        end
        local plot = bpMyPlot()
        local pi = workspace:FindFirstChild("PlotItems")
        local house = plot and pi and pi:FindFirstChild(plot.Name)
        if house then
            for _, t in ipairs(house:GetChildren()) do
                if (t.Name == "Noclipped" or t.Name == "NinjaShuriken")
                    and t:FindFirstChild("StickyPart") then
                    table.insert(found, t)
                end
            end
        end
        return found
    end

    local function bpNoclip(shur)
        pcall(function()
            for _, obj in ipairs(shur:GetChildren()) do
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                    obj.CanCollide = false
                    obj.CanQuery = false
                    if obj.Transparency == 0 then obj.Transparency = 1 end
                end
            end
            shur.Name = "Noclipped"
        end)
    end

    local function bpOwn(shur)
        -- network ownership of the sound part is required for the physics
        if not SetOwnerRF then return end
        local soundPart = shur:FindFirstChild("SoundPart")
        if not soundPart then return end
        for _ = 1, 20 do
            pcall(function() SetOwnerRF:FireServer(soundPart, soundPart.CFrame) end)
            local owned = soundPart:FindFirstChild("PartOwner")
            if owned and owned.Value == LocalPlayer.Name then break end
            task.wait(0.05)
        end
    end

    local function bpWeldedTo(shur, area)
        local sp = shur and shur:FindFirstChild("StickyPart")
        local weld = sp and sp:FindFirstChild("StickyWeld")
        return weld and weld.Part1 == area
    end

    local function bpWeld(shur, area)
        local sp = shur and shur:FindFirstChild("StickyPart")
        if not (sp and StickyEvent and area) then return end
        pcall(function()
            StickyEvent:FireServer(sp, area, CF_BIG)
        end)
    end

    local function bpBarriers(on)
        -- false -> walk through every plot barrier, true -> restore
        local n = 0
        pcall(function()
            local plots = workspace:FindFirstChild("Plots")
            for _, plot in ipairs(plots:GetChildren()) do
                local barrier = plot:FindFirstChild("Barrier")
                if barrier then
                    for _, part in ipairs(barrier:GetChildren()) do
                        if part:IsA("BasePart") and part.CanCollide ~= on then
                            part.CanCollide = on
                            n = n + 1
                        end
                    end
                end
            end
        end)
        return n
    end

    local gPlot = TabMisc:AddLeftGroupbox("Break Plot", "hammer")

    local StatusLabel = gPlot:AddLabel("<font color=\"#888888\">Status: idle</font>")

    local function bpStatus(text, color)
        pcall(function()
            StatusLabel:SetText("<font color=\"" .. (color or "#888888")
                .. "\">Status: " .. text .. "</font>")
        end)
    end

    gPlot:AddToggle("BreakSafeZones", {
        Text = "Break Plot",
        Default = false,
        Tooltip = "ONE button: breaks safe zone physics + barriers - items stop despawning, spawn anything inside your safe zone",
        Callback = function(v)
            UI.state.BreakPlotOn = v
            if v then
                UI.notify("Break Plot: ON")
                bpStatus("working...", "#f5c542")
            else
                UI.notify("Break Plot: OFF")
                bpStatus("idle", nil)
                -- restore barriers and remove our shuriken
                bpBarriers(true)
                pcall(function()
                    if not DestroyToyRF then return end
                    local inv = workspace:FindFirstChild(
                        LocalPlayer.Name .. "SpawnedInToys")
                    if inv then
                        for _, t in ipairs(inv:GetChildren()) do
                            if t.Name == "Noclipped" then
                                pcall(function() DestroyToyRF:FireServer(t) end)
                            end
                        end
                    end
                end)
            end
        end,
    })

    -- v99 worker: one loop does everything (plot physics + barrier + repair)
    task.spawn(function()
        while UI.Alive do
            if UI.state.BreakPlotOn then
                pcall(function()
                    local plot = bpMyPlot()
                    local area = plot and plot:FindFirstChild("PlotArea")
                    if not (plot and area and area:IsA("BasePart")) then
                        bpStatus("no plot found - claim one first", "#ff5555")
                        return
                    end
                    -- 1) barriers: walk-through everywhere
                    local n = bpBarriers(false)
                    -- 2) find our shuriken (welded to this plot first)
                    local shur = nil
                    local myToys = bpFindToys()
                    for _, t in ipairs(myToys) do
                        if bpWeldedTo(t, area) then
                            shur = t
                            break
                        end
                    end
                    if not shur then
                        for _, t in ipairs(myToys) do
                            local sp = t:FindFirstChild("StickyPart")
                            local weld = sp and sp:FindFirstChild("StickyWeld")
                            if not (weld and weld.Part1) then
                                shur = t
                                break
                            end
                        end
                    end
                    -- 3) no free shuriken -> spawn one (toy cooldown aware)
                    if not shur and SpawnToyRF then
                        local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
                        local t0 = tick()
                        while canSpawn and not canSpawn.Value
                            and UI.state.BreakPlotOn and tick() - t0 < 6 do
                            task.wait(0.1)
                        end
                        if UI.state.BreakPlotOn then
                            local hrp = getChar()
                                and getChar():FindFirstChild("HumanoidRootPart")
                            local cf = hrp and (hrp.CFrame * CFrame.new(5, 8, 20))
                                or CFrame.new(0, 60, 0)
                            pcall(function()
                                SpawnToyRF:InvokeServer("NinjaShuriken", cf, Vector3.zero)
                            end)
                            local t1 = tick()
                            while tick() - t1 < 4 and not shur and UI.state.BreakPlotOn do
                                local list = bpFindToys()
                                for _, t in ipairs(list) do
                                    if t.Name == "NinjaShuriken"
                                        and t:FindFirstChild("StickyPart") then
                                        shur = t
                                        break
                                    end
                                end
                                if not shur then task.wait(0.1) end
                            end
                        end
                    end
                    -- 4) own it, hide it, weld it to the plot area
                    if shur then
                        bpOwn(shur)
                        bpNoclip(shur)
                        if not bpWeldedTo(shur, area) then
                            bpWeld(shur, area)
                        end
                        if bpWeldedTo(shur, area) then
                            bpStatus("plot broken / barriers: " .. n, "#4dff88")
                        else
                            bpStatus("welding... step out and back in", "#f5c542")
                        end
                    else
                        bpStatus("waiting for toy cooldown...", "#f5c542")
                    end
                end)
            end
            task.wait(2)
        end
    end)

    local gMiscInfo = TabMisc:AddRightGroupbox("Info")
    gMiscInfo:AddLabel("Break Plot - one button does it all")
    gMiscInfo:AddLabel("A sticky shuriken breaks the safe zone")
    gMiscInfo:AddLabel("physics, so spawned items stop despawning")
    gMiscInfo:AddLabel("and you can spawn items inside it")
    gMiscInfo:AddLabel("All plot barriers become walk-through")
end)

