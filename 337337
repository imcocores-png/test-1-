    -- v98: Anti Explosion - anchors you for a moment when an explosion part
    -- spawns near you, so the blast ragdoll can not grab and yeet you
    UI.state.AntiExplode = false
    local antiExplodeConn = nil

    local function antiExplodeOn(model)
        if not UI.state.AntiExplode then return end
        if not (model and model:IsA("BasePart") and model.Name == "Part") then
            return
        end
        task.spawn(function()
            pcall(function()
                local c = getChar()
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if not (c and hrp) then return end
                if (model.Position - hrp.Position).Magnitude > 20 then return end
                if hrp.Anchored then return end
                hrp.Anchored = true
                local t0 = tick()
                while tick() - t0 < 2 and c.Parent do
                    local arm = c:FindFirstChild("Right Arm")
                    local limb = arm and arm:FindFirstChild("RagdollLimbPart")
                    if not limb or not limb.CanCollide then break end
                    task.wait(0.02)
                end
                local cc = getChar()
                local hh = cc and cc:FindFirstChild("HumanoidRootPart")
                if hh then hh.Anchored = false end
            end)
        end)
    end

    local function antiExplodeOff()
        if antiExplodeConn then
            pcall(function() antiExplodeConn:Disconnect() end)
            antiExplodeConn = nil
        end
        pcall(function()
            local cc = getChar()
            local hh = cc and cc:FindFirstChild("HumanoidRootPart")
            if hh then hh.Anchored = false end
        end)
    end

