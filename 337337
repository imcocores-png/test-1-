-- minimal drawn logo: black disc + yellow ring + silver E + light slash
local function makeLogoCircle(parent, size)
    local box = Instance.new("Frame")
    box.Name = "EtherialLogo"
    box.BackgroundTransparency = 1
    box.Size = UDim2.fromOffset(size, size)

    local disc = Instance.new("Frame")
    disc.Name = "Disc"
    disc.Size = UDim2.fromScale(1, 1)
    disc.BackgroundColor3 = Color3.fromRGB(5, 5, 6)
    disc.BorderSizePixel = 0
    disc.Parent = box
    local crn = Instance.new("UICorner")
    crn.CornerRadius = UDim.new(1, 0)
    crn.Parent = disc
    local ring = Instance.new("UIStroke")
    ring.Color = LOGO_YELLOW
    ring.Thickness = math.max(1.5, size / 26)
    ring.Parent = disc

    local letter = Instance.new("TextLabel")
    letter.Name = "Letter"
    letter.BackgroundTransparency = 1
    letter.Size = UDim2.fromScale(1, 1)
    letter.Font = Enum.Font.GothamBlack
    letter.Text = "E"
    letter.TextScaled = true
    letter.TextColor3 = Color3.fromRGB(244, 244, 246)
    letter.Parent = box
    local lpad = Instance.new("UIPadding")
    lpad.PaddingTop = UDim.new(0, math.floor(size * 0.13))
    lpad.PaddingBottom = UDim.new(0, math.floor(size * 0.13))
    lpad.PaddingLeft = UDim.new(0, math.floor(size * 0.08))
    lpad.PaddingRight = UDim.new(0, math.floor(size * 0.08))
    lpad.Parent = letter
    local grad = Instance.new("UIGradient")
    grad.Rotation = 90
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(248, 248, 250)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(112, 112, 120)),
    })
    grad.Parent = letter

    local slash = Instance.new("Frame")
    slash.Name = "Slash"
    slash.AnchorPoint = Vector2.new(0.5, 0.5)
    slash.Position = UDim2.fromScale(0.5, 0.5)
    slash.Size = UDim2.new(0, math.max(1, math.floor(size / 26)), 0, math.floor(size * 0.92))
    slash.Rotation = 24
    slash.BackgroundColor3 = Color3.fromRGB(215, 215, 222)
    slash.BackgroundTransparency = 0.2
    slash.BorderSizePixel = 0
    slash.Parent = box

    box.Parent = parent
    return box
end

