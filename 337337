--========================================================================--
--  VISUALS: FORCE THIRD PERSON                                             --
--========================================================================--
do
    local TP_BIND = "EtherealThirdPerson"

    local function tpApply()
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.Custom
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = math.max(State.CamDist or 25, 128)
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType ~= Enum.CameraType.Custom then
                cam.CameraType = Enum.CameraType.Custom
            end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if cam and hum and cam.CameraSubject ~= hum then
                cam.CameraSubject = hum
            end
        end)
    end

    -- v97 FIX: switching CameraMode alone was not enough - the zoom stayed at
    -- 0.5 so the view remained first person. Now the camera is physically
    -- pushed behind the character every frame (after the camera update) and
    -- the character is made visible again.
    local function tpEnforce()
        if not State.ThirdPerson then return end
        pcall(function()
            if LocalPlayer.CameraMode ~= Enum.CameraMode.Custom then
                LocalPlayer.CameraMode = Enum.CameraMode.Custom
            end
            -- v99: keep the zoom window open, some games clamp max zoom
            -- to 0.5 which silently locks you back in first person
            pcall(function()
                if LocalPlayer.CameraMinZoomDistance > 0.5 then
                    LocalPlayer.CameraMinZoomDistance = 0.5
                end
                local wantMax = math.max(State.CamDist or 25, 128)
                if LocalPlayer.CameraMaxZoomDistance < wantMax then
                    LocalPlayer.CameraMaxZoomDistance = wantMax
                end
            end)
            local cam = workspace.CurrentCamera
            if not cam then return end
            if cam.CameraType ~= Enum.CameraType.Custom then
                cam.CameraType = Enum.CameraType.Custom
            end
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and cam.CameraSubject ~= hum then
                cam.CameraSubject = hum
            end
            -- the character must be visible in third person
            pcall(function()
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Decal") then
                        if obj.LocalTransparencyModifier ~= 0 then
                            obj.LocalTransparencyModifier = 0
                        end
                    end
                end
            end)
            -- push the camera out to the chosen distance
            pcall(function()
                local head = char:FindFirstChild("Head")
                    or char:FindFirstChild("HumanoidRootPart")
                if head then
                    local dist = tonumber(State.CamDist) or 25
                    local cur = (cam.CFrame.Position - head.Position).Magnitude
                    if cur < dist - 0.25 then
                        local rot = cam.CFrame - cam.CFrame.Position
                        cam.CFrame = CFrame.new(
                            head.Position - cam.CFrame.LookVector * dist) * rot
                    end
                end
            end)
        end)
    end

    local function startTP()
        if not State.SavedCam then
            State.SavedCam = {
                Mode = LocalPlayer.CameraMode,
                Min  = LocalPlayer.CameraMinZoomDistance,
                Max  = LocalPlayer.CameraMaxZoomDistance,
            }
        end
        pcall(function() RunService:UnbindFromRenderStep(TP_BIND) end)
        pcall(function()
            -- v99: Last + 100 -> runs after every game camera bind,
            -- so nothing can overwrite our camera any more
            RunService:BindToRenderStep(TP_BIND,
                Enum.RenderPriority.Last.Value + 100, tpEnforce)
        end)
        if not UI.state.tpHeart then
            UI.state.tpHeart = RunService.Heartbeat:Connect(tpEnforce)
        end
        if not UI.state.tpConn then
            UI.state.tpConn = LocalPlayer:GetPropertyChangedSignal("CameraMode"):Connect(function()
                if State.ThirdPerson and LocalPlayer.CameraMode ~= Enum.CameraMode.Custom then
                    tpApply()
                end
            end)
        end
        tpApply()
        tpEnforce()
    end

    local function stopTP()
        pcall(function() RunService:UnbindFromRenderStep(TP_BIND) end)
        if UI.state.tpHeart then
            pcall(function() UI.state.tpHeart:Disconnect() end)
            UI.state.tpHeart = nil
        end
        if UI.state.tpConn then
            pcall(function() UI.state.tpConn:Disconnect() end)
            UI.state.tpConn = nil
        end
        local s = State.SavedCam
        if s then
            pcall(function()
                LocalPlayer.CameraMode = s.Mode
                LocalPlayer.CameraMinZoomDistance = s.Min
                LocalPlayer.CameraMaxZoomDistance = s.Max
            end)
            State.SavedCam = nil
        end
    end

    pcall(function()
        local gCam = TabVisuals:AddLeftGroupbox("Camera")

        gCam:AddToggle("ThirdPerson", {
            Text = "Force Third Person",
            Default = false,
            Tooltip = "Zoom - pinch (mobile) or scroll (PC)",
            Callback = function(v)
                State.ThirdPerson = v
                if v then startTP() else stopTP() end
            end,
        })

        local sCam = gCam:AddSlider("CamDist", {
            Text = "Distance",
            Suffix = " studs",
            Default = 25, Min = 2, Max = 128, Rounding = 0,
            Callback = function(v)
                State.CamDist = v
                if State.ThirdPerson then tpApply() end
            end,
        })
        styleSlider(sCam)

        -- v97: Anti Lag - kills shadows and heavy effects so the game stops lagging
        State.AntiLag = false
        local AL = { state = {}, conns = {}, saved = nil, active = false }

        local function alIsHeavy(obj)
            return obj:IsA("PostEffect")
                or obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
        end

        local function alTrack(obj)
            if AL.state[obj] == nil then
                local ok, was = pcall(function() return obj.Enabled end)
                if ok and type(was) == "boolean" then
                    AL.state[obj] = was
                    pcall(function() obj.Enabled = false end)
                end
            end
        end

        local function alScan(root)
            if not root then return end
            pcall(function()
                for _, obj in ipairs(root:GetDescendants()) do
                    if alIsHeavy(obj) then alTrack(obj) end
                end
            end)
        end

        local function alStart()
            if AL.active then return end
            AL.active = true
            local lighting = game:GetService("Lighting")
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            AL.saved = {
                shadows = lighting.GlobalShadows,
                soft    = lighting.ShadowSoftness,
            }
            if terrain then
                AL.saved.terrain = {
                    Decoration       = terrain.Decoration,
                    WaterReflectance = terrain.WaterReflectance,
                    WaterWaveSize    = terrain.WaterWaveSize,
                    WaterWaveSpeed   = terrain.WaterWaveSpeed,
                }
            end
            pcall(function()
                AL.saved.quality = settings().Rendering.QualityLevel
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)
            lighting.GlobalShadows = false
            lighting.ShadowSoftness = 0
            if terrain then
                pcall(function()
                    terrain.Decoration = false
                    terrain.WaterReflectance = 0
                    terrain.WaterWaveSize = 0
                    terrain.WaterWaveSpeed = 0
                end)
            end
            alScan(lighting)
            alScan(workspace)
            AL.conns[1] = lighting.DescendantAdded:Connect(alTrack)
            AL.conns[2] = workspace.DescendantAdded:Connect(alTrack)
        end

        local function alStop()
            AL.active = false
            for _, c in pairs(AL.conns) do pcall(function() c:Disconnect() end) end
            AL.conns = {}
            for obj, was in pairs(AL.state) do
                pcall(function() obj.Enabled = was end)
            end
            AL.state = {}
            if AL.saved then
                pcall(function()
                    local lighting = game:GetService("Lighting")
                    lighting.GlobalShadows = AL.saved.shadows
                    lighting.ShadowSoftness = AL.saved.soft
                    local terrain = workspace:FindFirstChildOfClass("Terrain")
                    if terrain and AL.saved.terrain then
                        terrain.Decoration = AL.saved.terrain.Decoration
                        terrain.WaterReflectance = AL.saved.terrain.WaterReflectance
                        terrain.WaterWaveSize = AL.saved.terrain.WaterWaveSize
                        terrain.WaterWaveSpeed = AL.saved.terrain.WaterWaveSpeed
                    end
                end)
                if AL.saved.quality ~= nil then
                    pcall(function()
                        settings().Rendering.QualityLevel = AL.saved.quality
                    end)
                end
                AL.saved = nil
            end
        end

        gCam:AddToggle("AntiLag", {
            Text = "Anti Lag",
            Default = false,
            Tooltip = "Shadows and heavy effects off - less lag",
            Callback = function(v)
                State.AntiLag = v
                if v then pcall(alStart) else pcall(alStop) end
            end,
        })
        UI.state.AntiLagStop = alStop

        -- v96: Screen Stretch
        State.ScreenStretchInt = 0
        local function stopStretch()
            if UI.state.StretchConn then
                pcall(function() UI.state.StretchConn:Disconnect() end)
                UI.state.StretchConn = nil
            end
        end
        gCam:AddToggle("ScreenStretch", {
            Text = "Screen Stretch",
            Default = false,
            Callback = function(v)
                stopStretch()
                if v then
                    UI.state.StretchConn = RunService.RenderStepped:Connect(function()
                        local cam = workspace.CurrentCamera
                        if cam then
                            cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0,
                                1, 0, 0,
                                0, 0.65 + State.ScreenStretchInt, 0,
                                0, 0, 1)
                        end
                    end)
                end
            end,
        })
        local sStretch = gCam:AddSlider("StretchInt", {
            Text = "Stretch Intensity",
            Default = 0, Min = 0, Max = 20, Rounding = 1,
            Callback = function(v)
                State.ScreenStretchInt = v / 100
            end,
        })
        styleSlider(sStretch)
    end)

    UI.state.TPUnload = stopTP
end


