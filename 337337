-- v95: patch the library source between download and loadstring:
--   1) slider track -> fully rounded pill
--   2) slider fill  -> fully rounded pill
--   3) slider fill movement -> smooth tween animation
--   4) expose window title bar internals (Etherial logo in the top bar)
local function spliceOnce(hay, old, new)
    if type(hay) ~= "string" then return hay, false end
    local i, j = hay:find(old, 1, true)
    if not i then return hay, false end
    return hay:sub(1, i - 1) .. new .. hay:sub(j + 1), true
end

local function patchObsidianSource(txt)
    if type(txt) ~= "string" then return txt end
    -- (1) slider track: fully rounded pill
    txt = spliceOnce(txt,
        "CornerRadius = UDim.new(0, Library.CornerRadius / 2),\n                Parent = Bar,",
        "CornerRadius = UDim.new(1, 0),\n                Parent = Bar,")
    -- (2) slider fill: fully rounded pill
    txt = spliceOnce(txt,
        "CornerRadius = UDim.new(0, Library.CornerRadius / 2),\n                Parent = Fill,",
        "CornerRadius = UDim.new(1, 0),\n                Parent = Fill,")
    -- (3) slider fill: smooth animated movement
    txt = spliceOnce(txt,
        "local X = (Slider.Value - Slider.Min) / (Slider.Max - Slider.Min)\n            Fill.Size = UDim2.fromScale(X, 1)",
        "local X = (Slider.Value - Slider.Min) / (Slider.Max - Slider.Min)\n"
            .. "            do\n"
            .. "                local sTween = game:GetService(\"TweenService\"):Create(\n"
            .. "                    Fill,\n"
            .. "                    TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),\n"
            .. "                    { Size = UDim2.fromScale(X, 1) }\n"
            .. "                )\n"
            .. "                sTween:Play()\n"
            .. "            end")
    -- (4) v95: expose title bar internals so the script can add the logo
    txt = spliceOnce(txt,
        "    function Window:ChangeTitle(title)",
        "    Window.GetTitleRefs = function()\n"
            .. "        return TitleHolder, WindowTitle, WindowIcon\n"
            .. "    end\n\n"
            .. "    function Window:ChangeTitle(title)")
    -- (5) v99: thicker outlines everywhere (user request)
    txt = spliceOnce(txt,
        "Color = \"OutlineColor\",\n        Thickness = 1,",
        "Color = \"OutlineColor\",\n        Thickness = 1.5,")
    txt = spliceOnce(txt,
        "Color = \"DarkColor\",\n        Thickness = 1.5,",
        "Color = \"DarkColor\",\n        Thickness = 2,")
    return txt
end

