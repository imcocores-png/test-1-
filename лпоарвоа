local function StyleMenuUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    local menuGui = playerGui:FindFirstChild("MenuGui")
    if not menuGui then return end
    local menu = menuGui:FindFirstChild("Menu")

    local black = Color3.fromRGB(0, 0, 0)
    local blue = Color3.fromRGB(30, 100, 200)
    local white = Color3.fromRGB(255, 255, 255)
    local cornerRadius = UDim.new(0, 0)

    local function roundCorners(obj)
        local corner = obj:FindFirstChildOfClass("UICorner")
        if corner then corner.CornerRadius = cornerRadius
        else corner = Instance.new("UICorner"); corner.CornerRadius = cornerRadius; corner.Parent = obj end
    end

    local function addGradient(obj, rotation)
        local gradient = obj:FindFirstChildOfClass("UIGradient")
        if not gradient then gradient = Instance.new("UIGradient") end
        gradient.Color = ColorSequence.new{ ColorSequenceKeypoint.new(0, white), ColorSequenceKeypoint.new(1, blue) }
        gradient.Rotation = rotation or 45
        gradient.Parent = obj
    end

    local topRight = menuGui:FindFirstChild("TopRight", true)
    local coinsFrame = topRight and topRight:FindFirstChild("CoinsFrame")
    if coinsFrame then
        local coinsDisplay = coinsFrame:FindFirstChild("CoinsDisplay")
        if coinsDisplay then
            local coinImage = coinsDisplay:FindFirstChild("CoinImage")
            local coinsText = coinsDisplay:FindFirstChild("Coins")
            if coinImage then coinImage.Image = "rbxassetid://17629725719" end
            if coinsText then coinsText.TextColor3 = Color3.new(1, 1, 1) end
        end
        coinsFrame.BackgroundTransparency = 0.35
    end

    if not menu then return end

    local tabBar = menu:FindFirstChild("TabBar")
    if tabBar then tabBar.BackgroundColor3 = black; tabBar.BackgroundTransparency = 0.28; roundCorners(tabBar) end

    local tabContents = menu:FindFirstChild("TabContents")
    if tabContents then
        for _, frame in ipairs(tabContents:GetChildren()) do
            if frame:IsA("Frame") then
                frame.BackgroundColor3 = black; frame.BackgroundTransparency = 0.7; roundCorners(frame)
                local title = frame:FindFirstChild("Title")
                if title then title.BackgroundColor3 = black; title.BackgroundTransparency = 0.4; roundCorners(title) end
                local sortingTabs = frame:FindFirstChild("SortingTabs")
                if sortingTabs then sortingTabs.BackgroundColor3 = black; sortingTabs.BackgroundTransparency = 0.55; roundCorners(sortingTabs) end
                local contents = frame:FindFirstChild("Contents")
                if contents then contents.BackgroundColor3 = white; contents.BackgroundTransparency = 0.55; roundCorners(contents); addGradient(contents, 45) end
                local favoritesFrame = frame:FindFirstChild("FavoritesFrame")
                if favoritesFrame then favoritesFrame.BackgroundTransparency = 1; roundCorners(favoritesFrame) end
            end
        end
    end

    for _, desc in ipairs(menuGui:GetDescendants()) do
        if desc.Name == "MeterFrame" and desc:IsA("GuiObject") then
            desc.BackgroundColor3 = black; desc.BackgroundTransparency = 0.4; roundCorners(desc)
        end
    end
end

