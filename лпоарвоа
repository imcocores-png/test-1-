-- ============ GUCCI (BLOBMAN) ============
do
    local gucciCon = nil
    local function spawnBlobman()
        pcall(function() ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", CFrame.new(0, 5000000, 0), Vector3.new(0, 60, 0)) end)
        local folder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys", 5)
        if folder and folder:FindFirstChild("CreatureBlobman") then
            local blob = folder.CreatureBlobman
            if blob:FindFirstChild("Head") then blob.Head.CFrame = CFrame.new(0, 50000, 0); blob.Head.Anchored = true end
            Library:Notify({Title = "Gucci", Content = "Blobman spawned!", Duration = 3})
        end
    end

    local function startAntiGucci()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")
        local safePosition = rootPart.Position
        local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        local blob = folder and folder:FindFirstChild("CreatureBlobman")
        local seat = blob and blob:FindFirstChild("VehicleSeat")

        if not blob then
            spawnBlobman()
            task.wait(0.3)
            folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            blob = folder and folder:FindFirstChild("CreatureBlobman")
            seat = blob and blob:FindFirstChild("VehicleSeat")
        end

        if seat and seat:IsA("VehicleSeat") then rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0); seat:Sit(humanoid) end

        local restoreFrames = 0
        humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if not humanoid.Sit and restoreFrames == 0 then
                restoreFrames = 15
                safePosition = rootPart.Position
            end
        end)

        if gucciCon then gucciCon:Disconnect() end
        gucciCon = RunService.Heartbeat:Connect(function()
            if not rootPart or not humanoid then return end
            pcall(function() if Def_CE then Def_CE.RagdollRemote:FireServer(rootPart, 0) end end)
            if restoreFrames > 0 then rootPart.CFrame = CFrame.new(safePosition); restoreFrames = restoreFrames - 1 end
        end)

        task.spawn(function()
            while humanoid.Sit do task.wait(1) end
            task.wait(0.5)
            rootPart.CFrame = CFrame.new(safePosition)
        end)
    end

    local function stopAntiGucci()
        if gucciCon then gucciCon:Disconnect(); gucciCon = nil end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then hum.Sit = false; pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        local blobFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if blobFolder and blobFolder:FindFirstChild("CreatureBlobman") then
            local blob = blobFolder.CreatureBlobman
            pcall(function() ReplicatedStorage.MenuToys.DestroyToy:FireServer(blob) end)
            task.wait(0.1)
            if blob and blob.Parent then blob:Destroy() end
        end
    end

    DefGroup3:AddCheckbox("Gucci", {
        Text = "Anti Gucci [BLOBMAN]", Default = false,
        Callback = function(Value)
            if Value then task.spawn(startAntiGucci) else task.spawn(stopAntiGucci) end
        end
    })
end

