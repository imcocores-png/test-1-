                if player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    local truePosPart = player.Character:FindFirstChild("TruePositionPart")
                    if hrp and truePosPart then
                        local rootAttachment = hrp:FindFirstChild("RootAttachment")
                        if rootAttachment and rootAttachment.Parent == hrp then rootAttachment.Parent = truePosPart end
                        
                        local isGrabbed = false
                        for _, part in pairs(player.Character:GetChildren()) do
                            if part:IsA("Part") and part.Massless then part.Massless = false; isGrabbed = true end
                        end

                        if isGrabbed then
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 15000000, 0)
                            local function fireDrop(item)
                                local blobScript = item:FindFirstChild("BlobmanSeatAndOwnerScript")
                                if blobScript then
                                    local dropEvent = blobScript:FindFirstChild("CreatureDrop")
                                    local rightWeld = item:FindFirstChild("RightDetector") and item.RightDetector:FindFirstChild("RightWeld")
                                    local leftWeld = item:FindFirstChild("LeftDetector") and item.LeftDetector:FindFirstChild("LeftWeld")
