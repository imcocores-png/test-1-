-- ====================== YELLOW THEME (с крыльями) ======================
do
    local YELLOW = Color3.fromRGB(255, 225, 0)

    local function isPurple(c) return c.B > 0.45 and c.R > 0.30 and c.G < c.R * 0.85 and c.G < c.B * 0.95 end
    local function isWhite(c) return c.R > 0.82 and c.G > 0.82 and c.B > 0.82 end
    local function fix(c) if isPurple(c) then return YELLOW end; if isWhite(c) then return YELLOW end; return c end

    local function repaint(v)
        if v:IsA("UIGradient") then
            local kp = table.create(#v.Color.Keypoints)
            for i, p in ipairs(v.Color.Keypoints) do kp[i] = ColorSequenceKeypoint.new(p.Time, fix(p.Value)) end
            v.Color = ColorSequence.new(kp)
        elseif v:IsA("UIStroke") then
            v.Color = fix(v.Color)
        elseif v:IsA("GuiObject") then
            v.BackgroundColor3 = fix(v.BackgroundColor3)
            if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then v.TextColor3 = fix(v.TextColor3) end
            if v:IsA("ImageLabel") or v:IsA("ImageButton") then v.ImageColor3 = fix(v.ImageColor3) end
            if v:IsA("ScrollingFrame") then v.ScrollBarImageColor3 = fix(v.ScrollBarImageColor3) end
        end
    end

    local holder = (gethui and gethui()) or game:GetService("CoreGui")

    local function process(gui)
        for _, v in ipairs(gui:GetDescendants()) do pcall(repaint, v) end
        gui.DescendantAdded:Connect(function(v) task.defer(pcall, repaint, v) end)
    end

    for _, gui in ipairs(holder:GetChildren()) do if gui:IsA("ScreenGui") then process(gui) end end
    holder.ChildAdded:Connect(function(c) if c:IsA("ScreenGui") then task.defer(process, c) end end)

    task.spawn(function()
        while true do
            task.wait(1.5)
            for _, gui in ipairs(holder:GetChildren()) do
                if gui:IsA("ScreenGui") then for _, v in ipairs(gui:GetDescendants()) do pcall(repaint, v) end end
            end
        end
    end)
end

