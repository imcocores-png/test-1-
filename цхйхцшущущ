    progressCorner.CornerRadius = UDim.new(0, 1)
    progressCorner.Parent = progressBar

    -- Slide in animation
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0
    }):Play()

    -- Stroke fade in
    TweenService:Create(notifStroke, TweenInfo.new(0.3), {
        Transparency = 0.5
    }):Play()

    -- Icon bar expand
    TweenService:Create(iconFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 4, 0.7, 0)
    }):Play()

    -- Glow pulse
    task.spawn(function()
        while notif.Parent do
            TweenService:Create(glowFrame, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.5
            }):Play()
            task.wait(1)
            TweenService:Create(glowFrame, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.9
            }):Play()
            task.wait(1)
        end
    end)

    -- Text fade in
    task.delay(0.15, function()
        TweenService:Create(titleLbl, TweenFast, {
            TextTransparency = 0
        }):Play()
    end)
    task.delay(0.25, function()
        TweenService:Create(contentLbl, TweenFast, {
            TextTransparency = 0
        }):Play()
    end)

    -- Progress bar animation
    local duration = options.Duration or 3
    TweenService:Create(progressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    -- Close animation
    task.spawn(function()
        task.wait(duration)
        TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        TweenService:Create(notifStroke, TweenFast, {
            Transparency = 1
        }):Play()
        TweenService:Create(titleLbl, TweenFast, {
            TextTransparency = 1
        }):Play()
        TweenService:Create(contentLbl, TweenFast, {
            TextTransparency = 1
        }):Play()
        task.delay(0.35, function()
            notif:Destroy()
        end)
    end)
end

-- ====================== TAB SYSTEM ======================
local Tabs = {}
local CurrentTab = nil

local function CreateTab(name, order)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = name
    tabBtn.Size = UDim2.new(1, 0, 0, 30)
    tabBtn.BackgroundColor3 = Colors.TabIdle
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = Colors.TextDim
    tabBtn.Font = Enum.Font.Gotham
    tabBtn.TextSize = 12
    tabBtn.LayoutOrder = order
    tabBtn.TextTransparency = 0.3
    tabBtn.Parent = TabContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = tabBtn

    -- Animated indicator
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 0, 0, 2)
    indicator.Position = UDim2.new(0, 0, 1, -2)
    indicator.BackgroundColor3 = Colors.Accent
    indicator.BorderSizePixel = 0
    indicator.Parent = tabBtn

    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 1)
    indCorner.Parent = indicator

    local pageFrame = Instance.new("Frame")
    pageFrame.Name = name .. "Page"
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.Visible = false
    pageFrame.Parent = PagesFrame

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.FillDirection = Enum.FillDirection.Horizontal
    pageLayout.Parent = pageFrame

    local tabData = {
        Button = tabBtn,
        Page = pageFrame,
        Name = name,
        Indicator = indicator
    }

    tabBtn.MouseButton1Click:Connect(function()
        playSound(UI_CLICK, 0.2)
        if CurrentTab then
            -- Animate out old tab
            TweenService:Create(CurrentTab.Button, TweenFast, {
                BackgroundColor3 = Colors.TabIdle,
                TextColor3 = Colors.TextDim,
                TextTransparency = 0.3
            }):Play()
            TweenService:Create(CurrentTab.Indicator, TweenFast, {
                Size = UDim2.new(0, 0, 0, 2)
            }):Play()
            
            -- Page slide out
            for _, child in pairs(CurrentTab.Page:GetChildren()) do
                if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                    TweenService:Create(child, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        BackgroundTransparency = 1
                    }):Play()
                end
            end
            task.delay(0.1, function()
                CurrentTab.Page.Visible = false
            end)
        end
        
        -- Animate in new tab
        TweenService:Create(tabBtn, TweenFast, {
            BackgroundColor3 = Colors.TabActive,
            TextColor3 = Colors.Accent,
            TextTransparency = 0
        }):Play()
        TweenService:Create(indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, 2)
        }):Play()
        
        pageFrame.Visible = true
        
        -- Page slide in with stagger
        for i, child in pairs(pageFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                child.BackgroundTransparency = 1
                task.delay(i * 0.05, function()
                    TweenService:Create(child, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0
                    }):Play()
                end)
            end
        end
        
        CurrentTab = tabData
    end)

    tabBtn.MouseEnter:Connect(function()
        if CurrentTab ~= tabData then
            playSound(UI_HOVER, 0.05)
            TweenService:Create(tabBtn, TweenFast, {
                BackgroundColor3 = Colors.TabHover,
                TextTransparency = 0
            }):Play()
            -- Slight scale effect via position
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 4, 0, 30)
            }):Play()
        end
    end)

    tabBtn.MouseLeave:Connect(function()
        if CurrentTab ~= tabData then
            TweenService:Create(tabBtn, TweenFast, {
                BackgroundColor3 = Colors.TabIdle,
                TextTransparency = 0.3
            }):Play()
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 30)
            }):Play()
        end
    end)

    Tabs[name] = tabData
    return tabData
end

