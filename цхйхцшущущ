            valLabel.Text = tostring(options.Default or 0)
            valLabel.TextColor3 = Colors.Accent
            valLabel.Font = Enum.Font.GothamBold
            valLabel.TextSize = 11
            valLabel.Parent = sl

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 10)
            track.Position = UDim2.new(0, 0, 0, 22)
            track.BackgroundColor3 = Colors.SliderBg
            track.BorderSizePixel = 0
            track.Parent = sl

            local trackCorner = Instance.new("UICorner")
            trackCorner.CornerRadius = UDim.new(0, 5)
            trackCorner.Parent = track

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Colors.SliderFill
            fill.BorderSizePixel = 0
            fill.Parent = track

            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(0, 5)
            fillCorner.Parent = fill

            -- Glow behind fill
            local fillGlow = Instance.new("Frame")
            fillGlow.Size = UDim2.new(0, 0, 1, 4)
            fillGlow.Position = UDim2.new(0, 0, 0, -2)
            fillGlow.BackgroundColor3 = Colors.SliderFill
            fillGlow.BackgroundTransparency = 0.7
            fillGlow.BorderSizePixel = 0
            fillGlow.ZIndex = -1
            fillGlow.Parent = track

            local glowCorner = Instance.new("UICorner")
            glowCorner.CornerRadius = UDim.new(0, 5)
            glowCorner.Parent = fillGlow

            local circle = Instance.new("Frame")
            circle.Size = UDim2.new(0, 16, 0, 16)
            circle.Position = UDim2.new(0, -8, 0.5, -8)
            circle.BackgroundColor3 = Colors.Accent
            circle.BorderSizePixel = 0
            circle.Parent = fill

            local circleCorner = Instance.new("UICorner")
            circleCorner.CornerRadius = UDim.new(1, 0)
            circleCorner.Parent = circle

            -- Outer ring
            local ring = Instance.new("UIStroke")
            ring.Color = Colors.Background
            ring.Thickness = 3
            ring.Parent = circle

            local min = options.Min or 0
            local max = options.Max or 100
            local rounding = options.Rounding or 0
            local value = options.Default or 0

            local function updateSlider(val, animate)
                value = math.clamp(val, min, max)
                if rounding > 0 then
                    value = math.round(value * (10 ^ rounding)) / (10 ^ rounding)
                else
                    value = math.floor(value)
                end
                local pct = (value - min) / (max - min)
                if animate then
                    TweenService:Create(fill, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(pct, 0, 1, 0)
                    }):Play()
                    TweenService:Create(fillGlow, TweenInfo.new(0.1), {
                        Size = UDim2.new(pct, 0, 1, 4)
                    }):Play()
                else
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    fillGlow.Size = UDim2.new(pct, 0, 1, 4)
                end
                valLabel.Text = tostring(value)
            end
            updateSlider(value, false)

            local dragging = false
            
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    -- Scale up circle
                    TweenService:Create(circle, TweenBounce, {
                        Size = UDim2.new(0, 20, 0, 20),
                        Position = UDim2.new(0, -10, 0.5, -10)
                    }):Play()
                    local relX = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                    updateSlider(min + relX * (max - min), true)
                    if options.Callback then options.Callback(value) end
                end
            end)

            fill.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    TweenService:Create(circle, TweenBounce, {
                        Size = UDim2.new(0, 20, 0, 20),
                        Position = UDim2.new(0, -10, 0.5, -10)
                    }):Play()
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    -- Scale back circle
                    TweenService:Create(circle, TweenFast, {
                        Size = UDim2.new(0, 16, 0, 16),
                        Position = UDim2.new(0, -8, 0.5, -8)
                    }):Play()
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local relX = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                    updateSlider(min + relX * (max - min), true)
                    if options.Callback then options.Callback(value) end
                end
            end)

            return {Value = function() return value end}
        end,

        AddInput = function(self, name, options)
            elementIndex = elementIndex + 1
            
            local inp = Instance.new("Frame")
            inp.Size = UDim2.new(1, 0, 0, 26)
            inp.BackgroundTransparency = 1
            inp.Parent = scrollFrame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0.45, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = options.Text or name
            label.TextColor3 = Colors.Text
            label.Font = Enum.Font.Gotham
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = inp

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(0.55, 0, 1, 0)
            box.Position = UDim2.new(0.45, 0, 0, 0)
            box.BackgroundColor3 = Colors.InputBg
            box.BorderSizePixel = 0
            box.Text = options.Default or ""
            box.PlaceholderText = options.Placeholder or ""
            box.TextColor3 = Colors.Text
            box.PlaceholderColor3 = Colors.TextDim
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.ClearTextOnFocus = false
            box.Parent = inp

            local boxCorner = Instance.new("UICorner")
            boxCorner.CornerRadius = UDim.new(0, 4)
            boxCorner.Parent = box

            local boxStroke = Instance.new("UIStroke")
            boxStroke.Color = Colors.GroupboxBorder
            boxStroke.Thickness = 1
            boxStroke.Parent = box

            box.Focused:Connect(function()
                playSound(UI_CLICK, 0.1)
                TweenService:Create(boxStroke, TweenFast, {
                    Color = Colors.Accent
                }):Play()
                TweenService:Create(box, TweenFast, {
                    Size = UDim2.new(0.55, 2, 1, 0)
                }):Play()
            end)

            box.FocusLost:Connect(function()
                TweenService:Create(boxStroke, TweenFast, {
                    Color = Colors.GroupboxBorder
                }):Play()
                TweenService:Create(box, TweenFast, {
                    Size = UDim2.new(0.55, 0, 1, 0)
                }):Play()
                if options.Finished and options.Callback then
                    options.Callback(box.Text)
                end
            end)

            if options.Numeric then
                box:GetPropertyChangedSignal("Text"):Connect(function()
                    if box.Text ~= "" and not box.Text:match("^%-?%d+%.?%d*$") then
                        box.Text = box.Text:gsub("[^%d%.%-]", "")
                    end
                end)
            end

            return box
        end
    }
end


