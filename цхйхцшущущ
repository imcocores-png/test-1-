task.spawn(function()
    local obsidian = nil
    repeat
        obsidian = game.CoreGui:FindFirstChild("Obsidian")
        task.wait(0.1)
    until obsidian or tick() > 30
    if not obsidian then return end
    
    local mainFrame = obsidian:FindFirstChild("MainWindow") or obsidian:FindFirstChild("Frame")
    if not mainFrame then return end
    
    local LeavesContainer = Instance.new("Frame")
    LeavesContainer.Name = "EtherealLeaves"
    LeavesContainer.Size = UDim2.new(1, 0, 1, 0)
    LeavesContainer.BackgroundTransparency = 1
    LeavesContainer.ClipsDescendants = true
    LeavesContainer.ZIndex = 0
    LeavesContainer.Parent = mainFrame

    local function createLeaf()
        if not LeavesContainer or not LeavesContainer.Parent then return end
        
        local leaf = Instance.new("Frame")
        leaf.Size = UDim2.new(0, 0, 0, 0)
        leaf.Position = UDim2.new(0, math.random(-20, mainFrame.AbsoluteSize.X.Offset), 0, -30)
        leaf.BackgroundTransparency = 1
        leaf.Rotation = math.random(0, 360)
        leaf.ZIndex = 0
        leaf.Parent = LeavesContainer

        local leafSize = math.random(10, 20)
        local leafWidth = leafSize * 0.55

        local base = Instance.new("Frame")
        base.Size = UDim2.new(0, leafSize, 0, leafWidth)
        base.BackgroundColor3 = Color3.fromRGB(math.random(140, 200), math.random(15, 40), math.random(10, 30))
        base.BackgroundTransparency = math.random(20, 50) / 100
        base.BorderSizePixel = 0
        base.Parent = leaf

        local baseCorner = Instance.new("UICorner")
        baseCorner.CornerRadius = UDim.new(0.5, 0)
        baseCorner.Parent = base

        local overlay = Instance.new("Frame")
        overlay.Size = UDim2.new(0, leafSize * 0.7, 0, leafWidth * 0.5)
        overlay.Position = UDim2.new(0.15, 0, 0.25, 0)
        overlay.BackgroundColor3 = Color3.fromRGB(math.random(180, 230), math.random(20, 50), math.random(15, 35))
        overlay.BackgroundTransparency = math.random(30, 60) / 100
        overlay.BorderSizePixel = 0
        overlay.Parent = leaf

        local overlayCorner = Instance.new("UICorner")
        overlayCorner.CornerRadius = UDim.new(0.5, 0)
        overlayCorner.Parent = overlay

        local vein = Instance.new("Frame")
        vein.Size = UDim2.new(0.8, 0, 0, 1)
        vein.Position = UDim2.new(0.1, 0, 0.5, 0)
        vein.BackgroundColor3 = Color3.fromRGB(math.random(80, 120), math.random(5, 15), math.random(5, 15))
        vein.BackgroundTransparency = 0.3
        vein.BorderSizePixel = 0
        vein.Parent = leaf

        local veinCorner = Instance.new("UICorner")
        veinCorner.CornerRadius = UDim.new(0.5, 0)
        veinCorner.Parent = vein

        local glow = Instance.new("ImageLabel")
        glow.Size = UDim2.new(2.5, 0, 2.5, 0)
        glow.Position = UDim2.new(-0.75, 0, -0.75, 0)
        glow.BackgroundTransparency = 1
        glow.Image = "rbxassetid://7669168585"
        glow.ImageColor3 = Color3.fromRGB(255, 50, 50)
        glow.ImageTransparency = 0.6
        glow.ZIndex = -1
        glow.Parent = leaf

        local fallSpeed = math.random(35, 80)
        local swayAmount = math.random(25, 70)
        local swaySpeed = math.random(1.5, 3)
        local rotateSpeed = math.random(30, 100)
        local startX = leaf.Position.X.Offset
        local startTime = tick()

        TweenService:Create(leaf, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, leafSize, 0, leafWidth)
        }):Play()

        local connection
        connection = RunService.RenderStepped:Connect(function(dt)
            if not leaf or not leaf.Parent then
                if connection then connection:Disconnect() end
                return
            end
            local elapsed = tick() - startTime
            local yPos = -30 + (elapsed * fallSpeed)
            local xOffset = math.sin(elapsed * swaySpeed) * swayAmount
            local rotation = (elapsed * rotateSpeed) % 360
            leaf.Position = UDim2.new(0, startX + xOffset, 0, yPos)
            leaf.Rotation = rotation
            
            if yPos > (mainFrame.AbsoluteSize.Y.Offset - 40) then
                local fadeProgress = (yPos - (mainFrame.AbsoluteSize.Y.Offset - 40)) / 40
                base.BackgroundTransparency = math.min((math.random(20, 50) / 100) + fadeProgress, 1)
                overlay.BackgroundTransparency = math.min((math.random(30, 60) / 100) + fadeProgress, 1)
            end
            
            if yPos > (mainFrame.AbsoluteSize.Y.Offset + 10) then
                connection:Disconnect()
                TweenService:Create(leaf, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(glow, TweenInfo.new(0.25), {
                    ImageTransparency = 1
                }):Play()
                task.delay(0.3, function()
                    if leaf and leaf.Parent then leaf:Destroy() end
                end)
            end
        end)
    end

    task.spawn(function()
        while LeavesContainer and LeavesContainer.Parent do
            createLeaf()
            task.wait(math.random(0.2, 0.6))
        end
    end)

    obsidian.DescendantRemoving:Connect(function(child)
        if child == obsidian then
            LeavesContainer = nil
        end
    end)
end)

