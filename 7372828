-- ====================== OWNER KICK v16 (REAL FLING - FREE-FLIGHT LAUNCH - HARD KICK - NO SPIN) ======================
do
    local ownerKickActive = false
    local ownerKickTask = nil
    local ownerFpsConn = nil
    local ownerKickHeight = 10
    local KICK_CYCLE_INTERVAL = 0.5  -- МОЛНИЯ-ЦИКЛ каждые 0.5 сек = 60 киков за 30 секунд (в 4 раза быстрее)
    local BURST_GAP = 0.0002         -- спам внутри цикла: 0.0002 сек между вызовами (берёт и МГНОВЕННО отпускает)
    local KICK_POWER_MIN = 500       -- СИЛА КИКА: мин. скорость запуска (свободный полёт - BP не гасит)
    local KICK_POWER_MAX = 750       -- СИЛА КИКА: макс. скорость запуска
    local KICK_LIFT_MIN = 130        -- ПОДЪЁМ на кике: мин. вертикальная скорость
    local KICK_LIFT_MAX = 220        -- ПОДЪЁМ на кике: макс. вертикальная скорость
    local KICK_FLIGHT_WINDOW = 0.15  -- окно свободного полёта: BP отпущен, кик летит на полной скорости
    local RAGDOLL_INTERVAL = 3.0     -- рэгдолл каждые 3 сек (5 раз за 15 сек) - БЕЗ колбаса, и на земле тоже (не встанет)
    local BRING_TIMEOUT = 2.0        -- ждём PartOwner до 2 сек, потом fallback-холд
    local kickStates = {}

    BlobGroup:AddLabel("Owner Kick v16: real fling - free-flight launch 500-750 + lift, 60 kicks/30s (2 owner : 1 destroy line)")

    BlobGroup:AddSlider("OwnerKickHeight", {
        Text = "Hover Height (5-15)",
        Min = 5,
        Max = 15,
        Default = 10,
        Rounding = 0,
        Callback = function(Value)
            ownerKickHeight = Value
        end
    })

    BlobGroup:AddCheckbox("OwnerKick", {
        Text = "Owner Kick",
        Default = false,
        Callback = function(Value)
            ownerKickActive = Value

            if Value then
                local hasTargets = false
                if type(kickList) == "table" then
                    for _, on in pairs(kickList) do
                        if on == true then hasTargets = true break end
                    end
                end
                if not hasTargets and not selectedTarget then
                    Library:Notify({Title = "Ethereal", Content = "Select targets in Target tab first!", Duration = 3})
                    ownerKickActive = false
                    return
                end
                local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                if not GE or not GE:FindFirstChild("SetNetworkOwner") or not GE:FindFirstChild("CreateGrabLine") then
                    Library:Notify({Title = "Ethereal", Content = "GrabEvents not found!", Duration = 3})
                    ownerKickActive = false
                    return
                end

                ownerKickTask = task.spawn(function()
                    local SNO = GE.SetNetworkOwner
                    local CGL = GE:FindFirstChild("CreateGrabLine")
                    local DGL = GE:FindFirstChild("DestroyGrabLine")
                    local RAGEv = ReplicatedStorage:FindFirstChild("CharacterEvents")
                    local RagR = RAGEv and RAGEv:FindFirstChild("RagdollRemote")
                    local currentFPS = 60
                    local blobHintShown = false

                    ownerFpsConn = RunService.RenderStepped:Connect(function(dt)
                        currentFPS = 1 / dt
                    end)

                    -- все цели из мульти-выбора вкладки Target + главный таргет как fallback
                    local function getKickTargetNames()
                        local seen, out = {}, {}
                        local function add(name)
                            if type(name) == "string" and name ~= "" and not seen[name] then
                                seen[name] = true
                                table.insert(out, name)
                            end
                        end
                        if type(kickList) == "table" then
                            for name, on in pairs(kickList) do
                                if on == true then add(name) end
                            end
                        end
                        add(selectedTarget)
                        table.sort(out)
                        return out
                    end

                    -- МЕХАНИКА ИГРЫ: сервер вставляет PartOwner в Head, когда владеешь частью
                    local function isOwned(tChar)
                        local head = tChar and tChar:FindFirstChild("Head")
                        local po = head and head:FindFirstChild("PartOwner")
                        return po and po.Value == LocalPlayer.Name
                    end

                    -- блобман + его grab-ремоуты (нужно сидеть в блобмане)
                    local function getBlobKit(myHum)
                        local seat = myHum and myHum.SeatPart
                        local blob = seat and seat:FindFirstAncestor("CreatureBlobman")
                        if not blob then return nil end
                        local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                        if not script then return nil end
                        return blob, script:FindFirstChild("CreatureGrab"), script:FindFirstChild("CreatureDrop")
                    end

                    -- SNO burst: МОЛНИЕНОСНЫЙ овнершип-спам (чем выше FPS, тем мощнее)
                    local function ownBurst(tRoot, cf)
                        -- лёгкий овнершип-толчок: всего 2 SNO (спам убран - пинг не растёт)
                        pcall(function()
                            SNO:FireServer(tRoot, cf)
                            SNO:FireServer(tRoot, cf)
                        end)
                    end

                    -- СЕРВЕРНАЯ граб-линия: DGL -> CGL -> x2 SNO одним пакетом -
                    -- линия всегда свежая, овнершип усиленный (цель НЕ ПАДАЕТ)
                    local function regrab(tRoot, hoverCF)
                        pcall(function()
                            if DGL then DGL:FireServer(tRoot) end
                            CGL:FireServer(tRoot, hoverCF)
                            SNO:FireServer(tRoot, hoverCF)
                            SNO:FireServer(tRoot, hoverCF)
                        end)
                        _G.EtherealOwnerKickGrabs = (_G.EtherealOwnerKickGrabs or 0) + 1
                    end

                    -- ФИЗИКА: жёсткий демпфированный BodyPosition P=45000 D=800 - цель НЕ ПАДАЕТ
                    local function createBP(tRoot, pos)
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA("BodyPosition") and v.Name == "OKKickBodyPos" then v:Destroy() end
                        end
                        local bp = Instance.new("BodyPosition")
                        bp.Name = "OKKickBodyPos"
                        bp.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        bp.P = 45000
                        bp.D = 800
                        bp.Position = pos
                        bp.Parent = tRoot
                        return bp
                    end

                    local function destroyBP(st)
                        pcall(function() if st.bp then st.bp:Destroy() end end)
                        st.bp = nil
                    end

                    -- yaw-only база: кристалл крутится вместе с тобой, но не заваливается
                    local function getYawCF(myRoot)
                        local look = myRoot.CFrame.LookVector
                        local yaw = math.atan2(-look.X, -look.Z)
                        return CFrame.new(myRoot.Position) * CFrame.Angles(0, yaw, 0)
                    end

                    -- КРИСТАЛЛ: слот жёстко по номеру цели - 1 СПРАВА, 2 СЛЕВА, 3 ВПЕРЕДИ, 4 СЗАДИ
                    -- (крутится вместе с тобой через yaw-базу, все висят в воздухе на Hover Height)
                    local function getOffset(i, n)
                        local slots = {
                            CFrame.new(4.5, 0, 0),   -- 1-я цель: СПРАВА от тебя
                            CFrame.new(-4.5, 0, 0),  -- 2-я цель: СЛЕВА от тебя
                            CFrame.new(0, 0, -4.5),  -- 3-я цель: ВПЕРЕДИ тебя
                            CFrame.new(0, 0, 4.5)    -- 4-я цель: СЗАДИ тебя
                        }
                        if i <= 4 then return slots[i] end
                        -- 5+: кольцо вокруг вертикали на той же высоте
                        local ang = (math.pi * 2 * (i - 1)) / n
                        return CFrame.new(math.sin(ang) * 4.5, 0, math.cos(ang) * 4.5)
                    end

                    while ownerKickActive do
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

                        if not myRoot or not myHum or myHum.Health <= 0 then
                            for _, st in pairs(kickStates) do
                                st.locked = false
                                st.grabStart = 0
                                st.checkStart = 0
                            end
                            task.wait(0.2)
                        else
                            local names = getKickTargetNames()
                            if #names == 0 then break end

                            local blob, GrabR, DropR = getBlobKit(myHum)
                            if not blob and not blobHintShown then
                                blobHintShown = true
                                Library:Notify({Title = "Ethereal", Content = "Tip: sit in blobman for grab/drop kick cycles!", Duration = 4})
                            end

                            local baseCF = getYawCF(myRoot) * CFrame.new(0, ownerKickHeight, 0)
                            local now = tick()

                            for i, name in ipairs(names) do
                                local plr = Players:FindFirstChild(name)
                                local tChar = plr and plr.Parent and plr.Character
                                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                                local inPlot = plr and plr:FindFirstChild("InPlot")

                                if not tRoot or not tHum or tHum.Health <= 0 then
                                    local st = kickStates[name]
                                    if st then destroyBP(st) end
                                    kickStates[name] = nil
                                else
                                    local st = kickStates[name]
                                    if not st then
                                        st = { locked = false, grabStart = 0, checkStart = 0, lastGrab = 0,
                                               lastBurst = 0, lastRag = 0, lastBringSNO = 0, lastHold = 0,
                                               lastOwn = 0, flingUntil = 0,
                                               seed = math.random() * 10, notified = false, bp = nil }
                                        kickStates[name] = st
                                    end

                                    -- цель в своём плоте и ещё не захвачена -> грабнуть нельзя, ждём
                                    if (not st.locked) and inPlot and inPlot.Value then
                                        -- skip: в плоте граб не работает
                                    else
                                        local formCF = baseCF * getOffset(i, #names)
                                        local formPos = formCF.Position

                                        if not st.locked then
                                            -- PHASE 1: BRING (физика INIT из сурса)
                                            -- velocity prediction: летим на цель с опережением по её скорости
                                            myRoot.CFrame = tRoot.CFrame * CFrame.new(tRoot.AssemblyLinearVelocity * 0.1)
                                            -- SNO x3 каждые 0.05с в bring - быстро забираем овнершип
                                            if (now - st.lastBringSNO) >= 0.05 then
                                                st.lastBringSNO = now
                                                pcall(function()
                                                    tHum.PlatformStand = true
                                                    tHum.Sit = true
                                                    SNO:FireServer(tRoot, tRoot.CFrame)
                                                    SNO:FireServer(tRoot, tRoot.CFrame)
                                                    SNO:FireServer(tRoot, tRoot.CFrame)
                                                end)
                                            end
                                            -- BP тянет цель вверх, пока мы её догоняем (овнершип-авторитет)
                                            if st.bp and st.bp.Parent then
                                                st.bp.Position = formPos
                                            else
                                                st.bp = createBP(tRoot, formPos)
                                            end
                                            myRoot.AssemblyLinearVelocity = Vector3.zero
                                            myRoot.AssemblyAngularVelocity = Vector3.zero

                                            if st.grabStart == 0 then st.grabStart = now end
                                            -- залочено, когда сервер подтвердил PartOwner (как в сурсе)
                                            if isOwned(tChar) then
                                                st.locked = true
                                                st.grabStart = 0
                                                st.checkStart = now
                                                st.lastGrab = 0
                                                playSound(KICK_SOUND_ID, 0.8)
                                                if not st.notified then
                                                    st.notified = true
                                                    Library:Notify({Title = "Ethereal", Content = "Owner Kick: " .. name .. " owned + locked!", Duration = 2})
                                                end
                                            elseif now - st.grabStart > BRING_TIMEOUT then
                                                -- fallback: холд без подтверждения PartOwner
                                                st.locked = true
                                                st.grabStart = 0
                                                st.checkStart = now
                                                st.lastGrab = 0
                                                playSound(KICK_SOUND_ID, 0.8)
                                            end
                                        else
                                            -- PHASE 2: OWNERSHIP HOLD (физика MAIN из сурса + наше)
                                            local owned = isOwned(tChar)

                                            -- 1) BP следует за точкой формации (плавный парящий холд)
                                            if st.bp and st.bp.Parent then
                                                st.bp.Position = formPos
                                            else
                                                st.bp = createBP(tRoot, formPos)
                                            end

                                            if owned then
                                                -- Мы владеем физикой цели (PartOwner) - импульсы работают.
                                                pcall(function()
                                                    tHum.PlatformStand = true
                                                    tHum.Sit = true
                                                    -- АНТИ-ВРАЩЕНИЕ: гасим крутящую скорость КАЖДЫЙ кадр -
                                                    -- цель висит тряпкой, но её НЕ КРУТИТ и не кувыркает
                                                    tRoot.AssemblyAngularVelocity = Vector3.zero
                                                end)

                                                -- RAGDOLL: каждые 3 сек (5 раз за 15 сек), в воздухе И на земле -
                                                -- встать/пойти невозможно, а колбаса от частого рэгдолла исчезла
                                                if RagR and (now - st.lastRag) >= RAGDOLL_INTERVAL then
                                                    st.lastRag = now
                                                    pcall(function() RagR:FireServer(tRoot, 1) end)
                                                end

                                                -- МОЛНИЯ-ЦИКЛ (каждые 0.5 сек = 60 киков за 30 секунд):
                                                -- спам между вызовами 0.0002 сек, паттерн цикла: 2 раза ОВНЕР берёт ->
                                                -- 1 раз ДЕСТРОЙ ЛАЙН (хороший дестрой граб сразу после овнера).
                                                -- РЕАЛЬНЫЙ КИК (физика фтапа): BP отпускает цель на 0.15с (свободный
                                                -- полёт) -> импульс 500-750 + подъём 130-220 НЕ гасится - игрок УЛЕТАЕТ.
                                                if (now - st.lastBurst) >= KICK_CYCLE_INTERVAL then
                                                    st.lastBurst = now
                                                    _G.EtherealOwnerKickGrabs = (_G.EtherealOwnerKickGrabs or 0) + 1
                                                    task.spawn(function()
                                                        pcall(function()
                                                            local flat = Vector3.new(formPos.X - myRoot.Position.X, 0, formPos.Z - myRoot.Position.Z)
                                                            if flat.Magnitude < 0.5 then flat = myRoot.CFrame.RightVector end
                                                            local dir = flat.Unit
                                                            local side = Vector3.new(-dir.Z, 0, dir.X)
                                                            local fdir = (dir + side * ((math.random() - 0.5) * 0.5)).Unit
                                                            -- БЕРЁТ: серверная граб-линия схватывает цель
                                                            CGL:FireServer(tRoot, formCF)
                                                            task.wait(BURST_GAP)
                                                            -- ОВНЕР БЕРЁТ #1: SetNetworkOwner на себя
                                                            SNO:FireServer(tRoot, formCF)
                                                            task.wait(BURST_GAP)
                                                            -- ОВНЕР БЕРЁТ #2: овнершип усилен до предела
                                                            SNO:FireServer(tRoot, formCF)
                                                            task.wait(BURST_GAP)
                                                            -- ДЕСТРОЙ ЛАЙН: молниеносный отпуск - линия лопается, цель свободна
                                                            if DGL then DGL:FireServer(tRoot) end
                                                            task.wait(BURST_GAP)
                                                            -- СВОБОДНЫЙ ПОЛЁТ: BP отпускает цель (MaxForce = 0) - НИЧТО не гасит кик
                                                            if st.bp and st.bp.Parent then st.bp.MaxForce = Vector3.zero end
                                                            st.flingUntil = now + KICK_FLIGHT_WINDOW
                                                            -- ЖЁСТКИЙ КИК: 500-750 вбок + 130-220 вверх - реальный флинг как в фтапе
                                                            tRoot.AssemblyLinearVelocity = Vector3.new(fdir.X, 0, fdir.Z) * (KICK_POWER_MIN + math.random() * (KICK_POWER_MAX - KICK_POWER_MIN)) + Vector3.new(0, KICK_LIFT_MIN + math.random() * (KICK_LIFT_MAX - KICK_LIFT_MIN), 0)
                                                            tRoot.AssemblyAngularVelocity = Vector3.zero
                                                            -- ОВНЕРШИП В ПОЛЁТЕ: не теряем владение на скорости (улучшенный овнершип)
                                                            SNO:FireServer(tRoot, formCF)
                                                            task.wait(KICK_FLIGHT_WINDOW)
                                                            -- ЛОВИМ ОБРАТНО: BP включается и тянет цель обратно в слот
                                                            if st.bp and st.bp.Parent then st.bp.MaxForce = Vector3.new(9e9, 9e9, 9e9) end
                                                        end)
                                                    end)
                                                end
                                            else
                                                -- fallback: вертикальный CFrame-холд (раз в 0.1с, без дёргания),
                                                -- пока овнершип восстанавливается
                                                if (now - st.lastHold) >= 0.1 then
                                                    st.lastHold = now
                                                    local holdCF = formCF
                                                    pcall(function()
                                                        tRoot.CFrame = holdCF
                                                        tRoot.AssemblyLinearVelocity = Vector3.zero
                                                        tRoot.AssemblyAngularVelocity = Vector3.zero
                                                        tRoot.Velocity = Vector3.zero
                                                        tHum.PlatformStand = true
                                                    end)
                                                end
                                            end

                                            -- 2) АДАПТИВНЫЙ ОВНЕРШИП: пока PartOwner наш - поддерживаем
                                            --    SNO раз в 0.08с (пинг почти не растёт). Потеряли овнершип -
                                            --    жёсткий дожим SNO x2 КАЖДЫЙ КАДР, пока сервер не вернёт
                                            --    PartOwner -> цель НЕ ПАДАЕТ и не может ходить.
                                            if owned then
                                                if (now - st.lastOwn) >= 0.08 then
                                                    st.lastOwn = now
                                                    ownBurst(tRoot, formCF)
                                                end
                                            else
                                                ownBurst(tRoot, formCF)
                                                ownBurst(tRoot, formCF)
                                            end

                                            -- 3) ANTI-FALL WATCHDOG: упал / отдрейфовал -> экстренный re-grab
                                            local fell = (tRoot.Position.Y < formPos.Y - 5) or ((tRoot.Position - formPos).Magnitude > 16)
                                            if fell and now >= st.flingUntil then
                                                st.lastGrab = 0
                                                regrab(tRoot, formCF)
                                                ownBurst(tRoot, formCF)
                                                st.bp = createBP(tRoot, formPos)
                                            end

                                            -- 4) escape check: цель реально улетела далеко после кика -> ребринг
                                            if st.checkStart > 0 and now - st.checkStart > 0.6 and now >= st.flingUntil then
                                                local currentDist = (tRoot.Position - formPos).Magnitude
                                                if currentDist > 26 then
                                                    st.locked = false
                                                    st.grabStart = 0
                                                    st.checkStart = 0
                                                    st.notified = false
                                                else
                                                    st.checkStart = now
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        RunService.Heartbeat:Wait()
                    end

                    if ownerFpsConn then ownerFpsConn:Disconnect() ownerFpsConn = nil end
                end)
            else
                ownerKickActive = false
                if ownerKickTask then task.cancel(ownerKickTask) ownerKickTask = nil end
                if ownerFpsConn then ownerFpsConn:Disconnect() ownerFpsConn = nil end

                -- RELEASE: уничтожаем BP, граб-линии и отпускаем всех
                local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                local function releaseTarget(name)
                    local plr = name and Players:FindFirstChild(name)
                    if plr and plr.Character then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if tRoot then
                            for _, v in pairs(tRoot:GetChildren()) do
                                if v:IsA("BodyPosition") and v.Name == "OKKickBodyPos" then
                                    pcall(function() v:Destroy() end)
                                end
                            end
                            if GE and GE:FindFirstChild("DestroyGrabLine") then
                                pcall(function() GE.DestroyGrabLine:FireServer(tRoot) end)
                            end
                            local RAGEv2 = ReplicatedStorage:FindFirstChild("CharacterEvents")
                            local RagR2 = RAGEv2 and RAGEv2:FindFirstChild("RagdollRemote")
                            if RagR2 then
                                pcall(function() RagR2:FireServer(tRoot, 0) end)
                            end
                            pcall(function()
                                tRoot.AssemblyLinearVelocity = Vector3.zero
                                tRoot.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                        if tHum then
                            pcall(function()
                                tHum.PlatformStand = false
                                tHum.Sit = false
                            end)
                        end
                    end
                end
                if type(kickList) == "table" then
                    for name, on in pairs(kickList) do
                        if on == true then releaseTarget(name) end
                    end
                end
                releaseTarget(selectedTarget)
                for k in pairs(kickStates) do kickStates[k] = nil end
            end
        end
    })
end


-- ====================== NO BLOBMAN METHODS ======================
local NoBlobGroup = Tabs.Target:AddRightGroupbox("No Blobman Methods", "axe")

-- FLING TARGET
do
    local flingActive = false
    local flingBAV = nil
    local flingOriginalPos = nil
    local flingLoop = nil

    NoBlobGroup:AddCheckbox("FlingTarget", {
        Text = "Fling Target",
        Default = false,
        Callback = function(Value)
            flingActive = Value

            if Value then
                local targetPlayer = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                if not targetPlayer or not targetPlayer.Character then
                    flingActive = false
                    Library:Notify({Title = "Ethereal", Content = "Select a valid target first!", Duration = 3})
                    return
                end

                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    flingOriginalPos = myRoot.CFrame
                end

                task.spawn(function()
                    while flingActive do
                        local target = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                        if not target then
                            flingActive = false
                            break
                        end

                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")

                        if not hrp or not hum then
                            task.wait(0.5)
                            continue
                        end

                        if target and target.Parent then
                            local tChar = target.Character
                            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            local tHum = tChar and tChar:FindFirstChild("Humanoid")

                            if tRoot and tHum and tHum.Health > 0 then
                                if not flingBAV or flingBAV.Parent ~= hrp then
                                    if flingBAV then flingBAV:Destroy() end
                                    flingBAV = Instance.new("BodyAngularVelocity")
                                    flingBAV.Name = "EtherealSpin"
                                    flingBAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                    flingBAV.AngularVelocity = Vector3.new(0, 10000, 0)
                                    flingBAV.P = 10000
                                    flingBAV.Parent = hrp
                                end

                                for _, part in pairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end

                                flingLoop = RunService.Heartbeat:Connect(function()
                                    if not flingActive or not tRoot or not tRoot.Parent then return end
                                    hrp.CFrame = tRoot.CFrame
                                    hrp.Velocity = Vector3.zero
                                end)

                                local startTime = tick()
                                while tick() - startTime < 1.5 do
                                    if not flingActive or not tRoot.Parent then break end
                                    task.wait(0.1)
                                end

                                if flingLoop then
                                    flingLoop:Disconnect()
                                    flingLoop = nil
                                end
                            else
                                task.wait(0.2)
                            end
                        else
                            flingActive = false
                        end
                        task.wait(0.1)
                    end

                    if flingBAV then flingBAV:Destroy() flingBAV = nil end
                    char = LocalPlayer.Character
                    if char then
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = true end
                        end
                        hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.RotVelocity = Vector3.zero
                            hrp.Velocity = Vector3.zero
                            if flingOriginalPos then hrp.CFrame = flingOriginalPos end
                        end
                    end
                end)
            else
                flingActive = false
                if flingBAV then flingBAV:Destroy() flingBAV = nil end
                if flingLoop then flingLoop:Disconnect() flingLoop = nil end
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.RotVelocity = Vector3.zero
                    hrp.Velocity = Vector3.zero
                end
            end
        end
    })
end

-- OWNERSHIP KICK
do
    local ownershipKickEnabled = false
    local ownershipKickTask = nil
    local ownershipFpsConn = nil

    NoBlobGroup:AddCheckbox("OwnershipKick", {
        Text = "Ownership Kick",
        Default = false,
        Callback = function(Value)
            ownershipKickEnabled = Value

            if Value then
                local targetPlayer = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                if not targetPlayer or not targetPlayer.Character then
                    ownershipKickEnabled = false
                    Library:Notify({Title = "Ethereal", Content = "Select a valid target first!", Duration = 3})
                    return
                end

                local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                if not GE or not GE:FindFirstChild("SetNetworkOwner") then
                    ownershipKickEnabled = false
                    Library:Notify({Title = "Ethereal", Content = "GrabEvents not found!", Duration = 3})
                    return
                end

                ownershipKickTask = task.spawn(function()
                    local savedPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not savedPos then ownershipKickEnabled = false return end
                    savedPos = savedPos.CFrame

                    local dragging = false
                    local grabStartTime = 0
                    local checkStartTime = 0
                    local currentFPS = 60
                    local bodyPos = nil
                    local bodyGyro = nil

                    local function cleanupBodies()
                        pcall(function()
                            if bodyPos then bodyPos:Destroy() bodyPos = nil end
                            if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
                        end)
                    end

                    local function createBodies(targetRoot, pos)
                        cleanupBodies()
                        for _, v in pairs(targetRoot:GetChildren()) do
                            if v:IsA("BodyPosition") or v:IsA("BodyGyro") then v:Destroy() end
                        end
                        bodyPos = Instance.new("BodyPosition")
                        bodyPos.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        bodyPos.D = 100
                        bodyPos.Position = pos
                        bodyPos.Parent = targetRoot
                        bodyGyro = Instance.new("BodyGyro")
                        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                        bodyGyro.D = 100
                        bodyGyro.CFrame = CFrame.new(pos)
                        bodyGyro.Parent = targetRoot
                    end

                    ownershipFpsConn = RunService.RenderStepped:Connect(function(dt)
                        currentFPS = 1 / dt
                    end)

                    while ownershipKickEnabled do
                        local currentTarget = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                        if not currentTarget or not currentTarget.Parent then cleanupBodies() break end

                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        local tChar = currentTarget.Character
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHum = tChar and tChar:FindFirstChild("Humanoid")

                        if tRoot and tHum and tHum.Health > 0 and myRoot then
                            if not dragging then
                                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                                cleanupBodies()
                                checkStartTime = 0

                                pcall(function()
                                    tHum.PlatformStand = true
                                    tHum.Sit = true
                                    if GE.SetNetworkOwner then
                                        GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                        GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                    end
                                    if GE.DestroyGrabLine then
                                        GE.DestroyGrabLine:FireServer(tRoot)
                                    end
                                end)

                                myRoot.AssemblyLinearVelocity = Vector3.zero
                                myRoot.AssemblyAngularVelocity = Vector3.zero

                                if grabStartTime == 0 then grabStartTime = tick() end
                                if tick() - grabStartTime > 0.35 then
                                    dragging = true
                                    grabStartTime = 0
                                    checkStartTime = tick()
                                    local lockPos = savedPos * CFrame.new(5, 20, 4)
                                    createBodies(tRoot, lockPos.Position)
                                end
                            else
                                myRoot.CFrame = savedPos
                                local lockPos = savedPos * CFrame.new(5, 20, 4)
                                myRoot.AssemblyLinearVelocity = Vector3.zero
                                myRoot.AssemblyAngularVelocity = Vector3.zero

                                if bodyPos and bodyPos.Parent then
                                    bodyPos.Position = lockPos.Position
                                    if bodyGyro then bodyGyro.CFrame = lockPos end
                                else
                                    createBodies(tRoot, lockPos.Position)
                                end

                                tHum.PlatformStand = true

                                pcall(function()
                                    if GE.SetNetworkOwner and GE.DestroyGrabLine then
                                        if currentFPS > 200 then
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.DestroyGrabLine:FireServer(tRoot)
                                        elseif currentFPS >= 155 and currentFPS <= 200 then
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.DestroyGrabLine:FireServer(tRoot)
                                        else
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                            GE.DestroyGrabLine:FireServer(tRoot)
                                        end
                                    end
                                end)

                                if checkStartTime > 0 and tick() - checkStartTime > 0.30 then
                                    local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                                    if currentDist > 10 then
                                        dragging = false
                                        grabStartTime = 0
                                        checkStartTime = 0
                                        cleanupBodies()
                                        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                                    else
                                        checkStartTime = tick()
                                    end
                                end
                            end
                        else
                            dragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            cleanupBodies()
                        end

                        RunService.Heartbeat:Wait()
                    end

                    if ownershipFpsConn then ownershipFpsConn:Disconnect() ownershipFpsConn = nil end
                    cleanupBodies()
                    myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then myRoot.CFrame = savedPos end
                end)
            else
                ownershipKickEnabled = false
                if ownershipKickTask then task.cancel(ownershipKickTask) ownershipKickTask = nil end
                if ownershipFpsConn then ownershipFpsConn:Disconnect() ownershipFpsConn = nil end

                local targetPlayer = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                if targetPlayer and targetPlayer.Character then
                    local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA("BodyPosition") or v:IsA("BodyGyro") then
                                pcall(function() v:Destroy() end)
                            end
                        end
                        pcall(function()
                            tRoot.AssemblyLinearVelocity = Vector3.zero
                            tRoot.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
            end
        end
    })
end

-- RAGDOLL SPAM TARGET
do
    local ragdollSpamActive = false
    local ragdollSpamTask = nil

    NoBlobGroup:AddCheckbox("RagdollSpam", {
        Text = "Ragdoll Spam Target",
        Default = false,
        Callback = function(Value)
            ragdollSpamActive = Value

            if Value then
                local targetPlayer = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                if not targetPlayer or not targetPlayer.Character then
                    ragdollSpamActive = false
                    Library:Notify({Title = "Ethereal", Content = "Select a valid target first!", Duration = 3})
                    return
                end

                ragdollSpamTask = task.spawn(function()
                    local ragdollRemote = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")
                    if not ragdollRemote then
                        Library:Notify({Title = "Ethereal", Content = "RagdollRemote not found!", Duration = 3})
                        ragdollSpamActive = false
                        return
                    end

                    while ragdollSpamActive do
                        local target = Options.TargetDrop.Value and Players:FindFirstChild(Options.TargetDrop.Value)
                        if not target or not target.Character then
                            ragdollSpamActive = false
                            break
                        end

                        local tChar = target.Character
                        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
                        local tHum = tChar:FindFirstChild("Humanoid")

                        if tHRP and tHum and tHum.Health > 0 then
                            for i = 1, 5 do
                                pcall(function()
                                    ragdollRemote:FireServer(tHRP, 0.00000000001)
                                end)
                            end
