-- ====================== PLAYER ESP (from rr9) ======================
do
    local espEnabled = false
    local espColor = Color3.fromRGB(255, 0, 0)
    local rainbowEnabled = false
    local espConnections = {}
    local espObjects = {}
    
    local function createESP(player)
        if not player or not player.Character then return end
        
        local char = player.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.Adornee = char
        highlight.FillColor = espColor
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Name"
        billboard.Adornee = hrp
        billboard.Size = UDim2.new(0, 200, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = hrp
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = player.DisplayName .. " (" .. player.Name .. ")"
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.Parent = billboard
        
        local distBillboard = Instance.new("BillboardGui")
        distBillboard.Name = "ESP_Distance"
        distBillboard.Adornee = hrp
        distBillboard.Size = UDim2.new(0, 100, 0, 20)
        distBillboard.StudsOffset = Vector3.new(0, -2, 0)
        distBillboard.AlwaysOnTop = true
        distBillboard.Parent = hrp
        
        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 1, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0 studs"
        distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distLabel.Font = Enum.Font.GothamBold
        distLabel.TextScaled = true
        distLabel.Parent = distBillboard
        
        table.insert(espObjects, {
            player = player,
            highlight = highlight,
            billboard = billboard,
            distBillboard = distBillboard,
            label = label,
            distLabel = distLabel
        })
        
        local conn = RunService.RenderStepped:Connect(function()
            if not espEnabled or not player.Character then
                conn:Disconnect()
                return
            end
            
            local localChar = LocalPlayer.Character
            local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
            if localHrp and hrp and hrp.Parent then
                local dist = math.floor((hrp.Position - localHrp.Position).Magnitude)
                distLabel.Text = dist .. " studs"
            end
        end)
        table.insert(espConnections, conn)
    end
    
    local function clearESP()
        for _, conn in ipairs(espConnections) do
            pcall(function() conn:Disconnect() end)
        end
        espConnections = {}
        
        for _, obj in ipairs(espObjects) do
            pcall(function()
                if obj.highlight then obj.highlight:Destroy() end
                if obj.billboard then obj.billboard:Destroy() end
                if obj.distBillboard then obj.distBillboard:Destroy() end
            end)
        end
        espObjects = {}
    end
    
    local function updateAllESP()
        clearESP()
        if not espEnabled then return end
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                createESP(plr)
            end
        end
    end
    
    local function updateColors()
        for _, obj in ipairs(espObjects) do
            pcall(function()
                if obj.highlight then
                    obj.highlight.FillColor = espColor
                end
            end)
        end
    end
    
    local ESPGroup = Tabs.Visuals:AddLeftGroupbox("Player ESP", "eye")
    
    ESPGroup:AddLabel("ESP Color"):AddColorPicker("ESPColorPicker", {
        Default = Color3.fromRGB(255, 0, 0),
        Title = "ESP Color",
        Callback = function(Value)
            espColor = Value
            if not rainbowEnabled then
                updateColors()
            end
        end
    })
    
    ESPGroup:AddCheckbox("RainbowESP", {
        Text = "Rainbow ESP",
        Default = false,
        Callback = function(Value)
            rainbowEnabled = Value
            if Value then
                task.spawn(function()
                    while rainbowEnabled and espEnabled do
                        local hue = tick() % 1
                        espColor = Color3.fromHSV(hue, 1, 1)
                        updateColors()
                        task.wait(0.05)
                    end
                end)
            else
                espColor = Options.ESPColorPicker.Value or Color3.fromRGB(255, 0, 0)
                updateColors()
            end
        end
    })
    
    ESPGroup:AddCheckbox("PlayerESP", {
        Text = "Enable Player ESP",
        Default = false,
        Callback = function(Value)
            espEnabled = Value
            if Value then
                updateAllESP()
                
                local playerAddedConn = Players.PlayerAdded:Connect(function(plr)
                    task.wait(0.5)
                    if espEnabled and plr ~= LocalPlayer and plr.Character then
                        createESP(plr)
                    end
                end)
                table.insert(espConnections, playerAddedConn)
                
                local charAddedConn = Players.PlayerAdded:Connect(function(plr)
                    if espEnabled and plr ~= LocalPlayer then
                        local charConn = plr.CharacterAdded:Connect(function()
                            task.wait(0.5)
                            if espEnabled and plr.Character then
                                local exists = false
                                for _, obj in ipairs(espObjects) do
                                    if obj.player == plr then
                                        exists = true
                                        break
                                    end
                                end
                                if not exists then
                                    createESP(plr)
                                end
                            end
                        end)
                        table.insert(espConnections, charConn)
                    end
                end)
                table.insert(espConnections, charAddedConn)
            else
                clearESP()
            end
        end
    })
    
    Players.PlayerRemoving:Connect(function(plr)
        for i, obj in ipairs(espObjects) do
            if obj.player == plr then
                pcall(function()
                    if obj.highlight then obj.highlight:Destroy() end
                    if obj.billboard then obj.billboard:Destroy() end
                    if obj.distBillboard then obj.distBillboard:Destroy() end
                end)
                table.remove(espObjects, i)
                break
            end
        end
    end)
end

-- ====================== SKELETON ESP v3 (FULL BONE + NAME/DIST/HP + HIDE BODY x2) ======================
do
    local skelEnabled = false
    local skelMode = "All Players"
    local skelColor = Color3.fromRGB(0, 255, 120)
    local skelHideBody = true
    local skelShowName = true
    local skelShowDist = true
    local skelShowHP = true
    local skelRainbow = false
    local skelThickness = 2
    local skelMaxDist = 2000
    local skelConn = nil
    local objPool = {}     -- [plr] = { lines, circle, textName, textDist, hpBG, hpFill }
    local hiddenParts = {} -- [plr] = { char, conn, done, [inst] = {m=}|{d=} }
    local lastChar = {}    -- [plr] = character

    local hasDrawing = false
    pcall(function() hasDrawing = (Drawing ~= nil and Drawing.new ~= nil) end)

    local function hidePoolObjs(pool)
        for _, ln in ipairs(pool.lines) do
            ln.Visible = false
        end
        if pool.circle then pool.circle.Visible = false end
        if pool.textName then pool.textName.Visible = false end
        if pool.textDist then pool.textDist.Visible = false end
        if pool.hpBG then pool.hpBG.Visible = false end
        if pool.hpFill then pool.hpFill.Visible = false end
    end

    -- вернуть телу нормальную видимость (+ снять вотчер новых частей)
    local function restoreBody(plr)
        local saved = hiddenParts[plr]
        if saved then
            if saved.conn then
                pcall(function() saved.conn:Disconnect() end)
            end
            for inst, o in pairs(saved) do
                if type(o) == "table" then
                    if o.m then
                        pcall(function() inst.LocalTransparencyModifier = o.m end)
                    elseif o.d then
                        pcall(function() inst.Transparency = o.d end)
                    end
                end
            end
        end
        hiddenParts[plr] = nil
    end

    local function clearObjs(plr)
        local pool = objPool[plr]
        if pool then
            for _, ln in ipairs(pool.lines) do
                pcall(function() ln:Remove() end)
            end
            if pool.circle then pcall(function() pool.circle:Remove() end) end
            if pool.textName then pcall(function() pool.textName:Remove() end) end
            if pool.textDist then pcall(function() pool.textDist:Remove() end) end
            if pool.hpBG then pcall(function() pool.hpBG:Remove() end) end
            if pool.hpFill then pcall(function() pool.hpFill:Remove() end) end
        end
        objPool[plr] = nil
        restoreBody(plr)
        lastChar[plr] = nil
    end

    local function clearAll()
        for plr in pairs(objPool) do
            clearObjs(plr)
        end
        for plr in pairs(hiddenParts) do
            restoreBody(plr)
        end
        lastChar = {}
    end

    local function wanted(plr)
        if plr == LocalPlayer then return false end
        if skelMode == "All Players" then return true end
        if skelMode == "Selected Target" then return plr.Name == selectedTarget end
        if skelMode == "Multi Targets" then
            return type(kickList) == "table" and kickList[plr.Name] == true
        end
        return false
    end

    -- пул x2: 13 линий (полный скелет с локтями/коленями) + круг + имя + дистанция + HP-бар
    local function getObjs(plr)
        local pool = objPool[plr]
        if not pool then
            local lines = {}
            for _ = 1, 13 do
                local ln = Drawing.new("Line")
                ln.Thickness = skelThickness
                ln.Color = skelColor
                ln.Visible = false
                table.insert(lines, ln)
            end
            local circle = Drawing.new("Circle")
            circle.Thickness = skelThickness
            circle.NumSides = 32
            circle.Filled = false
            circle.Color = skelColor
            circle.Visible = false

            local textName = Drawing.new("Text")
            textName.Size = 14
            textName.Center = true
            textName.Outline = true
            textName.OutlineColor = Color3.new(0, 0, 0)
            textName.Color = skelColor
            textName.Visible = false

            local textDist = Drawing.new("Text")
            textDist.Size = 13
            textDist.Center = true
            textDist.Outline = true
            textDist.OutlineColor = Color3.new(0, 0, 0)
            textDist.Color = skelColor
            textDist.Visible = false

            local hpBG = Drawing.new("Square")
            hpBG.Thickness = 1
            hpBG.Filled = false
            hpBG.Color = Color3.new(0, 0, 0)
            hpBG.Visible = false

            local hpFill = Drawing.new("Square")
            hpFill.Thickness = 1
            hpFill.Filled = true
            hpFill.Color = Color3.fromRGB(0, 255, 0)
            hpFill.Visible = false

            pool = { lines = lines, circle = circle, textName = textName, textDist = textDist, hpBG = hpBG, hpFill = hpFill }
            objPool[plr] = pool
        end
        return pool
    end

    -- спрятать тело x2: полный скан 1 раз на спавн, дальше DescendantAdded ловит всё новое
    local function hideBody(plr, char)
        local saved = hiddenParts[plr]
        if saved and saved.char == char and saved.done then
            return
        end
        if not saved or saved.char ~= char then
            restoreBody(plr)
            saved = { char = char }
            hiddenParts[plr] = saved
            saved.conn = char.DescendantAdded:Connect(function(inst)
                local s = hiddenParts[plr]
                if s and s.char == char then
                    if inst:IsA("BasePart") and not s[inst] then
                        s[inst] = { m = inst.LocalTransparencyModifier }
                        pcall(function() inst.LocalTransparencyModifier = 1 end)
                    elseif (inst:IsA("Decal") or inst:IsA("Texture")) and not s[inst] then
                        s[inst] = { d = inst.Transparency }
                        pcall(function() inst.Transparency = 1 end)
                    end
                end
            end)
        end
        for _, inst in ipairs(char:GetDescendants()) do
            if inst:IsA("BasePart") and not saved[inst] then
                saved[inst] = { m = inst.LocalTransparencyModifier }
                pcall(function() inst.LocalTransparencyModifier = 1 end)
            elseif (inst:IsA("Decal") or inst:IsA("Texture")) and not saved[inst] then
                saved[inst] = { d = inst.Transparency }
                pcall(function() inst.Transparency = 1 end)
            end
        end
        saved.done = true
    end

    -- полный костяк: голова(круг), шея, позвоночник, плечевая/тазовая линии,
    -- руки с локтями, ноги с коленями (R6 + R15)
    local function getRig(char)
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not head or not torso then return nil end
        local lower = char:FindFirstChild("LowerTorso")
        local hipBase = lower or torso

        local handL = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
        local handR = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
        local footL = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
        local footR = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
        if not (handL and handR and footL and footR) then return nil end

        local lowerArmL = char:FindFirstChild("LeftLowerArm")
        local lowerArmR = char:FindFirstChild("RightLowerArm")
        local lowerLegL = char:FindFirstChild("LeftLowerLeg")
        local lowerLegR = char:FindFirstChild("RightLowerLeg")

        local r6 = (torso.Name == "Torso")
        local function tip(part)
            if r6 then
                return (part.CFrame * CFrame.new(0, -part.Size.Y / 2, 0)).Position
            end
            return part.Position
        end
        -- сустав: R15 - верх нижней секции, R6 - центр части
        local function joint(part)
            if part then
                if r6 then
                    return part.Position
                end
                return (part.CFrame * CFrame.new(0, part.Size.Y / 2, 0)).Position
            end
            return nil
        end

        local tS = torso.Size
        local hS = hipBase.Size
        local neck = (torso.CFrame * CFrame.new(0, tS.Y / 2, 0)).Position
        local chest = torso.Position
        local hipC = (hipBase.CFrame * CFrame.new(0, -hS.Y / 2, 0)).Position
        local shL = (torso.CFrame * CFrame.new(-tS.X / 2, tS.Y / 2 - 0.3, 0)).Position
        local shR = (torso.CFrame * CFrame.new(tS.X / 2, tS.Y / 2 - 0.3, 0)).Position
        local hipL = (hipBase.CFrame * CFrame.new(-hS.X / 4, -hS.Y / 2, 0)).Position
        local hipR = (hipBase.CFrame * CFrame.new(hS.X / 4, -hS.Y / 2, 0)).Position

        local handLPos = tip(handL)
        local handRPos = tip(handR)
        local footLPos = tip(footL)
        local footRPos = tip(footR)
        local elbL = joint(lowerArmL) or ((shL + handLPos) * 0.5)
        local elbR = joint(lowerArmR) or ((shR + handRPos) * 0.5)
        local kneeL = joint(lowerLegL) or ((hipL + footLPos) * 0.5)
        local kneeR = joint(lowerLegR) or ((hipR + footRPos) * 0.5)

        return {
            headPos = head.Position,
            headR = math.max(head.Size.X, head.Size.Y) / 2,
            neck = neck, chest = chest, hipC = hipC,
            shL = shL, shR = shR,
            elbL = elbL, elbR = elbR,
            handL = handLPos, handR = handRPos,
            hipL = hipL, hipR = hipR,
            kneeL = kneeL, kneeR = kneeR,
            footL = footLPos, footR = footRPos
        }
    end

    local SkeletonGroup = Tabs.Visuals:AddRightGroupbox("Skeleton ESP", "bone")

    SkeletonGroup:AddCheckbox("SkeletonESP", {
        Text = "Skeleton ESP (full bones through walls)",
        Default = false,
        Callback = function(Value)
            skelEnabled = Value
            if Value then
                if not hasDrawing then
                    Library:Notify({Title = "Ethereal", Content = "Skeleton ESP: Drawing API not supported!", Duration = 4})
                    skelEnabled = false
                    if Toggles.SkeletonESP then Toggles.SkeletonESP:SetValue(false) end
                    return
                end
                skelConn = RunService.RenderStepped:Connect(function()
                    local cam = Workspace.CurrentCamera
                    if not cam then return end
                    local vpY = cam.ViewportSize.Y
                    local focal = vpY / (2 * math.tan(math.rad(cam.FieldOfView) / 2))
                    local camPos = cam.CFrame.Position
                    local col = skelColor
                    if skelRainbow then
                        col = Color3.fromHSV((os.clock() * 0.35) % 1, 1, 1)
                    end

                    -- чистим тех, кто больше не нужен
                    for plr in pairs(objPool) do
                        if not (plr.Parent and skelEnabled and wanted(plr)) then
                            clearObjs(plr)
                        end
                    end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if wanted(plr) then
                            local char = plr.Character
                            local hum = char and char:FindFirstChildOfClass("Humanoid")
                            local hrp = char and char:FindFirstChild("HumanoidRootPart")
                            local alive = char and hrp and hum and hum.Health > 0
                            local pool = getObjs(plr)

                            if not alive then
                                hidePoolObjs(pool)
                                restoreBody(plr)
                            else
                                local dist = (camPos - hrp.Position).Magnitude
                                if dist > skelMaxDist then
                                    hidePoolObjs(pool)
                                else
                                    if lastChar[plr] ~= char then
                                        -- новый спавн: старое тело могло остаться скрытым
                                        restoreBody(plr)
                                        lastChar[plr] = char
                                    end
                                    if skelHideBody then
                                        hideBody(plr, char)
                                    end
                                    local rig = getRig(char)
                                    if rig then
                                        -- проекция всех 16 точек
                                        local sH = cam:WorldToViewportPoint(rig.headPos)
                                        local sN = cam:WorldToViewportPoint(rig.neck)
                                        local sCh = cam:WorldToViewportPoint(rig.chest)
                                        local sHip = cam:WorldToViewportPoint(rig.hipC)
                                        local s1 = cam:WorldToViewportPoint(rig.shL)
                                        local sE1 = cam:WorldToViewportPoint(rig.elbL)
                                        local s2 = cam:WorldToViewportPoint(rig.handL)
                                        local s3 = cam:WorldToViewportPoint(rig.shR)
                                        local sE2 = cam:WorldToViewportPoint(rig.elbR)
                                        local s4 = cam:WorldToViewportPoint(rig.handR)
                                        local s5 = cam:WorldToViewportPoint(rig.hipL)
                                        local sK1 = cam:WorldToViewportPoint(rig.kneeL)
                                        local s6 = cam:WorldToViewportPoint(rig.footL)
                                        local s7 = cam:WorldToViewportPoint(rig.hipR)
                                        local sK2 = cam:WorldToViewportPoint(rig.kneeR)
                                        local s8 = cam:WorldToViewportPoint(rig.footR)

                                        local ok = sH.Z > 0 and sN.Z > 0 and sCh.Z > 0 and sHip.Z > 0 and s1.Z > 0 and sE1.Z > 0 and s2.Z > 0 and s3.Z > 0 and sE2.Z > 0 and s4.Z > 0 and s5.Z > 0 and sK1.Z > 0 and s6.Z > 0 and s7.Z > 0 and sK2.Z > 0 and s8.Z > 0
                                        if ok then
                                            local pts = {
                                                { sN, sH },   -- шея -> голова
                                                { sN, sCh },  -- шея -> грудь
                                                { sCh, sHip },-- позвоночник
                                                { s1, s3 },   -- плечевая линия
                                                { s5, s7 },   -- тазовая линия
                                                { s1, sE1 }, { sE1, s2 },  -- левая рука
                                                { s3, sE2 }, { sE2, s4 },  -- правая рука
                                                { s5, sK1 }, { sK1, s6 },  -- левая нога
                                                { s7, sK2 }, { sK2, s8 }   -- правая нога
                                            }
                                            for i, seg in ipairs(pts) do
                                                local ln = pool.lines[i]
                                                ln.From = Vector2.new(seg[1].X, seg[1].Y)
                                                ln.To = Vector2.new(seg[2].X, seg[2].Y)
                                                ln.Color = col
                                                ln.Visible = true
                                            end
                                            local headPx = math.clamp((rig.headR * focal) / sH.Z, 3, 90)
                                            pool.circle.Position = Vector2.new(sH.X, sH.Y)
                                            pool.circle.Radius = headPx
                                            pool.circle.Color = col
                                            pool.circle.Visible = true

                                            if skelShowName then
                                                pool.textName.Text = plr.DisplayName
                                                pool.textName.Position = Vector2.new(sH.X, sH.Y - headPx - 18)
                                                pool.textName.Color = col
                                                pool.textName.Visible = true
                                            else
                                                pool.textName.Visible = false
                                            end
                                            if skelShowDist then
                                                pool.textDist.Text = "[" .. math.floor(dist) .. "]"
                                                pool.textDist.Position = Vector2.new(sH.X, sH.Y + headPx + 8)
                                                pool.textDist.Color = col
                                                pool.textDist.Visible = true
                                            else
                                                pool.textDist.Visible = false
                                            end
                                            if skelShowHP then
                                                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                                local bh = math.clamp(headPx, 20, 70)
                                                local bx = sH.X - headPx - 10
                                                local byTop = sH.Y - bh / 2
                                                pool.hpBG.Position = Vector2.new(bx, byTop)
                                                pool.hpBG.Size = Vector2.new(5, bh)
                                                pool.hpBG.Visible = true
                                                pool.hpFill.Color = Color3.fromHSV(pct * 0.33, 1, 1)
                                                local fh = bh * pct
                                                pool.hpFill.Position = Vector2.new(bx + 1, byTop + (bh - fh))
                                                pool.hpFill.Size = Vector2.new(3, fh)
                                                pool.hpFill.Visible = pct > 0
                                            else
                                                pool.hpBG.Visible = false
                                                pool.hpFill.Visible = false
                                            end
                                        else
                                            hidePoolObjs(pool)
                                        end
                                    else
                                        hidePoolObjs(pool)
                                    end
                                end
                            end
                        end
                    end
                end)
            else
                if skelConn then skelConn:Disconnect() skelConn = nil end
                clearAll()
            end
        end
    })

