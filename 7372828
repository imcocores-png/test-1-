local LineLagGroup = Tabs.Misc:AddLeftGroupbox("Line Lag", "zap")
local lineLagActive = false
local lineLevel = 5
local lineAmount = 500
local lineLagThread = nil

local function updateLineAmount()
    lineAmount = 100 + (lineLevel - 1) * 100
end

LineLagGroup:AddSlider("LineLagLevel", {
    Text = "Line Lag Level (1-10)",
    Min = 1,
    Max = 10,
    Default = 5,
    Rounding = 0,
    Callback = function(v)
        lineLevel = v
        updateLineAmount()
    end
})

LineLagGroup:AddCheckbox("LineLag", {
    Text = "Line Lag",
    Default = false,
    Callback = function(v)
        lineLagActive = v
        if v then
            local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
            local CreateLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
            if not CreateLine then
                Library:Notify({Title = "Ethereal", Content = "CreateGrabLine not found!", Duration = 3})
                return
            end
            lineLagThread = task.spawn(function()
                while lineLagActive do
                    for i = 1, lineAmount do
                        pcall(function()
                            CreateLine:FireServer(Workspace.SpawnLocation, CFrame.new(0, 9e9, 0))
                        end)
                    end
                    task.wait(1)
                end
            end)
            Library:Notify({Title = "Ethereal", Content = "Line Lag enabled (Level " .. lineLevel .. ")", Duration = 2})
        else
            lineLagActive = false
            if lineLagThread then task.cancel(lineLagThread); lineLagThread = nil end
            Library:Notify({Title = "Ethereal", Content = "Line Lag disabled!", Duration = 2})
        end
    end
})

