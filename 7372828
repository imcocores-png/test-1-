-- Gucci Functions
local antiGucciConnection
local safePosition
local restoreFrames = 0

local function spawnBlobman()
    pcall(function()
        ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", CFrame.new(0, 5000000, 0), Vector3.new(0, 60, 0))
    end)
    local folder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys", 5)
    if folder and folder:FindFirstChild("CreatureBlobman") then
        local blob = folder.CreatureBlobman
        if blob:FindFirstChild("Head") then
            blob.Head.CFrame = CFrame.new(0, 50000, 0)
            blob.Head.Anchored = true
        end
        Library:Notify({Title = "Ethereal", Content = "Blobman Spawned!", Duration = 3})
    end
end

local function startAntiGucci()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    safePosition = rootPart.Position
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = folder and folder:FindFirstChild("CreatureBlobman")
    local seat = blob and blob:FindFirstChild("VehicleSeat")
    if not blob then
        spawnBlobman()
        task.wait(0.3)
        folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        blob = folder and folder:FindFirstChild("CreatureBlobman")
        seat = blob and blob:FindFirstChild("VehicleSeat")
    end
    if seat and seat:IsA("VehicleSeat") then
        rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        seat:Sit(humanoid)
    end
    humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        if humanoid.Jump and humanoid.Sit then
            restoreFrames = 15
            safePosition = rootPart.Position
        end
    end)
    if antiGucciConnection then
        antiGucciConnection:Disconnect()
    end
    antiGucciConnection = RunService.Heartbeat:Connect(function()
        if not rootPart or not humanoid then
            return
        end
        ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(rootPart, 0)
        if restoreFrames > 0 then
            rootPart.CFrame = CFrame.new(safePosition)
            restoreFrames = restoreFrames - 1
        end
    end)
    task.spawn(function()
        while humanoid.Sit do
            task.wait(1)
        end
        task.wait(0.5)
        rootPart.CFrame = CFrame.new(safePosition)
    end)
end

local function stopAntiGucci()
    if antiGucciConnection then
        antiGucciConnection:Disconnect()
        antiGucciConnection = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        hum.Sit = false
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    local blobFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if blobFolder and blobFolder:FindFirstChild("CreatureBlobman") then
        local blob = blobFolder.CreatureBlobman
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(blob)
        end)
        task.wait(0.1)
        if blob and blob.Parent then
            blob:Destroy()
        end
    end
end

-- Anti Grab [BEST] v2 (x2: вотчдог, x2 спам Struggle, x2 walk-away 0.9, кто схватил)
do
    local AntiGrab = false
    local AntiGrabProc = false
    local AGWalk = false
    local lastGrabNotify = 0
    local lastHandle = 0
    local Cons = {}

    local function DiscAll()
        for k, v in pairs(Cons) do
            if v then
                v:Disconnect()
            end
        end
        table.clear(Cons)
    end

    -- пока нас таскают - рэгдолл-констрейнты выключены КАЖДЫЙ кадр
    local function disableRagdollConstraints(char)
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("BasePart") and v.Name ~= "Head" then
                local bs = v:FindFirstChild("BallSocketConstraint")
                if bs and bs.Enabled then
                    bs.Enabled = false
                end
                local rlp = v:FindFirstChild("RagdollLimbPart")
                if rlp then
                    local wc = rlp:FindFirstChild("WeldConstraint")
                    if wc and wc.Enabled then
                        wc.Enabled = false
                    end
                end
            end
        end
    end

    local function isGrabbedNow(char)
        if BeingHeld and BeingHeld.Value then
            return true
        end
        if not char then
            return false
        end
        local head = char:FindFirstChild("Head")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        return (head and head:FindFirstChild("PartOwner") ~= nil)
            or (hrp and hrp:FindFirstChild("PartOwner") ~= nil)
    end

    local function handleGrab(char)
        if AntiGrabProc or (os.clock() - lastHandle) < 0.5 then
            return
        end
        if not char or not char.Parent then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not (hum and hrp and head) then
            return
        end
        lastHandle = os.clock()
        AntiGrabProc = true

        -- кто схватил (не чаще 1 раза в 3 сек)
        local po = head:FindFirstChild("PartOwner") or hrp:FindFirstChild("PartOwner")
        if po and (os.clock() - lastGrabNotify) > 3 then
            lastGrabNotify = os.clock()
            local grabber = Players:FindFirstChild(tostring(po.Value))
            local nm = grabber and (grabber.DisplayName .. " (@" .. grabber.Name .. ")") or tostring(po.Value)
            Library:Notify({Title = "Ethereal", Content = "Grabbed by: " .. nm, Duration = 3})
        end

        hum.Sit = false
        StruggleEvent:FireServer(LocalPlayer)
        -- x2 спам: Struggle + анти-рэгдолл + StopAllVelocity каждый кадр
        task.spawn(function()
            while char.Parent and isGrabbedNow(char) do
                pcall(function()
                    StruggleEvent:FireServer(LocalPlayer)
                    ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                    ReplicatedStorage.GameCorrectionEvents.StopAllVelocity:FireServer()
                    hum.Sit = false
                end)
                task.wait()
            end
        end)
        -- непрерывное отключение рэгдолл-констрейнтов, пока держат
        task.spawn(function()
            while char.Parent and AntiGrab and isGrabbedNow(char) do
                disableRagdollConstraints(char)
                task.wait()
            end
        end)
        -- x2 walk-away: 0.9 студов за кадр (было 0.43) + камера как fallback
        hrp.Anchored = true
        if not AGWalk then
            AGWalk = true
            while char.Parent and isGrabbedNow(char) and task.wait() do
                local dir = hum.MoveDirection
                if dir.Magnitude < 0.01 then
                    local cam = Workspace.CurrentCamera
                    dir = cam and cam.CFrame.LookVector or Vector3.zero
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    if dir.Magnitude > 0.01 then
                        dir = dir.Unit
                    end
                end
                hrp.CFrame = hrp.CFrame + dir * 0.9
            end
        end
        hrp.Anchored = false
        hum.Sit = false
        hum.AutoRotate = true
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum.Jump = true
        end)
        AntiGrabProc = false
        AGWalk = false
    end

    local function ApplyAntiGrab(char)
        if not char or not AntiGrab then
            return
        end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        local head = char:WaitForChild("Head", 5)
        if not (hrp and hum and head) then
            return
        end

        disableRagdollConstraints(char)

        Cons["AGHead"] = head.ChildAdded:Connect(function(PartOwner)
            if PartOwner.Name == "PartOwner" then
                handleGrab(char)
            end
        end)
        Cons["AGRoot"] = hrp.ChildAdded:Connect(function(PartOwner)
            if PartOwner.Name == "PartOwner" then
                handleGrab(char)
            end
        end)
        -- вотчдог: PartOwner мог прийти до подписки или без флага IsHeld
        Cons["AGWatch"] = RunService.Heartbeat:Connect(function()
            if char.Parent and isGrabbedNow(char) then
                handleGrab(char)
            end
        end)

        local ragdolled = hum:WaitForChild("Ragdolled", 5)
        if ragdolled then
            Cons["AGRagdoll"] = ragdolled.Changed:Connect(function()
                if hum.Ragdolled.Value then
                    disableRagdollConstraints(char)
                end
            end)
        end

        local weldHRP = hrp:WaitForChild("WeldHRP", 5)
        if weldHRP then
            Cons["AGWeld"] = weldHRP.Changed:Connect(function()
                if hrp.WeldHRP.Enabled then
                    while not hum.Sit do
                        task.wait()
                    end
                    hum.Sit = false
                    hum.AutoRotate = true
                    hum.HipHeight = 1
                    while hrp.WeldHRP.Enabled and task.wait() do
                        head.CFrame = hrp.CFrame + Vector3.new(0, 1.35, 0)
                    end
                    hum.HipHeight = 0
                end
            end)
        end
    end

    DefenseGroup:AddCheckbox("AntiGrabBest", {
        Text = "Anti Grab [BEST] v2",
        Default = false,
        Callback = function(Value)
            AntiGrab = Value
            DiscAll()
            if AntiGrab then
                ApplyAntiGrab(LocalPlayer.Character)
                Cons["AGChar"] = LocalPlayer.CharacterAdded:Connect(ApplyAntiGrab)
            else
                local char = LocalPlayer.Character
                if char then
                    for _, v in pairs(char:GetChildren()) do
                        if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                            v.BallSocketConstraint.Enabled = false
                            if v:FindFirstChild("RagdollLimbPart") then
                                v.RagdollLimbPart.WeldConstraint.Enabled = true
                            end
                        end
                    end
                end
            end
        end
    })
end

-- Anti Grab V2 (x2: страховка PartOwner, CanCollide restore, двойной Struggle, чистый релиз)
do
    local AntiGrabV2Enabled = false
    local v2HoldThread = nil
    local v2PartConn = nil
    local savedCollide = {}
    local isHeld = LocalPlayer:WaitForChild("IsHeld", 10)
    local struggleEventV2 = ReplicatedStorage:WaitForChild("CharacterEvents", 10)
    if struggleEventV2 then
        struggleEventV2 = struggleEventV2:WaitForChild("Struggle", 10)
    end

    local function isGrabbedNow(char)
        if isHeld and isHeld.Value then
            return true
        end
        if not char then
            return false
        end
        local head = char:FindFirstChild("Head")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        return (head and head:FindFirstChild("PartOwner") ~= nil)
            or (hrp and hrp:FindFirstChild("PartOwner") ~= nil)
    end

    local function releaseAll(char)
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
        end
        -- фикс v9: CanCollide возвращался только при выключении тумблера - теперь и при релизе
        for inst, val in pairs(savedCollide) do
            pcall(function()
                inst.CanCollide = val
            end)
        end
        table.clear(savedCollide)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Sit = false
            hum.AutoRotate = true
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end

    local function stopHold()
        if v2HoldThread then
            pcall(function()
                task.cancel(v2HoldThread)
            end)
            v2HoldThread = nil
        end
        releaseAll(LocalPlayer.Character)
    end

    local function startHold()
        if v2HoldThread then
            pcall(function()
                task.cancel(v2HoldThread)
            end)
            v2HoldThread = nil
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and hrp and hum) then
            return
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and savedCollide[part] == nil then
                savedCollide[part] = part.CanCollide
                part.CanCollide = false
            end
        end
        hrp.Anchored = true
        v2HoldThread = task.spawn(function()
            while AntiGrabV2Enabled and char.Parent and isGrabbedNow(char) do
                pcall(function()
                    -- x2 Struggle: обе формы вызова каждый кадр
                    if struggleEventV2 then
                        struggleEventV2:FireServer()
                    end
                    if StruggleEvent then
                        StruggleEvent:FireServer(LocalPlayer)
                    end
                    ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                    ReplicatedStorage.GameCorrectionEvents.StopAllVelocity:FireServer()
                    hum.Sit = false
                    hum.AutoRotate = true
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    hrp.Anchored = true
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait()
            end
            v2HoldThread = nil
            releaseAll(char)
        end)
    end

    isHeld.Changed:Connect(function(heldState)
        if not AntiGrabV2Enabled then
            return
        end
        if heldState then
            startHold()
        else
            stopHold()
        end
    end)

    -- страховка: PartOwner может прийти без флага IsHeld
    local function watchChar(char)
        if v2PartConn then
            v2PartConn:Disconnect()
            v2PartConn = nil
        end
        if not char then
            return
        end
        v2PartConn = char.DescendantAdded:Connect(function(inst)
            if AntiGrabV2Enabled and inst.Name == "PartOwner" and not v2HoldThread and isGrabbedNow(char) then
                startHold()
            end
        end)
    end
    watchChar(LocalPlayer.Character)
    LocalPlayer.CharacterAdded:Connect(function(char)
        table.clear(savedCollide)
        task.wait(0.5)
        watchChar(char)
        if AntiGrabV2Enabled and isGrabbedNow(char) then
            startHold()
        end
    end)

    DefenseGroup:AddCheckbox("AntiGrabV2", {
        Text = "Anti Grab V2",
        Default = false,
        Callback = function(Value)
            AntiGrabV2Enabled = Value
            if Value then
                if isGrabbedNow(LocalPlayer.Character) then
                    startHold()
                end
            else
                stopHold()
            end
        end
    })
end

