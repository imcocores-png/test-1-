--  MISC: Break Plot (from rr9 / XOCU Fixed)                                --
--========================================================================--
pcall(function()
    local gPlot = TabMisc:AddLeftGroupbox("Break Plot", "hammer")

    local PlayerEvents = ReplicatedStorage:FindFirstChild("PlayerEvents")
    local MenuToys     = ReplicatedStorage:FindFirstChild("MenuToys")
    local StickyPartEvent = PlayerEvents and PlayerEvents:FindFirstChild("StickyPartEvent")
    local SpawnToyRF      = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")

    if not (StickyPartEvent and SetNetworkOwner) then
        gPlot:AddLabel("Break Plot not available in this game")
        return
    end

    gPlot:AddLabel("Breaks safe zones (plots) so you can grab players and place items anywhere", true)

    local StatusLabel = gPlot:AddLabel("Status: -")

    local HRP2 = nil
    local function refreshHRP()
        local c = LocalPlayer.Character
        HRP2 = c and c:FindFirstChild("HumanoidRootPart") or nil
        return HRP2
    end
    UI.state.PlotCharConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        refreshHRP()
    end)
    refreshHRP()

    -- broken CFrames used to kill the PlotArea
    local CF_NAN  = CFrame.new(0/0, math.huge, 0/0)
    local CF_BIG  = CFrame.new(1099511627776, 1099511627776, 1099511627776)
    local CF_BIG2 = CFrame.new(1e45, math.huge, 1e98)

    local function getToysFolder()
        return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end

    local function plotIsIntact(plot)
        local pa = plot:FindFirstChild("PlotArea")
        if not (pa and pa:IsA("BasePart")) then return false end
        local p = pa.Position
        if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return false end -- NaN = already broken
        return p.Magnitude < 1e30
    end

    -- reuse ANY sticky toy we own (shuriken / kunai / pencil), from any folder
    local TOY_NAMES = { NinjaShuriken = true, NinjaKunai = true, ToolPencil = true, Noclipped = true }
    local function findUsableToy(exclude)
        local cands = {}
        local inv = getToysFolder()
        if inv then
            for _, o in ipairs(inv:GetChildren()) do table.insert(cands, o) end
        end
        local pi = workspace:FindFirstChild("PlotItems")
        if pi then
            for _, sub in ipairs(pi:GetChildren()) do
                if sub:IsA("Folder") and sub.Name ~= "PlayersInPlots" then
                    for _, o in ipairs(sub:GetChildren()) do table.insert(cands, o) end
                end
            end
        end
        local myHRP = refreshHRP()
        local myPos = myHRP and myHRP.Position or nil
        local best, bestD = nil, math.huge
        for _, o in ipairs(cands) do
            if not (exclude and table.find(exclude, o))
                and TOY_NAMES[o.Name] and o:FindFirstChild("StickyPart") and o.StickyPart:IsA("BasePart") then
                local d = 0
                if myPos then d = (o.StickyPart.Position - myPos).Magnitude end
                if d < bestD then best, bestD = o, d end
            end
        end
        return best
    end

    local function spawnShuriken()
        local myHRP = refreshHRP()
        local inv = getToysFolder()
        if not (myHRP and inv) then return nil end
        local shur = nil
        local conn = inv.ChildAdded:Connect(function(child)
            if child.Name == "NinjaShuriken" and child:FindFirstChild("StickyPart") then
                shur = child
            end
        end)
        pcall(function()
            SpawnToyRF:InvokeServer("NinjaShuriken", myHRP.CFrame * CFrame.new(5, 8, 20), Vector3.zero)
        end)
        local start = tick()
        while not shur and tick() - start < 5 do task.wait(0.05) end -- FIX: was 0.1s -> "not working"
        conn:Disconnect()
        return shur or inv:FindFirstChild("NinjaShuriken")
    end

    local function ensureOwner(soundPart)
        if not soundPart then return false end
        for _ = 1, 10 do
            local po = soundPart:FindFirstChild("PartOwner")
            if po and po.Value == LocalPlayer.Name then return true end
            sno(soundPart)
            task.wait(0.05)
        end
        local po = soundPart:FindFirstChild("PartOwner")
        return (po and po.Value == LocalPlayer.Name) or false
    end

    -- Break one plot: direct PlotArea fling + proven sticky-toy method
    local function breakOnePlot(plot)
        local plotArea = plot:FindFirstChild("PlotArea")
        if not plotArea then return false end

        -- 1) direct: try to fling the PlotArea itself (no toys needed)
        pcall(function() SetNetworkOwner:FireServer(plotArea, CF_BIG) end)
        pcall(function() SetNetworkOwner:FireServer(plotArea, CF_BIG2) end)

        -- 2) sticky method (rr9): stick up to 2 of our toys into the PlotArea
        local toys = {}
        local t1 = findUsableToy() or spawnShuriken()
        if t1 then table.insert(toys, t1) end
        local t2 = findUsableToy(toys)
        if t2 then table.insert(toys, t2) end
        if #toys == 0 then return false end

        local fired = false
        for _, toy in ipairs(toys) do
            if toy and toy.Parent then
                local sticky = toy:FindFirstChild("StickyPart")
                if sticky then
                    ensureOwner(toy:FindFirstChild("SoundPart"))
                    sticky.CanTouch = false
                    pcall(function() destroyGrabLine(toy:FindFirstChildOfClass("BasePart")) end)
                    pcall(function() StickyPartEvent:FireServer(sticky, plotArea, CF_NAN) end)
                    pcall(function() StickyPartEvent:FireServer(sticky, plotArea, CF_BIG) end)
                    pcall(function() StickyPartEvent:FireServer(sticky, plotArea, CF_BIG2) end)
                    fired = true
                end
            end
        end
        return fired
    end

    local function forEachPlot(fn)
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return 0 end
        local n = 0
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model") then
                n = n + 1
                fn(plot)
            end
        end
        return n
    end

    UI.state.BreakPlotOn = false
    gPlot:AddToggle("BreakPlotToggle", {
        Text = "Break Safe Zones (auto)",
        Default = false,
        Callback = function(v)
            UI.state.BreakPlotOn = v
            if not v then
                UI.notify("Break Plot: OFF")
                return
            end
            UI.notify("Break Plot: ON - breaking safe zones...")
            task.spawn(function()
                local warned = false
                while UI.state.BreakPlotOn and UI.Alive do
                    local brokeAny, needToy = false, false
                    local total, intact = 0, 0
                    forEachPlot(function(plot)
                        if not (UI.state.BreakPlotOn and UI.Alive) then return end
                        total = total + 1
                        if plotIsIntact(plot) then
                            intact = intact + 1
                            if breakOnePlot(plot) then
                                brokeAny = true
                            else
                                needToy = true
                            end
                            task.wait(0.25)
                        end
                    end)
                    pcall(function()
                        StatusLabel:SetText("Status: " .. (total - intact) .. "/" .. total .. " plots broken")
                    end)
                    -- client-side assist: clear safe-zone list locally (helps vs client checks)
                    pcall(function()
                        local pip = workspace:FindFirstChild("PlotItems")
                            and workspace.PlotItems:FindFirstChild("PlayersInPlots")
                        if pip then
                            for _, e in ipairs(pip:GetChildren()) do e:Destroy() end
                        end
                    end)
                    if brokeAny then
                        UI.notify("Break Plot: safe zones broken!")
                        warned = false
                    elseif needToy and not warned then
                        warned = true
                        UI.notify("Break Plot: no toy to break with - step out of the plot once")
                    end
                    for _ = 1, 25 do
                        if not (UI.state.BreakPlotOn and UI.Alive) then break end
                        task.wait(0.2) -- re-check every ~5s, reacts to OFF fast
                    end
                end
            end)
        end,
    })

    gPlot:AddButton({ Text = "Break All Plots Now", Func = function()
        task.spawn(function()
            local n, ok = 0, 0
            forEachPlot(function(plot)
                n = n + 1
                if breakOnePlot(plot) then ok = ok + 1 end
                task.wait(0.25)
            end)
            if n == 0 then
                UI.notify("Break Plot: no plots found!")
            elseif ok > 0 then
                UI.notify("Break Plot: " .. ok .. "/" .. n .. " plots hit!")
            else
                UI.notify("Break Plot: no toy - step out of the plot once")
            end
        end)
    end })

    local gMiscInfo = TabMisc:AddRightGroupbox("Info")
    gMiscInfo:AddLabel("Break Safe Zones (auto) - keeps all plots broken while ON", true)
    gMiscInfo:AddLabel("While ON: grabbing players and placing items works everywhere", true)
    gMiscInfo:AddLabel("Break All Plots Now - one-shot break", true)
    gMiscInfo:AddLabel("If nothing happens: step out of the plot once so a toy can spawn", true)
end)

