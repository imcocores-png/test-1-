--========================================================================--
--  AUTO-RAGDOLL PALLET (NoName-style, built into kick)                    --
--                                                                          --
--  No button needed. When DoRagdoll=true, kick auto-spawns ONE pallet     --
--  (PalletLightBrown), claims network ownership (sno), adds               --
--  BodyVelocity(0, 900, 0) on SoundPart (NoName logic), then every frame  --
--  teleports pallet SoundPart to victim's HRP to trigger ragdoll.         --
--  When kick ends, pallet is destroyed automatically.                     --
--========================================================================--
local KickPallet = {
    model     = nil,
    soundPart = nil,
    bv        = nil,  -- BodyVelocity
    spawnTime = 0,    -- when pallet was spawned (for respawn timer)
}

local function getToysFolder()
    return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local function findMenuToysRemotes()
    local MenuToys = ReplicatedStorage:FindFirstChild("MenuToys")
    if not MenuToys then return nil, nil end
    local SpawnToyRF = MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    local DestroyToyEvent = MenuToys:FindFirstChild("DestroyToyEvent")
        or MenuToys:FindFirstChild("DestroyToy")
    return SpawnToyRF, DestroyToyEvent
end

local function spawnKickPallet()
    -- If we already have one, return it
    if KickPallet.model and KickPallet.model.Parent and KickPallet.soundPart and KickPallet.soundPart.Parent then
        return KickPallet.model, KickPallet.soundPart
    end

    local SpawnToyRF, DestroyToyEvent = findMenuToysRemotes()
    if not (SpawnToyRF and DestroyToyEvent) then return nil, nil end
    if not (SetNetworkOwner and DestroyGrabRemote) then return nil, nil end

    -- Spawn pallet above my head
    local myChar = getChar()
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, nil end

    local ok = pcall(function()
        SpawnToyRF:InvokeServer(
            "PalletLightBrown",
            myHRP.CFrame * CFrame.new(0, 10, 0),
            Vector3.zero
        )
    end)
    if not ok then return nil, nil end

    -- Wait for it to appear
    local f = getToysFolder()
    if not f then return nil, nil end
    local pallet = f:WaitForChild("PalletLightBrown", 5)
    if not pallet then return nil, nil end

    local soundPart = pallet:WaitForChild("SoundPart", 5)
    if not soundPart then
        pcall(function() DestroyToyEvent:FireServer(pallet) end)
        return nil, nil
    end

    -- Claim network ownership (sno + destroy grab line, same trick as kick)
    local t0 = tick()
    while not soundPart:FindFirstChild("PartOwner") and tick() - t0 < 3 do
        pcall(function()
            SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
            DestroyGrabRemote:FireServer(soundPart)
        end)
        task.wait(0.05)
    end

    -- CRITICAL FIX: make pallet non-collidable + semi-transparent (NoName logic).
    -- CanCollide=false: passes through victim, no fling impulse.
    -- Transparency=0.8: visible but doesn't block view (NoName line 3318).
    for _, v in pairs(pallet:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.CanQuery = false
            v.Transparency = 0.8
        end
    end

    -- NO Anchored. Use BodyVelocity(0, 900, 0) — NoName logic.
    -- Pallet spawns above victim, BodyVelocity lifts it up through victim
    -- (CanCollide=false so it passes through) -> triggers ragdoll via Touch.
    -- We do NOT teleport pallet every frame (that's what was flinging victim).
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(0, math.huge, 0)
    bv.Velocity = Vector3.new(0, Kick.RagdollVelocity, 0)
    bv.Parent = soundPart

    pallet.Name = "RagdollPalete"
    KickPallet.model = pallet
    KickPallet.soundPart = soundPart
    KickPallet.bv = bv

    return pallet, soundPart
end

local function destroyKickPallet()
    local _, DestroyToyEvent = findMenuToysRemotes()
    if not DestroyToyEvent then
        KickPallet.model = nil
        KickPallet.soundPart = nil
        KickPallet.bv = nil
        return
    end
    if KickPallet.model and KickPallet.model.Parent then
        pcall(function() DestroyToyEvent:FireServer(KickPallet.model) end)
    end
    -- Cleanup any leftover pallets in toys folder
    local f = getToysFolder()
    if f then
        for _, child in ipairs(f:GetChildren()) do
            if child.Name == "PalletLightBrown" or child.Name == "RagdollPalete" then
                pcall(function() DestroyToyEvent:FireServer(child) end)
            end
        end
    end
    KickPallet.model = nil
    KickPallet.soundPart = nil
    KickPallet.bv = nil
end

-- Called every frame from kick loop: ensure pallet exists, position it ABOVE victim.
-- BodyVelocity(0, 900, 0) lifts pallet up -> passes THROUGH victim (CanCollide=false)
-- -> triggers ragdoll via Touch event. We do NOT teleport pallet INTO victim
-- (that's what was flinging victim). If victim is not ragdolled in 2 sec, respawn.
local function kickPalletTick(tHRP, tHum)
    if not Kick.DoRagdoll then return end
    if not (tHRP and tHum and tHRP.Parent and tHum.Parent) then return end
    if tHum.Health <= 0 then return end

    -- Check if victim is ragdolled
    local ragVal = tHum:FindFirstChild("Ragdolled")
    local isRagdolled = ragVal and ragVal.Value or false

    -- If victim ragdolled -> destroy pallet (we're done, kick will handle the rest)
    if isRagdolled then
        if KickPallet.model and KickPallet.model.Parent then
            -- Move pallet far away first (so destroy doesn't interfere with kick)
            pcall(function()
                if KickPallet.soundPart and KickPallet.soundPart.Parent then
                    KickPallet.soundPart.CFrame = CFrame.new(0, 1e7, 0)
                end
            end)
            destroyKickPallet()
        end
        return
    end

    -- Need pallet: spawn if missing or expired (2 sec lifetime -> respawn for new impulse)
    local needRespawn = false
    if not (KickPallet.model and KickPallet.model.Parent and KickPallet.soundPart and KickPallet.soundPart.Parent) then
        needRespawn = true
    elseif tick() - KickPallet.spawnTime > 2.0 then
        -- Pallet has been lifting for 2 sec without ragdoll -> destroy + respawn
        destroyKickPallet()
        needRespawn = true
    end

    if needRespawn then
        -- Spawn pallet ABOVE victim (BodyVelocity will lift it through victim)
        local myChar = getChar()
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        -- Get remotes
        local SpawnToyRF, DestroyToyEvent = findMenuToysRemotes()
        if not SpawnToyRF then return end

        pcall(function()
            SpawnToyRF:InvokeServer(
                "PalletLightBrown",
                CFrame.new(tHRP.Position + Vector3.new(0, 3, 0)),
                Vector3.zero
            )
        end)

        -- Wait for it to appear
        task.spawn(function()
            local f = getToysFolder()
            if not f then return end
            local pallet = f:WaitForChild("PalletLightBrown", 3)
            if not pallet then return end
            local soundPart = pallet:WaitForChild("SoundPart", 3)
            if not soundPart then
                pcall(function() DestroyToyEvent:FireServer(pallet) end)
                return
            end

            -- Claim network ownership
            local t0 = tick()
            while not soundPart:FindFirstChild("PartOwner") and tick() - t0 < 2 do
                pcall(function()
                    SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
                    DestroyGrabRemote:FireServer(soundPart)
                end)
                task.wait(0.03)
            end

            -- Make non-collidable + semi-transparent
            for _, v in pairs(pallet:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.CanQuery = false
                    v.Transparency = 0.8
                end
            end

            -- BodyVelocity(0, 900, 0) — NoName logic
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.new(0, Kick.RagdollVelocity, 0)
            bv.Parent = soundPart

            pallet.Name = "RagdollPalete"
            KickPallet.model = pallet
            KickPallet.soundPart = soundPart
            KickPallet.bv = bv
            KickPallet.spawnTime = tick()
        end)
    end
end

local function runAccelerating(name, isActive, stopAt)
    local myChar = getChar()
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and myHRP) then return end
    local savedPos = myHRP.CFrame

    local grabbed = false
    local lastConfirmed = 0
    local regrabUntil = 0
    local frameCount = 0
    -- FAST SPAM accumulators: exactly SnoRate/DestroyRate per sec regardless of fps.
    local snoAccum = 0
    local destroyAccum = 0
    local lastSpamTime = os.clock()

    while isActive() and RunService.Heartbeat:Wait() do
        frameCount += 1

        local target = Players:FindFirstChild(name)
        if not target or not target.Parent then break end

        myChar = getChar()
        myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHead = myChar and myChar:FindFirstChild("Head")

        local tChar = target.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

        if not (myChar and myHRP and myHead) or not (tHRP and tHum) or tHum.Health <= 0 then
            continue
        end

        local dist = (tHRP.Position - myHRP.Position).Magnitude

        if dist <= 30 then
            ensureKickAlign(tHRP)

            -- Compute hold position with X/Y/Z offsets (relative to myHead facing)
            local holdPos = myHead.Position
                + myHRP.CFrame.RightVector * Kick.HoldX
                + Vector3.new(0, Kick.HoldY, 0)
                + myHRP.CFrame.LookVector * Kick.HoldZ

            -- AlignPosition target (kept)
            local align = tHRP:FindFirstChild("KickAlign")
            if align and align.Attachment1 then
                align.Attachment1.WorldPosition = holdPos
            end
            local rot = tHRP:FindFirstChild("KickRot")
            if rot then
                rot.CFrame = CFrame.Angles(0, 0, 0)
            end

            -- BodyPosition target (added — pro lock)
            local bodyPos = tHRP:FindFirstChild("KickBodyPos")
            if bodyPos then
                bodyPos.Position = holdPos
            end
            -- BodyGyro target (added — pro lock, face same direction as me)
            local bodyGyro = tHRP:FindFirstChild("KickBodyGyro")
            if bodyGyro then
                bodyGyro.CFrame = CFrame.Angles(0, 0, 0)
            end

            -- Variant E: full humanoid lockdown so victim cannot walk/jump/escape
            tHum.PlatformStand = true
            pcall(function() tHum.WalkSpeed = 0 end)
            pcall(function() tHum.JumpPower = 0 end)
            pcall(function() tHum.UseJumpPower = true end)
            -- CRITICAL FIX: ChangeState(Physics) actually disables walking on
            -- the humanoid itself (server cannot override it like WalkSpeed).
            -- WalkSpeed=0 alone gets overwritten by server every frame.
            pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Physics) end)
            -- Zero out velocity so victim does not drift
            pcall(function()
                tHRP.AssemblyLinearVelocity = Vector3.zero
                tHRP.AssemblyAngularVelocity = Vector3.zero
            end)

            local confirmed = CheckForPartOwner(tHRP)
                or (target:FindFirstChild("IsHeld") and target.IsHeld.Value)

            -- AUTO-RAGDOLL PALLET: teleport pallet to victim every frame (NoName-style)
            kickPalletTick(tHRP, tHum)

            if not grabbed then
                -- Р–Р”РЃРњ Р—РђРҐР’РђРў: СЃРЅРѕ РєР°Р¶РґС‹Р№ РєР°РґСЂ
                sno(tHRP)
                if confirmed then
                    grabbed = true
                    lastConfirmed = tick()
                    regrabUntil = tick() + Kick.Warmup
                end
            else
                if confirmed then
                    lastConfirmed = tick()
                end

                if tick() - lastConfirmed > Kick.LostGrace then
                    -- РіСЂР°Р± СЂРµР°Р»СЊРЅРѕ РѕС‚РѕСЂРІР°Р»СЃСЏ -> РїРµСЂРµРіСЂР°Р± (С‚РѕР»СЊРєРѕ СЃРЅРѕ)
                    grabbed = false
                    sno(tHRP)
                elseif tick() < regrabUntil then
                    -- warmup / regrab: С‚РѕР»СЊРєРѕ СЃРЅРѕ
                    sno(tHRP)
                else
                    -- 1 РћР’РќР•Р  / 1 Р”Р•РЎРўР РћР™: РґРµСЃС‚СЂРѕР№ РєР°Р¶РґС‹Рµ N РєР°РґСЂРѕРІ, РєР°РґСЂ Р‘Р•Р— СЃРЅРѕ
                    -- FAST SPAM accumulator: exactly SnoRate/DestroyRate per sec.
                    -- ANTI-THROTTLE: max MaxCallsPerFrame per remote per frame
                    -- (prevents burst when accumulator overflows from lag spikes)
                    local now = os.clock()
                    local dt = now - lastSpamTime
                    lastSpamTime = now

                    if frameCount % Kick.DestroyEvery == 0 then
                        -- DESTROY frame: spam destroy
                        destroyAccum += dt * Kick.DestroyRate
                        local n = math.floor(destroyAccum)
                        -- ANTI-THROTTLE: cap per frame
                        if n > Kick.MaxCallsPerFrame then
                            n = Kick.MaxCallsPerFrame
                        end
                        destroyAccum -= n
                        for _ = 1, n do
                            pcall(function()
                                DestroyGrabRemote:FireServer(tHRP)
                            end)
                        end
                        if not Kick.SkipSnoOnDestroy then
                            snoAccum += dt * Kick.SnoRate
                            local m = math.floor(snoAccum)
                            if m > Kick.MaxCallsPerFrame then
                                m = Kick.MaxCallsPerFrame
                            end
                            snoAccum -= m
                            for _ = 1, m do
                                sno(tHRP)
                            end
                        end
                    else
                        -- OWNER frame: spam sno
                        snoAccum += dt * Kick.SnoRate
                        local m = math.floor(snoAccum)
                        if m > Kick.MaxCallsPerFrame then
                            m = Kick.MaxCallsPerFrame
                        end
                        snoAccum -= m
                        for _ = 1, m do
                            sno(tHRP)
                        end
                    end
                end
            end
        else
            -- FETCH: tp Рє Р¶РµСЂС‚РІРµ -> СЃРїР°Рј СЃРЅРѕ -> tp РѕР±РѕРёС…: СЏ РґРѕРјРѕР№, Р¶РµСЂС‚РІР° РЅР°РґРѕ РјРЅРѕР№
            local fetchStart = tick()
            pcall(function()
                myChar:PivotTo(tHRP.CFrame * CFrame.new(0, 2, 4))
            end)
            ensureKickAlign(tHRP)

            while isActive() and tick() - fetchStart < Kick.FetchTime do
                task.wait(0.05)
                sno(tHRP)

                myChar = getChar()
                local mh = myChar and myChar:FindFirstChild("Head")
                local al = tHRP:FindFirstChild("KickAlign")
                if al and al.Attachment1 and mh then
                    al.Attachment1.WorldPosition = mh.Position + Vector3.new(0, Kick.HoldHeight, 0)
                end
            end

            pcall(function()
                myChar:PivotTo(savedPos)
                tHRP.CFrame = savedPos * CFrame.new(0, Kick.HoldHeight, 0)

                myChar = getChar()
                local mh = myChar and myChar:FindFirstChild("Head")
                local al = tHRP:FindFirstChild("KickAlign")
                if al and al.Attachment1 and mh then
                    al.Attachment1.WorldPosition = mh.Position + Vector3.new(0, Kick.HoldHeight, 0)
                end
            end)

            grabbed = false
        end

        if stopAt and os.clock() >= stopAt then break end
    end

    -- CLEANUP
    -- Destroy auto-ragdoll pallet (NoName-style)
    destroyKickPallet()

    local target = Players:FindFirstChild(name)
    if target and target.Character then
        local tH = target.Character:FindFirstChild("HumanoidRootPart")
        if tH then
            local align = tH:FindFirstChild("KickAlign")
            local rot = tH:FindFirstChild("KickRot")
            local att0 = tH:FindFirstChild("KickAtt0")
            local att1 = tH:FindFirstChild("KickAtt1")
            local bodyPos = tH:FindFirstChild("KickBodyPos")
            local bodyGyro = tH:FindFirstChild("KickBodyGyro")
            if align then
                if align.Attachment1 then align.Attachment1:Destroy() end
                align:Destroy()
            end
            if rot then rot:Destroy() end
            if att0 then att0:Destroy() end
            if att1 then att1:Destroy() end
            if bodyPos then bodyPos:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            local th = target.Character:FindFirstChildOfClass("Humanoid")
            if th then
                th.PlatformStand = false
                pcall(function() th.WalkSpeed = 16 end)
                pcall(function() th.JumpPower = 50 end)
            end
            pcall(function()
                DestroyGrabRemote:FireServer(tH)
            end)
        end
    end
    pcall(function()
        local c = getChar()
        if c then c:PivotTo(savedPos) end
    end)
end

--========================================================================--
--  KICK V2 = LOOPGRAB V2 (NN Hub blink вЂ” РјРµРґР»РµРЅРЅС‹Р№ РЅРѕ Р¶РµР»РµР·РЅС‹Р№)            --
--========================================================================--
local function runLoopGrabV2(name, isActive, stopAt)
    local etc = {}
    local char = getChar()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hrp) then return end

    local BodyPos = nil
    local oldCF = nil

    local ok, err = pcall(function()
        while isActive() and RunService.RenderStepped:Wait() do
            etc.TargetPLR = Players:FindFirstChild(name)
            if not etc.TargetPLR then continue end

            char = getChar()
            hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hrp) then continue end

            local tChar = etc.TargetPLR.Character
            etc.Head = tChar and tChar:FindFirstChild("Head")
            etc.Root = tChar and tChar:FindFirstChild("HumanoidRootPart")
            etc.Hum = tChar and tChar:FindFirstChild("Humanoid")
            BodyPos = etc.Root and etc.Root:FindFirstChild("KickV2BodyPos")

            if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health ~= 0)
                and (hrp.Position - etc.Root.Position).Magnitude <= 30 then

                -- Compute hold position with X/Y/Z offsets (relative to my facing)
                local holdPos = hrp.Position
                    + hrp.CFrame.RightVector * Kick.HoldX
                    + Vector3.new(0, Kick.HoldY, 0)
                    + hrp.CFrame.LookVector * Kick.HoldZ

                -- BodyPosition only (no BodyGyro — kept simple like original V2)
                if not BodyPos then
                    BodyPos = Instance.new("BodyPosition")
                    BodyPos.Name = "KickV2BodyPos"
                    BodyPos.MaxForce = Vector3.new(Huge())
                    BodyPos.Parent = etc.Root
                    BodyPos.P = 75000
                    BodyPos.D = 12000
                    BodyPos.Position = holdPos
                end
                BodyPos.Position = holdPos

                -- Humanoid lockdown (Variant E: victim cannot walk/jump)
                etc.Hum.PlatformStand = true
                pcall(function() etc.Hum.WalkSpeed = 0 end)
                pcall(function() etc.Hum.JumpPower = 0 end)
                pcall(function() etc.Hum.UseJumpPower = true end)
                pcall(function() etc.Hum:ChangeState(Enum.HumanoidStateType.Physics) end)

                etc.Root.AssemblyAngularVelocity = Vector3.zero
                etc.Root.AssemblyLinearVelocity = Vector3.zero

                sno(etc.Root)
                RunService.RenderStepped:Wait()
                sno(etc.Root)
                pcall(function() DestroyGrabRemote:FireServer(etc.Root) end)
                RunService.RenderStepped:Wait()
                sno(etc.Root)
                RunService.RenderStepped:Wait()
                pcall(function() DestroyGrabRemote:FireServer(etc.Root) end)
            else
                if not etc.Head or not etc.Hum or etc.Hum.Health == 0 then
                    local plr = etc.TargetPLR
                    local respawned = false
                    local conn
                    pcall(function()
                        conn = plr.CharacterAdded:Connect(function() respawned = true end)
                    end)
                    local t0 = os.clock()
                    while isActive() and plr.Parent and not respawned
                        and not (plr.Character and plr.Character:FindFirstChild("Head"))
                        and os.clock() - t0 < 10 do
                        task.wait(0.1)
                    end
                    if conn then pcall(function() conn:Disconnect() end) end

                    etc.Head = FWD(plr.Character, "Head", 5)
                    etc.Hum = FWD(plr.Character, "Humanoid", 5)
                    etc.Root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if etc.Root then
                        BodyPos = Instance.new("BodyPosition")
                        BodyPos.Name = "KickV2BodyPos"
                        BodyPos.MaxForce = Vector3.new(Huge())
                        BodyPos.Parent = etc.Root
                        BodyPos.P = 75000
                        BodyPos.D = 12000
                        BodyPos.Position = hrp.Position + Vector3.new(0, Kick.HoldY, 0)
                    end
                end

                oldCF = hrp.CFrame
                while (etc.Head and etc.Head.Parent and etc.Hum and etc.Hum.Health ~= 0)
                    and task.wait(0.01) and isActive() do
                    etc.TargetPLR = Players:FindFirstChild(name)
                    if not etc.TargetPLR then break end
                    local inPlot = etc.TargetPLR:FindFirstChild("InPlot")
                    if inPlot and inPlot.Value then continue end

                    local tc = etc.TargetPLR.Character
                    etc.Head = tc and tc:FindFirstChild("Head")
                    etc.Hum = tc and tc:FindFirstChild("Humanoid")
                    if not etc.Head or not etc.Hum then break end

                    char = getChar()
                    hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not (char and hrp) then break end

                    char:PivotTo(etc.Head.CFrame * CFrame.new(0, 10, 0))
                    sno(etc.Head)

                    if CheckForPartOwner(etc.Head) then break end
                end

                if hrp and hrp.Parent and oldCF then
                    hrp.CFrame = oldCF
                end

                if etc.Head and etc.Head.Parent and CheckForPartOwner(etc.Head)
                    and etc.TargetPLR and etc.TargetPLR.Character
                    and hrp and hrp.Parent then
                    for _, v in pairs(etc.TargetPLR.Character:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)
                        end
                    end
                end
            end

            if stopAt and os.clock() >= stopAt then break end
        end

        if etc.Root then
            for _, v in pairs(etc.Root:GetChildren()) do
                if v.Name == "BodyPosition" or v.Name == "KickV2BodyPos" then
                    v:Destroy()
                end
            end
            -- Restore victim humanoid
            if etc.Hum then
                pcall(function() etc.Hum.PlatformStand = false end)
                pcall(function() etc.Hum.WalkSpeed = 16 end)
                pcall(function() etc.Hum.JumpPower = 50 end)
            end
        end
    end)

    local target = Players:FindFirstChild(name)
    local tRoot = (target and target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")) or etc.Root
    if tRoot then
        for _, v in pairs(tRoot:GetChildren()) do
            if v.Name == "BodyPosition" or v.Name == "KickV2BodyPos" then v:Destroy() end
        end
    end
    if not ok then warn("[Ethereal Kick V2] " .. tostring(err)) end
end

