--========================================================================--
--  PALLET RAGDOLL (Target -> Right side, 1 visible pallet, XOCU logic)    --
--                                                                          --
--  Logic from XOCU "Pallet Ragdoll (Invis)" but pallet stays VISIBLE.      --
--  KEY DIFFERENCE: only ONE pallet at a time.                              --
--  - ChildAdded listener catches new pallets                               --
--  - SetNetworkOwner + DestroyGrabLine to claim network                    --
--  - RunService.Stepped: alternating strikes (down 9e5 / up 9e5)           --
--  - When victim ragdolled: pallet flies to (0, 9e9, 0)                    --
--  - AncestryChanged: auto-spawn ONE new pallet when destroyed             --
--  - Guard: only spawn if zero pallets exist (no accumulation)             --
--========================================================================--
pcall(function()
    local gPallet = TabTarget:AddRightGroupbox("Pallet Ragdoll", "box")

    -- Find remotes
    local MenuToys = ReplicatedStorage:WaitForChild("MenuToys")
    local SpawnToyRF = MenuToys:WaitForChild("SpawnToyRemoteFunction")
    local DestroyToyEvent = MenuToys:FindFirstChild("DestroyToyEvent")
        or MenuToys:FindFirstChild("DestroyToy")

    if not (SpawnToyRF and DestroyToyEvent and SetNetworkOwner and DestroyGrabRemote) then
        gPallet:AddLabel("Pallet not available in this game", true)
        return
    end

    gPallet:AddLabel("Spawns ONE visible pallet that alternating-strikes target every frame. Auto-respawns when destroyed. Infinite range.", true)

    -- State
    UI.state.palletRagdollActive = false
    UI.state.PalletForRagdoll   = nil
    UI.state.palletCacheConn    = nil
    UI.state.ragdollSteppedConn = nil
    UI.state.spawnNewPallet     = nil

    local lpName = LocalPlayer.Name
    local toysFolder = workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys", 10)

    local function clearAttackLoop()
        if UI.state.ragdollSteppedConn then
            pcall(function() UI.state.ragdollSteppedConn:Disconnect() end)
            UI.state.ragdollSteppedConn = nil
        end
    end
    UI.state.clearAttackLoop = clearAttackLoop

    -- Cleanup ALL pallets in the toys folder (anti-accumulation guard)
    local function cleanupAllPallets()
        local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not f then return end
        for _, child in ipairs(f:GetChildren()) do
            if child.Name == "PalletLightBrown" or child.Name == "PalletForRagdoll" then
                pcall(function() DestroyToyEvent:FireServer(child) end)
            end
        end
    end

    -- Count existing pallets (we only want 1)
    local function countPallets()
        local n = 0
        local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not f then return 0 end
        for _, child in ipairs(f:GetChildren()) do
            if child.Name == "PalletLightBrown" or child.Name == "PalletForRagdoll" then
                n = n + 1
            end
        end
        return n
    end

    -- ChildAdded listener: catches new pallets, claims ownership, starts attack loop
    UI.state.palletCacheConn = toysFolder.ChildAdded:Connect(function(child)
        if not UI.state.palletRagdollActive then return end
        if child.Name ~= "PalletLightBrown" and child.Name ~= "PalletForRagdoll" then return end

        local soundPart = child:WaitForChild("SoundPart", 3)
        if not soundPart then return end

        -- Claim network ownership instantly
        pcall(function()
            SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
            DestroyGrabRemote:FireServer(soundPart)
        end)

        local partOwner = soundPart:WaitForChild("PartOwner", 1)
        if partOwner and partOwner.Value == lpName then
            -- NOTE: XOCU makes pallet invisible here. We KEEP IT VISIBLE.

            child.Name = "PalletForRagdoll"
            UI.state.PalletForRagdoll = child

            local strikePhase = false

            -- Engine-Synced Attack Loop (Stepped runs right before physics simulation)
            UI.state.ragdollSteppedConn = RunService.Stepped:Connect(function()
                if not UI.state.palletRagdollActive or not child.Parent then
                    clearAttackLoop()
                    return
                end

                -- Get target from State.SelectedName (our target selector)
                local tChar = nil
                local selName = State.SelectedName
                if selName then
                    local plr = Players:FindFirstChild(selName)
                    tChar = plr and plr.Character
                end
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                if tRoot and tHum and soundPart.Parent and tHum.Health > 0 then
                    local ragdolledVal = tHum:FindFirstChild("Ragdolled")
                    local isRagdolled = ragdolledVal and ragdolledVal.Value or false

                    if not isRagdolled then
                        -- Alternating hyper-velocity strikes every single frame
                        -- Phase 1: pallet goes DOWN onto victim (from above)
                        -- Phase 2: pallet comes back UP from below victim
                        -- Each phase the pallet "flies away" and "comes back" through the victim
                        strikePhase = not strikePhase
                        if strikePhase then
                            -- strike from above, going DOWN -> pallet "returns" to victim from sky
                            soundPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, 0)
                            soundPart.AssemblyLinearVelocity = Vector3.new(0, -9e5, 0)
                        else
                            -- strike from below, going UP -> pallet "flies away" upward through victim
                            soundPart.CFrame = tRoot.CFrame * CFrame.new(0, -1, 0)
                            soundPart.AssemblyLinearVelocity = Vector3.new(0, 9e5, 0)
                        end
                    else
                        -- Instantly pull away to reduce lag once ragdolled
                        soundPart.CFrame = CFrame.new(0, 9e9, 0)
                        soundPart.AssemblyLinearVelocity = Vector3.zero
                    end
                else
                    soundPart.CFrame = CFrame.new(0, 9e9, 0)
                    soundPart.AssemblyLinearVelocity = Vector3.zero
                end
            end)

            -- Handle respawn/destruction: auto-spawn new pallet when this one is removed
            child.AncestryChanged:Connect(function()
                if not child.Parent then
                    clearAttackLoop()
                    UI.state.PalletForRagdoll = nil
                    if UI.state.palletRagdollActive then
                        task.wait(0.03)
                        if UI.state.spawnNewPallet then UI.state.spawnNewPallet() end
                    end
                end
            end)
        else
            -- Not our pallet -> destroy it (so we keep only 1)
            pcall(function() DestroyToyEvent:FireServer(child) end)
        end
    end)

    -- Toy Spawner Function: only spawns if NO pallet exists (max 1 at a time)
    UI.state.spawnNewPallet = function()
        if not UI.state.palletRagdollActive then return end
        -- GUARD: do not spawn if pallet already exists
        if UI.state.PalletForRagdoll and UI.state.PalletForRagdoll.Parent then return end
        if countPallets() > 0 then
            -- There's a pallet we don't own -> clean it up first
            cleanupAllPallets()
            task.wait(0.05)
        end

        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end

        task.spawn(function()
            pcall(function()
                SpawnToyRF:InvokeServer(
                    "PalletLightBrown",
                    h.CFrame * CFrame.new(0, 10, 20),
                    Vector3.zero
                )
            end)
        end)
    end

    -- UI: Toggle
    gPallet:AddToggle("PalletRagdoll", {
        Text = "Pallet Ragdoll",
        Default = false,
        Tooltip = "Spawns ONE visible pallet that alternating-strikes target every frame. Auto-respawns when destroyed. Infinite range.",
        Callback = function(v)
            UI.state.palletRagdollActive = v
            if v then
                UI.state.PalletForRagdoll = nil
                clearAttackLoop()
                if UI.state.spawnNewPallet then UI.state.spawnNewPallet() end
                UI.notify("Pallet Ragdoll: ON")
            else
                clearAttackLoop()
                local pallet = UI.state.PalletForRagdoll
                if pallet and pallet.Parent then
                    pcall(function() DestroyToyEvent:FireServer(pallet) end)
                end
                UI.state.PalletForRagdoll = nil
                cleanupAllPallets()
                UI.notify("Pallet Ragdoll: OFF")
            end
        end,
    })

    -- Button: manual cleanup
    gPallet:AddButton({ Text = "Cleanup All Pallets", Func = function()
        cleanupAllPallets()
        UI.state.PalletForRagdoll = nil
        UI.notify("All pallets removed")
    end })

    -- Expose cleanup for unload
    UI.state.PalletCleanup = function()
        UI.state.palletRagdollActive = false
        clearAttackLoop()
        if UI.state.palletCacheConn then
            pcall(function() UI.state.palletCacheConn:Disconnect() end)
            UI.state.palletCacheConn = nil
        end
        local pallet = UI.state.PalletForRagdoll
        if pallet and pallet.Parent then
            pcall(function() DestroyToyEvent:FireServer(pallet) end)
        end
        UI.state.PalletForRagdoll = nil
        cleanupAllPallets()
    end
end)

