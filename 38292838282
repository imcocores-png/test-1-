--========================================================================--
--  STYLE: cartoon bold text + BIG icons (retries) + bottom bars on window  --
--========================================================================--
local SEARCH_RIGHT_OFFSET = 40
local SEARCH_WIDTH        = 170
local ICON_SIZE           = 28

local function findGuiRoot()
    if UI.GuiRoot and UI.GuiRoot.Parent then return UI.GuiRoot end

    local el = UI.SliderElement
    if el and el.Parent then
        local ok, gui = pcall(function() return el:FindFirstAncestorOfClass("ScreenGui") end)
        if ok and gui then UI.GuiRoot = gui return gui end
    end

    local roots = {}
    pcall(function() roots[#roots + 1] = gethui() end)
    pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
    pcall(function() roots[#roots + 1] = LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
    for _, root in ipairs(roots) do
        if root then
            local found = nil
            pcall(function()
                for _, inst in ipairs(root:GetDescendants()) do
                    if inst:IsA("ScreenGui") then
                        local n = inst.Name:lower()
                        if n:find("obsidian") or n:find("linoria") then
                            found = inst
                            break
                        end
                    end
                end
            end)
            if found then UI.GuiRoot = found return found end
        end
    end
    return nil
end

local function boldify(obj)
    pcall(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.FontFace = Font.new(FONT_FAMILY, Enum.FontWeight.Bold)
        end
    end)
end

local function enlargeIcon(img)
    if not img or not img.Parent then return false end
    if img:GetAttribute("EthBig") then return true end
    if not (img:IsA("ImageLabel") or img:IsA("ImageButton")) then return false end

    local gui = img:FindFirstAncestorOfClass("ScreenGui")
    if not gui then return false end

    local okW, w = pcall(function() return img.AbsoluteSize.X end)
    if not okW or w < 8 or w > 26 then return false end

    local okX, relX = pcall(function() return img.AbsolutePosition.X - gui.AbsolutePosition.X end)
    if not okX or relX < -30 or relX > 160 then return false end

    local p = img.Parent
    pcall(function()
        local pw = p.AbsoluteSize.X
        local ph = p.AbsoluteSize.Y
        if pw > 0 and ph > 0 then
            local cx = img.AbsolutePosition.X + img.AbsoluteSize.X / 2 - p.AbsolutePosition.X
            local cy = img.AbsolutePosition.Y + img.AbsoluteSize.Y / 2 - p.AbsolutePosition.Y
            img.AnchorPoint = Vector2.new(0.5, 0.5)
            img.Position = UDim2.new(cx / pw, 0, cy / ph, 0)
        end
        img.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
    end)
    img:SetAttribute("EthBig", true)
    return true
end

local function addBottomBars(gui)
    if UI.state.BarsAdded then return end

    local title
    for _, tl in ipairs(gui:GetDescendants()) do
        if tl:IsA("TextLabel") and tl.Text and tl.Text:lower():find("ethereal") then
            title = tl
            break
        end
    end
    if not title then return end

    local node = title.Parent
    local win
    while node and node ~= gui do
        if node:IsA("Frame") then
            local okSz, sz = pcall(function() return node.AbsoluteSize end)
            local hasCorner = node:FindFirstChildOfClass("UICorner") ~= nil
            if okSz and hasCorner and sz.X >= 300 and sz.Y >= 200 then
                win = node
                break
            end
        end
        node = node.Parent
    end
    if not win then return end
    UI.state.BarsAdded = true

    local holder = Instance.new("Frame")
    holder.Name = "EtherealBottomBars"
    holder.AnchorPoint = Vector2.new(0.5, 1)
    holder.Position = UDim2.new(0.5, 0, 1, 0)
    holder.Size = UDim2.new(1, 0, 0, 9)
    holder.BackgroundTransparency = 1
    holder.ZIndex = 100
    holder.Parent = win

    local bar1 = Instance.new("Frame")
    bar1.Name = "BarAccent"
    bar1.AnchorPoint = Vector2.new(0.5, 1)
    bar1.Position = UDim2.new(0.5, 0, 1, 0)
    bar1.Size = UDim2.new(1, 0, 0, 5)
    bar1.BackgroundColor3 = MOON
    bar1.BorderSizePixel = 0
    bar1.ZIndex = 101
    bar1.Parent = holder
    setCorner(bar1, UDim.new(0, 3))

    local bar2 = Instance.new("Frame")
    bar2.Name = "BarThin"
    bar2.AnchorPoint = Vector2.new(0.5, 1)
    bar2.Position = UDim2.new(0.5, 0, 1, -7)
    bar2.Size = UDim2.new(1, 0, 0, 2)
    bar2.BackgroundColor3 = Color3.fromRGB(95, 95, 102)
    bar2.BorderSizePixel = 0
    bar2.ZIndex = 101
    bar2.Parent = holder
end

task.spawn(function()
    for _ = 1, 10 do
        local gui = findGuiRoot()
        if gui then
            pcall(function()
                for _, obj in ipairs(gui:GetDescendants()) do
                    if obj:IsA("TextBox") then
                        local n = (obj.Name or ""):lower()
                        local ph = (obj.PlaceholderText or ""):lower()
                        if n:find("search") or ph:find("search") then
                            local target = obj
                            local p = obj.Parent
                            if p and p:IsA("GuiObject") and p.AbsoluteSize.X < 500 then
                                target = p
                            end
                            target.AnchorPoint = Vector2.new(1, 0.5)
                            target.Position = UDim2.new(1, -SEARCH_RIGHT_OFFSET, 0.5, 0)
                            target.Size = UDim2.new(0, SEARCH_WIDTH, target.Size.Y.Scale, target.Size.Y.Offset)
                        end
                    end
                end
            end)

            local iconsLeft = 0
            pcall(function()
                for _, obj in ipairs(gui:GetDescendants()) do
                    boldify(obj)
                    if (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
                        and not enlargeIcon(obj) then
                        local okW, w = pcall(function() return obj.AbsoluteSize.X end)
                        if okW and w >= 8 and w <= 26 then
                            iconsLeft += 1
                        end
                    end
                end
            end)

            pcall(function() addBottomBars(gui) end)

            if iconsLeft == 0 and UI.state.BarsAdded then break end
        end
        task.wait(1)
    end
end)

--========================================================================--
--  TOGGLES: rounded square + thick white stroke + yellow check             --
--========================================================================--
local ToggleMap = {}
local PROCESSED = setmetatable({}, { __mode = "k" })

local function enhanceToggle(obj)
    if not obj or not obj.Parent then return end
    if PROCESSED[obj] then return end

    local ok, isContainer = pcall(function()
        return obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ImageButton")
    end)
    if not ok or not isContainer then return end

    local w, h
    pcall(function()
        w = obj.AbsoluteSize.X
        h = obj.AbsoluteSize.Y
    end)
    if not w or not h or h < 10 or h > 32 or w < h or w > 90 then return end

    local knob = nil
    for _, c in ipairs(obj:GetChildren()) do
        local okC, isGui = pcall(function() return c:IsA("GuiObject") end)
        if okC and isGui then
            local cw, ch = 0, 0
            pcall(function()
                cw = c.AbsoluteSize.X
                ch = c.AbsoluteSize.Y
            end)
            if cw >= 4 and ch >= h * 0.45 and cw <= w * 0.6 then
                knob = c
                break
            end
        end
    end
    if not knob then
        local p = obj.Parent
        if p and p:IsA("GuiObject") then
            local pw, ph = 0, 0
            pcall(function()
                pw = p.AbsoluteSize.X
                ph = p.AbsoluteSize.Y
            end)
            if pw >= 24 and pw <= 90 and ph >= 10 and ph <= 32 and pw > ph then
                PROCESSED[obj] = true
                enhanceToggle(p)
            end
        end
        return
    end

    PROCESSED[obj] = true
    PROCESSED[knob] = true

    pcall(function()
        local initialOn = false
        local okPos, mid0, kx0 = pcall(function()
            local mid = obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2
            local kx  = knob.AbsolutePosition.X + knob.AbsoluteSize.X / 2
            return mid, kx
        end)
        if okPos then initialOn = (kx0 >= mid0) end

        obj.Size = UDim2.fromOffset(h, h)
        setCorner(obj, UDim.new(0, math.max(6, math.floor(h * 0.3))))
        obj.BackgroundTransparency = 0
        obj.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        obj.BorderSizePixel = 0

        local stroke = obj:FindFirstChildOfClass("UIStroke")
        if not stroke then
            stroke = Instance.new("UIStroke")
            stroke.Parent = obj
        end
        stroke.Color = Color3.fromRGB(235, 235, 240)
        stroke.Thickness = 2.6
        stroke.Transparency = 0.05

        local check = obj:FindFirstChild("EtherealCheck")
        if not check then
            check = Instance.new("TextLabel")
            check.Name = "EtherealCheck"
            check.BackgroundTransparency = 1
            check.Active = false
            check.AnchorPoint = Vector2.new(0.5, 0.5)
            check.Position = UDim2.new(0.5, 0, 0.5, 0)
            check.Size = UDim2.new(1, 0, 1, 0)
            check.Text = "вњ“"
            check.Font = Enum.Font.SourceSansBold
            check.TextSize = math.max(13, math.floor(h * 0.7))
            check.TextColor3 = MOON
            check.Visible = false
            check.ZIndex = 5
            check.Parent = obj
        end
        check.Visible = initialOn

        knob.Visible = false

        local d = { check = check, state = initialOn, last = 0 }
        ToggleMap[obj] = d

        obj.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                local now = os.clock()
                if now - d.last < 0.1 then return end
                d.last = now
                d.state = not d.state
                d.check.Visible = d.state
            end
        end)
    end)
end

local function getAbsSize(obj)
    local ok, s = pcall(function() return obj.AbsoluteSize end)
    if ok and s then return s.X, s.Y end
    return 0, 0
end

local function roundDescendant(obj)
    if PROCESSED[obj] then return end

    local okType, isGui = pcall(function() return obj:IsA("GuiObject") end)
    if not okType or not isGui then return end

    local w, h = getAbsSize(obj)
    if w < 1 or h < 1 then return end

    if h <= 18 and w >= h * 2 and w >= 24 then
        setCorner(obj, UDim.new(1, 0))
    elseif w >= 10 and w <= 30 and h >= 10 and h <= 30 and math.abs(w - h) <= 6 then
        setCorner(obj, UDim.new(0, 6))
    elseif (obj:IsA("TextButton") or obj:IsA("TextBox")) and h <= 40 and w >= 30 then
        setCorner(obj, UDim.new(0, 8))
    end
end

local function processNew(obj)
    task.spawn(function()
        task.wait(0.12)
        if not obj.Parent then return end
        boldify(obj)
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            pcall(function() enlargeIcon(obj) end)
        end
        enhanceToggle(obj)
        pcall(function() enhanceToggle(obj.Parent) end)
        roundDescendant(obj)
    end)
end

task.delay(1, function()
    local gui = findGuiRoot()
    if not gui then return end

    pcall(function()
        local all = gui:GetDescendants()
        for _, obj in ipairs(all) do
            enhanceToggle(obj)
        end
        for _, obj in ipairs(all) do
            roundDescendant(obj)
        end
    end)

    UI.state.roundConn = gui.DescendantAdded:Connect(function(obj)
        processNew(obj)
    end)
end)

