    UI.state.ChosenLoc  = nil
    UI.state.TPLocations = {}

    local lastLoopTP = 0

    UI.state.PlayerLoop = RunService.Heartbeat:Connect(function()
        -- spectate works even without own character
        if UI.state.Spectating then
            local plr = UI.state.PlrPick
            local cam = workspace.CurrentCamera
            if not (plr and plr.Parent and plr.Character) then
                UI.state.Spectating = false
                local hum = getHum()
                if cam and hum then pcall(function() cam.CameraSubject = hum end) end
            elseif cam then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and cam.CameraSubject ~= hum then pcall(function() cam.CameraSubject = hum end) end
            end
        end

        local c = getChar()
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not (hum and hrp) then return end

        if UI.state.FlyOn then
            -- INFINITY YIELD STYLE FLIGHT: BodyVelocity + BodyGyro on HRP
            -- Much smoother than AssemblyLinearVelocity, no clipping through floor.
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)

            -- Create BodyVelocity + BodyGyro if missing
            if not hrp:FindFirstChild("IY_FlyBV") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "IY_FlyBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
            if not hrp:FindFirstChild("IY_FlyBG") then
                local bg = Instance.new("BodyGyro")
                bg.Name = "IY_FlyBG"
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.D = 100
                bg.P = 10000
                bg.CFrame = hrp.CFrame
                bg.Parent = hrp
            end

            local bv = hrp:FindFirstChild("IY_FlyBV")
            local bg = hrp:FindFirstChild("IY_FlyBG")
            if not (bv and bg) then return end

            local spd = State.FlightSpeed * 12
            local vel = Vector3.zero
            local dir = hum.MoveDirection
            if dir.Magnitude > 0.01 then vel = dir.Unit * spd end
            local up = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up = 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then up = -1 end
            vel = vel + Vector3.new(0, up * spd, 0)
            pcall(function() bv.Velocity = vel end)

            -- Face camera direction (IY style)
            local cam = workspace.CurrentCamera
            local look = cam and cam.LookVector or Vector3.new(0, 0, -1)
            pcall(function() bg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + look) end)
            return
        end

        if UI.state.SpinOn and State.SpinSpeed > 0 then
            pcall(function() hrp.AssemblyAngularVelocity = Vector3.new(0, State.SpinSpeed, 0) end)
        end

        if UI.state.WalkOn then pcall(function() hum.WalkSpeed = State.WalkSpeed end) end
        if UI.state.JumpOn then
            pcall(function()
                hum.UseJumpPower = true
                hum.JumpPower = State.JumpPower
            end)
        end
        if UI.state.NoclipOn then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end

        -- loop TP to selected location
        if UI.state.LoopLocOn and UI.state.ChosenLoc and os.clock() - lastLoopTP > 0.5 then
            lastLoopTP = os.clock()
            local loc = UI.state.TPLocations[UI.state.ChosenLoc]
            if loc then
                local pos
                if loc:IsA("BasePart") then pos = loc.Position
                else pcall(function() pos = loc:GetPivot().Position end) end
                if pos then pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end) end
            end
        end

        -- loop TP to selected player
        if UI.state.LoopTPOn and os.clock() - lastLoopTP > 0.5 then
            lastLoopTP = os.clock()
            local plr = UI.state.PlrPick
            local tHRP = plr and plr.Parent and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then pcall(function() hrp.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3) end) end
        end
    end)

