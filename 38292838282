--========================================================================--
--  KICK ALIGN (AlignPosition + BodyPosition + BodyGyro)                    --
--                                                                          --
--  We KEEP AlignPosition (you said "алигх поситион надо оставить") AND     --
--  ADD BodyPosition + BodyGyro with pro params from XOCU:                  --
--     BodyPosition: P=200000, D=1000, MaxForce=huge                        --
--     BodyGyro:     P=200000, D=1000, MaxTorque=huge                       --
--  Triple lock = victim cannot escape even with anti-grab.                --
--========================================================================--
local function ensureKickAlign(tHRP)
    -- AlignPosition (kept)
    if not tHRP:FindFirstChild("KickAlign") then
        local oldBp = tHRP:FindFirstChildOfClass("BodyPosition")
        if oldBp then oldBp:Destroy() end

        local att0 = Instance.new("Attachment")
        att0.Name = "KickAtt0"
        att0.Parent = tHRP

        local att1 = Instance.new("Attachment")
        att1.Name = "KickAtt1"
        att1.Parent = workspace.Terrain

        local alignPos = Instance.new("AlignPosition")
        alignPos.Name = "KickAlign"
        alignPos.Attachment0 = att0
        alignPos.Attachment1 = att1
        alignPos.MaxForce = math.huge
        alignPos.Responsiveness = 200
        alignPos.Parent = tHRP

        local alignRot = Instance.new("AlignOrientation")
        alignRot.Name = "KickRot"
        alignRot.Attachment0 = att0
        alignRot.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignRot.CFrame = CFrame.new()
        alignRot.MaxTorque = math.huge
        alignRot.Responsiveness = 200
        alignRot.Parent = tHRP
    end

    -- BodyPosition (added) — SOFT lock (NoName kick params: P=75000, D=12000)
    -- Softer = less fling when grab breaks, still holds victim in place.
    if not tHRP:FindFirstChild("KickBodyPos") then
        local bodyPos = Instance.new("BodyPosition")
        bodyPos.Name = "KickBodyPos"
        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyPos.P = 75000
        bodyPos.D = 12000
        bodyPos.Position = tHRP.Position
        bodyPos.Parent = tHRP
    end

    -- BodyGyro (added) — SOFT lock (NoName kick params: P=10000, D=500)
    if not tHRP:FindFirstChild("KickBodyGyro") then
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "KickBodyGyro"
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.P = 10000
        bodyGyro.D = 500
        bodyGyro.CFrame = tHRP.CFrame
        bodyGyro.Parent = tHRP
    end
end

