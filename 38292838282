    -- Р¤РРљРЎ: СЂР°РЅСЊС€Рµ СЃС‚Р°РІРёР»Рё Enum.CameraMode.Custom вЂ” С‚Р°РєРѕРіРѕ Р·РЅР°С‡РµРЅРёСЏ РІ
    -- Enum.CameraMode РќР•Рў (С‚РѕР»СЊРєРѕ Classic / LockFirstPerson), pcall РјРѕР»С‡Р°
    -- РїР°РґР°Р» Рё С‚СЂРµС‚СЊРµ Р»РёС†Рѕ РЅРµ СЂР°Р±РѕС‚Р°Р»Рѕ. РўРµРїРµСЂСЊ РєР°Рє РІ rr9: Classic + Р·СѓРј,
    -- РїР»СЋСЃ Р·Р°С‰РёС‚Р° вЂ” РµСЃР»Рё РёРіСЂР° РїСЂРёРЅСѓРґРёС‚РµР»СЊРЅРѕ РІРµСЂРЅСѓР»Р° РїРµСЂРІРѕРµ Р»РёС†Рѕ, РјС‹
    -- РїРµСЂРµРєР»СЋС‡Р°РµРј РѕР±СЂР°С‚РЅРѕ (RenderStep + Heartbeat + СЃР»РµР¶РµРЅРёРµ Р·Р° CameraMode).
    local TP_BIND = "EtherealThirdPerson"

    local function tpApply()
        pcall(function()
            if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = State.CamDist
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType ~= Enum.CameraType.Custom then
                cam.CameraType = Enum.CameraType.Custom
            end
        end)
    end

    local function tpEnforce()
        if State.ThirdPerson then
            tpApply()
        end
    end

    local function startTP()
        if not State.SavedCam then
            State.SavedCam = {
                Mode = LocalPlayer.CameraMode,
                Min  = LocalPlayer.CameraMinZoomDistance,
                Max  = LocalPlayer.CameraMaxZoomDistance,
            }
        end
        pcall(function() RunService:UnbindFromRenderStep(TP_BIND) end)
        pcall(function()
            RunService:BindToRenderStep(TP_BIND, Enum.RenderPriority.Camera.Value - 1, tpEnforce)
        end)
        if not UI.state.tpHeart then
            UI.state.tpHeart = RunService.Heartbeat:Connect(tpEnforce)
        end
        if not UI.state.tpConn then
            UI.state.tpConn = LocalPlayer:GetPropertyChangedSignal("CameraMode"):Connect(function()
                if State.ThirdPerson and LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                    tpApply()
                end
            end)
        end
        tpApply()
    end

    local function stopTP()
        pcall(function() RunService:UnbindFromRenderStep(TP_BIND) end)
        if UI.state.tpHeart then
            pcall(function() UI.state.tpHeart:Disconnect() end)
            UI.state.tpHeart = nil
        end
        if UI.state.tpConn then
            pcall(function() UI.state.tpConn:Disconnect() end)
            UI.state.tpConn = nil
        end
        local s = State.SavedCam
        if s then
            pcall(function()
                LocalPlayer.CameraMode = s.Mode
                LocalPlayer.CameraMinZoomDistance = s.Min
                LocalPlayer.CameraMaxZoomDistance = s.Max
            end)
            State.SavedCam = nil
        end
    end

    pcall(function()
        local gCam = TabVisuals:AddLeftGroupbox("Camera")

        gCam:AddToggle("ThirdPerson", {
            Text = "Force Third Person",
            Default = false,
            Tooltip = "Zoom вЂ” pinch (mobile) or scroll (PC)",
            Callback = function(v)
                State.ThirdPerson = v
                if v then startTP() else stopTP() end
            end,
        })

        local sCam = gCam:AddSlider("CamDist", {
            Text = "Distance",
            Suffix = " studs",
            Default = 25, Min = 2, Max = 1000, Rounding = 0,
            Callback = function(v)
                State.CamDist = v
                if State.ThirdPerson then tpApply() end
            end,
        })
        styleSlider(sCam)
    end)

    UI.state.TPUnload = stopTP

    --=================== PLAYER ESP (РїРµСЂРµРЅРµСЃС‘РЅ РёР· XOCU Fixed) ============--
    -- Highlight + РЅРёРє + РґРёСЃС‚Р°РЅС†РёСЏ. РћРґРёРЅ RenderStepped-С†РёРєР» РѕР±СЃР»СѓР¶РёРІР°РµС‚
    -- РІСЃРµС… РёРіСЂРѕРєРѕРІ: СЃР°Рј СЃРѕР·РґР°С‘С‚/РїРµСЂРµСЃРѕР·РґР°С‘С‚ ESP РїСЂРё СЂРµСЃРїР°РІРЅРµ Рё СѓР±РёСЂР°РµС‚
    -- РїСЂРё РІС‹С…РѕРґРµ РёРіСЂРѕРєР° вЂ” Р±РµР· РїР°С‡РєРё СЃРѕРµРґРёРЅРµРЅРёР№, РєР°Рє Р±С‹Р»Рѕ РІ XOCU.
    do
        local PESP = {
            enabled = false,
            rainbow = false,
            color   = Color3.fromRGB(0, 255, 255),
            objs    = {},
        }

        local function destroyObj(o)
            if not o then return end
            pcall(function()
                if o.highlight then o.highlight:Destroy() end
                if o.name then o.name:Destroy() end
                if o.dist then o.dist:Destroy() end
            end)
        end

        local function clearAll()
            for _, o in pairs(PESP.objs) do destroyObj(o) end
            PESP.objs = {}
        end

        local function buildObj(plr, char)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end

            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.Adornee = char
            highlight.FillColor = PESP.color
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.4
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = char

            local name = Instance.new("BillboardGui")
            name.Name = "ESP_Name"
            name.Adornee = hrp
            name.Size = UDim2.new(0, 200, 0, 30)
            name.StudsOffset = Vector3.new(0, 3, 0)
            name.AlwaysOnTop = true
            name.Parent = hrp

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = plr.DisplayName .. " (" .. plr.Name .. ")"
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.TextStrokeTransparency = 0
            nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextScaled = true
            nameLabel.Parent = name

            local dist = Instance.new("BillboardGui")
            dist.Name = "ESP_Distance"
            dist.Adornee = hrp
            dist.Size = UDim2.new(0, 100, 0, 20)
            dist.StudsOffset = Vector3.new(0, -2.4, 0)
            dist.AlwaysOnTop = true
            dist.Parent = hrp

            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.new(1, 0, 1, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0 studs"
            distLabel.TextColor3 = PESP.color
            distLabel.TextStrokeTransparency = 0
            distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            distLabel.Font = Enum.Font.GothamBold
            distLabel.TextScaled = true
            distLabel.Parent = dist

            return {
                char = char, hrp = hrp,
                highlight = highlight, name = name, dist = dist,
                distLabel = distLabel,
            }
        end

        local function espLoop()
            local myHRP = getChar() and getChar():FindFirstChild("HumanoidRootPart")

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local char = plr.Character
                    local ok = false
                    if char and char.Parent then
                        local o = PESP.objs[plr]
                        if o and o.char ~= char then
                            destroyObj(o) -- СЂРµСЃРїР°РІРЅ вЂ” РїРµСЂРµСЃРѕР·РґР°С‘Рј
                            PESP.objs[plr] = nil
                            o = nil
                        end
                        if not o then
                            o = buildObj(plr, char)
                            if o then PESP.objs[plr] = o end
                        end
                        if o then
                            ok = true
                            if myHRP and o.hrp.Parent then
                                local d = math.floor((o.hrp.Position - myHRP.Position).Magnitude)
                                o.distLabel.Text = d .. " studs"
                            end
                        end
                    end
                    if not ok and PESP.objs[plr] then
                        destroyObj(PESP.objs[plr])
                        PESP.objs[plr] = nil
                    end
                end
            end

            for plr, o in pairs(PESP.objs) do
                if not plr.Parent then
                    destroyObj(o)
                    PESP.objs[plr] = nil
                end
            end
        end

        local gESP = TabVisuals:AddLeftGroupbox("Player ESP")

        gESP:AddToggle("PlayerESP", {
            Text = "Enable Player ESP",
            Default = false,
            Callback = function(v)
                PESP.enabled = v
                if not v then clearAll() end
            end,
        })

        gESP:AddToggle("PlayerESPRainbow", {
            Text = "Rainbow ESP",
            Default = false,
            Callback = function(v)
                PESP.rainbow = v
                if v then
                    task.spawn(function()
                        while PESP.rainbow do
                            PESP.color = Color3.fromHSV(tick() % 1, 1, 1)
                            for _, o in pairs(PESP.objs) do
                                pcall(function() o.highlight.FillColor = PESP.color end)
                            end
                            task.wait(0.05)
                        end
                    end)
                else
                    PESP.color = Color3.fromRGB(0, 255, 255)
                    for _, o in pairs(PESP.objs) do
                        pcall(function() o.highlight.FillColor = PESP.color end)
                    end
                end
            end,
        })

        UI.state.PESPloop = RunService.RenderStepped:Connect(function()
            if PESP.enabled then
                pcall(espLoop)
            end
        end)
        UI.state.PESP = PESP
        UI.state.PESPClear = clearAll
    end

    --=================== PCLD ESP (РїРµСЂРµРЅРµСЃС‘РЅ РёР· XOCU Fixed) ==============--
    -- BoxHandleAdornment-Р±РѕРєСЃС‹ РЅР° РґРµС‚РµРєС‚РѕСЂР°С… "partesp" /
    -- "playercharacterlocationdetector" + СЂР°РґСѓРіР°.
    do
        local CESP = {
            enabled = false,
            rainbow = false,
            color   = Color3.fromRGB(0, 255, 255),
            boxes   = {},
            conns   = {},
        }

        local boxParent
        pcall(function() boxParent = gethui and gethui() end)
        if not boxParent then
            pcall(function() boxParent = game:GetService("CoreGui") end)
        end
        if not boxParent then
            pcall(function() boxParent = LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
        end

        local TARGETS = { "partesp", "playercharacterlocationdetector" }

        local function isTarget(obj)
            if not obj:IsA("BasePart") then return false end
            local n = string.lower(obj.Name)
            for _, t in ipairs(TARGETS) do
                if n == t then return true end
            end
            return false
        end

        local function addBox(obj)
            if CESP.boxes[obj] or not boxParent then return end
            local box = Instance.new("BoxHandleAdornment")
            box.Adornee = obj
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Color3 = CESP.color
            box.Transparency = 0.3
            box.Size = obj.Size
            box.Parent = boxParent
            CESP.boxes[obj] = box

            local conn = obj.AncestryChanged:Connect(function(_, parent)
                if not parent and CESP.boxes[obj] then
                    pcall(function() CESP.boxes[obj]:Destroy() end)
                    CESP.boxes[obj] = nil
                end
            end)
            table.insert(CESP.conns, conn)
        end

        local function removeAll()
            for _, box in pairs(CESP.boxes) do
                pcall(function() box:Destroy() end)
            end
            CESP.boxes = {}
            for _, c in ipairs(CESP.conns) do
                pcall(function() c:Disconnect() end)
            end
            CESP.conns = {}
        end

        local function scan()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if CESP.enabled and isTarget(obj) then
                    addBox(obj)
                end
            end
        end

        local gP = TabVisuals:AddRightGroupbox("PCLD ESP")

        gP:AddToggle("PCLDESP", {
            Text = "Enable PCLD ESP",
            Default = false,
            Tooltip = "Boxes on PartEsp / PlayerCharacterLocationDetector",
            Callback = function(v)
                CESP.enabled = v
                if v then
                    scan()
                    local conn = workspace.DescendantAdded:Connect(function(obj)
                        if CESP.enabled and isTarget(obj) then
                            addBox(obj)
                        end
                    end)
                    table.insert(CESP.conns, conn)
                else
                    removeAll()
                end
            end,
        })

        gP:AddToggle("PCLDRainbow", {
            Text = "Rainbow PCLD",
            Default = false,
            Callback = function(v)
                CESP.rainbow = v
                if v then
                    task.spawn(function()
                        while CESP.rainbow do
                            local c = Color3.fromHSV(tick() % 1, 1, 1)
                            for _, box in pairs(CESP.boxes) do
                                pcall(function() box.Color3 = c end)
                            end
                            task.wait(0.05)
                        end
                    end)
                else
                    CESP.color = Color3.fromRGB(0, 255, 255)
                    for _, box in pairs(CESP.boxes) do
                        pcall(function() box.Color3 = CESP.color end)
                    end
                end
            end,
        })

        UI.state.CESP = CESP
        UI.state.PCLDClear = removeAll
    end

    -- РѕР±С‰РёР№ РєР»РёРЅР°Рї РґР»СЏ UNLOAD
    UI.state.ESPCleanup = function()
        if UI.state.PESPloop then
            pcall(function() UI.state.PESPloop:Disconnect() end)
            UI.state.PESPloop = nil
        end
        if UI.state.PESPClear then pcall(UI.state.PESPClear) end
        if UI.state.PCLDClear then pcall(UI.state.PCLDClear) end
    end
end

