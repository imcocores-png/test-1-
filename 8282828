local WaterGroup = Tabs.Visuals:AddLeftGroupbox("Ocean Water", "waves")

local _cachedOceanParts = nil
local function getOceanParts()
    if _cachedOceanParts then
        return _cachedOceanParts
    end
    local parts = {}
    local ok, OceanFolder = pcall(function()
        return Workspace.Map.AlwaysHereTweenedObjects.Ocean.Object.ObjectModel
    end)
    if ok and OceanFolder then
        for _, obj in ipairs(OceanFolder:GetDescendants()) do
            if obj:IsA("BasePart") then
                table.insert(parts, obj)
            end
        end
    end
    _cachedOceanParts = parts
    return parts
end

local function setOceanMaterial(materialName)
    local material = Enum.Material[materialName]
    if not material then return end
    for _, part in ipairs(getOceanParts()) do
        part.Material = material
    end
end

local function setOceanColor(color)
    for _, part in ipairs(getOceanParts()) do
        part.Color = color
    end
end

