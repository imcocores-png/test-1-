-- ====================== Spin Kick (FTAP Physics Abuse) ======================
local spinKickActive = false
local spinKickTask = nil
BlobGroup:AddCheckbox("SpinKick", {
    Text = "Spin Kick",
    Default = false,
    Callback = function(on)
        spinKickActive = on
        if on then
            if not selectedTarget then
                Library:Notify({Title = "Ethereal", Content = "Select target first!", Duration = 3})
                spinKickActive = false
                return
            end
            spinKickTask = task.spawn(function()
                local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
                local myChar = LocalPlayer.Character
                local myHum = myChar and myChar:FindFirstChild("Humanoid")
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local seat = myHum and myHum.SeatPart
                if not seat then
                    Library:Notify({Title = "Ethereal", Content = "Sit on blobman first!", Duration = 3})
                    spinKickActive = false
                    return
                end
                local refs = GetBlobmanRefs()
                if not refs then
                    Library:Notify({Title = "Ethereal", Content = "Blobman refs not found!", Duration = 3})
                    spinKickActive = false
                    return
                end
                local savedPos = myRoot.CFrame
                local blobman = refs.blobman
                local grab, drop = refs.grab, refs.drop
                local L_Det, R_Det = refs.L_Det, refs.R_Det
                local L_Weld, R_Weld = refs.L_Weld, refs.R_Weld
                local blobSeat = blobman:FindFirstChildWhichIsA("VehicleSeat")
                local blobHead = blobman:FindFirstChild("Head")
                pcall(function()
                    for _, p in ipairs(blobman:GetDescendants()) do
                        if p:IsA("BasePart") then p.Color = Color3.fromRGB(255, 215, 0) end
                    end
                end)
                local angle = 0
                local radius = 15
                local spinSpeed = 12
                local lockPos = savedPos * CFrame.new(0, customKickHeight, 0)
                -- Phase 1: Grab target SERVER-SIDE
                -- SNO target to blobman position FIRST (so server sees them together)
                do
                    local t = GetTargetRefs()
                    if not t then spinKickActive = false return end
                    -- Step 1: SNO target to blobman position (get them close on server)
                    for i = 1, 5 do
                        t.tRoot.CFrame = savedPos
                        t.tRoot.AssemblyLinearVelocity = Vector3.zero
                        t.tRoot.Velocity = Vector3.zero
                        t.tHum.PlatformStand = true
                        pcall(function() GE.SetNetworkOwner:FireServer(t.tRoot, savedPos) end)
                        RunService.Heartbeat:Wait()
                    end
                    -- Step 2: Grab both hands (server sees blobman next to target)
                    pcall(function()
                        grab:FireServer(L_Det, t.tRoot, L_Weld)
                        grab:FireServer(R_Det, t.tRoot, R_Weld)
                    end)
                    -- Step 3: Hold grab, then SNO target to air (physics abuse starts)
                    for i = 1, 5 do
                        t.tRoot.CFrame = savedPos
                        t.tRoot.AssemblyLinearVelocity = Vector3.zero
                        t.tHum.PlatformStand = true
                        RunService.Heartbeat:Wait()
                    end
                    -- Step 4: SNO target up to lockPos (weld stretches = physics violation)
                    for i = 1, 5 do
                        t.tRoot.CFrame = lockPos
                        t.tRoot.AssemblyLinearVelocity = Vector3.zero
                        t.tRoot.Velocity = Vector3.zero
                        t.tHum.PlatformStand = true
                        pcall(function() GE.SetNetworkOwner:FireServer(t.tRoot, lockPos) end)
                        RunService.Heartbeat:Wait()
                    end
                    -- Step 5: Drop (weld removed after physics abuse already registered)
                    pcall(function()
                        drop:FireServer(L_Weld, t.tRoot)
                        drop:FireServer(R_Weld, t.tRoot)
                    end)
                end
                -- Phase 2: Spin + kick with SNO-to-blobman grab cycle
                -- States: "sno_down" -> "grab" -> "hold" -> "sno_up" -> "drop" -> "wait" -> repeat
                local state = "sno_down"
                local stateTimer = 0
                while spinKickActive do
                    local t = GetTargetRefs()
                    if not t then break end
                    local tRoot, tHum = t.tRoot, t.tHum
                    -- Keep target frozen client-side at lockPos (visual)
                    tRoot.CFrame = lockPos
                    tRoot.AssemblyLinearVelocity = Vector3.zero
                    tRoot.Velocity = Vector3.zero
                    t.tHum.PlatformStand = true
                    -- Keep self in place
                    myRoot.CFrame = savedPos
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    -- Spin blobman around target (client-only CFrame, zero ping)
                    angle = angle + spinSpeed
                    local offsetX = math.cos(math.rad(angle)) * radius
                    local offsetZ = math.sin(math.rad(angle)) * radius
                    local spinPos = CFrame.new(
                        lockPos.X + offsetX,
                        lockPos.Y + 2,
                        lockPos.Z + offsetZ
                    )
                    spinPos = CFrame.new(spinPos.Position, lockPos.Position)
                    if blobSeat then blobSeat.CFrame = spinPos end
                    if blobHead then blobHead.CFrame = spinPos end
                    stateTimer = stateTimer + 1
                    -- State machine: SNO target to blobman, grab, SNO back up, drop, repeat
                    if state == "sno_down" then
                        -- SNO target to blobman position (server sees them together)
                        pcall(function()
                            GE.SetNetworkOwner:FireServer(tRoot, savedPos)
                        end)
                        state = "grab"
                        stateTimer = 0
                    elseif state == "grab" then
                        -- Grab both hands (server sees blobman near target)
                        pcall(function()
                            grab:FireServer(L_Det, tRoot, L_Weld)
                            grab:FireServer(R_Det, tRoot, L_Weld)
                        end)
                        state = "hold"
                        stateTimer = 0
                    elseif state == "hold" then
                        if stateTimer >= 2 then
                            -- SNO target back to air (weld stretches = physics abuse)
                            pcall(function()
                                GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            end)
                            state = "drop"
                            stateTimer = 0
                        end
                    elseif state == "drop" then
                        if stateTimer >= 1 then
                            pcall(function()
                                drop:FireServer(L_Weld, tRoot)
                                drop:FireServer(R_Weld, tRoot)
                            end)
                            state = "wait"
                            stateTimer = 0
                        end
                    elseif state == "wait" then
                        if stateTimer >= 1 then
                            state = "sno_down"
                            stateTimer = 0
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
                -- Cleanup: drop target, restore colors
                pcall(function()
                    local t = GetTargetRefs()
                    if t then
                        drop:FireServer(L_Weld, t.tRoot)
                        drop:FireServer(R_Weld, t.tRoot)
                    end
                end)
                pcall(function() myRoot.CFrame = savedPos end)
                pcall(function()
                    for _, p in ipairs(blobman:GetDescendants()) do
                        if p:IsA("BasePart") then p.Color = Color3.fromRGB(136, 62, 244) end
                    end
                end)
                spinKickActive = false
            end)
        else
            if spinKickTask then task.cancel(spinKickTask) spinKickTask = nil end
        end
    end
})

