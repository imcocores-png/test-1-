-- Helper: get cached blobman refs (avoids re-finding every frame)
local function GetBlobmanRefs()
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local seat = myHum and myHum.SeatPart
    if not seat then return nil end
    local blobman = seat.Parent
    if not blobman or blobman.Name ~= "CreatureBlobman" then return nil end
    local rf = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
    if not rf then return nil end
    local grab = rf:FindFirstChild("CreatureGrab")
    local drop = rf:FindFirstChild("CreatureDrop")
    local L_Det = blobman:FindFirstChild("LeftDetector")
    local R_Det = blobman:FindFirstChild("RightDetector")
    if not L_Det or not R_Det then return nil end
    local L_Weld = L_Det:FindFirstChild("LeftWeld") or L_Det:FindFirstChild("RigidConstraint")
    local R_Weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint")
    if not grab or not drop or not L_Weld or not R_Weld then return nil end
    return {blobman=blobman, grab=grab, drop=drop, L_Det=L_Det, R_Det=R_Det, L_Weld=L_Weld, R_Weld=R_Weld}
end

-- Helper: get target player refs
local function GetTargetRefs()
    if not selectedTarget then return nil end
    local target = Players:FindFirstChild(selectedTarget)
    if not target or not target.Parent or not target.Character then return nil end
    local tChar = target.Character
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChild("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then return nil end
    return {target=target, tChar=tChar, tRoot=tRoot, tHum=tHum}
end

