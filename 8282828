    -- Hat
    function V.removeHat(c)
        local h = V.HatParts[c]
        if h then h:Destroy() V.HatParts[c] = nil end
    end

    function V.addHat(c)
        task.wait(0.1)
        local head = c and c:FindFirstChild("Head")
        if not head then return end
        V.removeHat(c)
        local hat = Instance.new("Part")
        hat.Name = "Hat"
        hat.Transparency = V.HatTransparency
        hat.Color = V.HatColor
        hat.Material = Enum.Material.Neon
        hat.CanCollide = false
        hat.CanTouch = false
        hat.CanQuery = false
        hat.Massless = true
        local m = Instance.new("SpecialMesh")
        m.MeshId = "rbxassetid://1033714"
        m.Scale = Vector3.new(2.4, 1.6, 2.4)
        m.Parent = hat
        local w = Instance.new("WeldConstraint")
        w.Part0 = head
        w.Part1 = hat
        w.Parent = hat
        hat.CFrame = head.CFrame * CFrame.new(0, 1.1, 0)
        hat.Parent = c
        V.HatParts[c] = hat
    end

    function V.updateHats()
        for c, h in pairs(V.HatParts) do
            if h and h.Parent and c == LocalPlayer.Character then
                h.Transparency = V.HatTransparency
                h.Color = V.HatRainbow and Color3.fromHSV((tick() % 5) / 5, 1, 1) or V.HatColor
            end
        end
    end

    -- Trail
    function V.removeTrail(c)
        if V.TrailParts[c] then V.TrailParts[c]:Destroy() V.TrailParts[c] = nil end
        local t = c and c:FindFirstChild("HumanoidRootPart")
        if t then
            local a0 = t:FindFirstChild("TrailAttach0")
            local a1 = t:FindFirstChild("TrailAttach1")
            if a0 then a0:Destroy() end
            if a1 then a1:Destroy() end
        end
    end

    function V.addTrail(c)
        local t = c and c:FindFirstChild("HumanoidRootPart")
        if not t then return end
        V.removeTrail(c)
        local a0 = Instance.new("Attachment")
        a0.Name = "TrailAttach0"
        a0.Position = Vector3.new(0, 2, 0)
        a0.Parent = t
        local a1 = Instance.new("Attachment")
        a1.Name = "TrailAttach1"
        a1.Position = Vector3.new(0, -2, 0)
        a1.Parent = t
        local tr = Instance.new("Trail")
        tr.Attachment0 = a0
        tr.Attachment1 = a1
        tr.Lifetime = V.TrailLifetime
        tr.LightEmission = 0.2
        tr.Enabled = true
        tr.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, V.TrailTransparencyStart),
            NumberSequenceKeypoint.new(1, 1)
        })
        tr.Color = V.TrailGradient and ColorSequence.new(V.TrailGradient1, V.TrailGradient2) or ColorSequence.new(V.TrailColorStatic)
        tr.Parent = c
        V.TrailParts[c] = tr
    end

    function V.updateTrails()
        for c, tr in pairs(V.TrailParts) do
            if tr and tr.Parent and c == LocalPlayer.Character then
                tr.Lifetime = V.TrailLifetime
                tr.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, V.TrailTransparencyStart),
                    NumberSequenceKeypoint.new(1, 1)
                })
                local col = V.TrailRainbow and Color3.fromHSV((tick() % 5) / 5, 1, 1) or V.TrailColorStatic
                tr.Color = V.TrailGradient and ColorSequence.new(V.TrailGradient1, V.TrailGradient2) or ColorSequence.new(col)
            end
        end
    end

    -- ForceField
    function V.saveOriginalColors(c)
        V.OriginalColors[c] = {}
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "Hat" then
                V.OriginalColors[c][p] = {Color = p.Color, Material = p.Material}
            end
        end
    end

    function V.applyForceField(c)
        V.saveOriginalColors(c)
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "Hat" then
                p.Color = V.ForceFieldColor
                p.Material = Enum.Material.ForceField
            end
        end
    end

    function V.removeForceField(c)
        local orig = V.OriginalColors[c]
        if not orig then return end
        for p, d in pairs(orig) do
            if p and p.Parent and p:IsA("BasePart") then
                p.Color = d.Color
                p.Material = d.Material
            end
        end
        V.OriginalColors[c] = nil
    end

    function V.updateForceField()
        if not (LocalPlayer.Character and V.ForceFieldEnabled) then return end
        for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "Hat" and p.Material == Enum.Material.ForceField then
                p.Color = V.ForceFieldRainbow and Color3.fromHSV((tick() % 5) / 5, 1, 1) or V.ForceFieldColor
            end
        end
    end

    -- Aura
    function V.disableAura()
        for _, o in ipairs(V.AuraEffects) do
            if o and o.Parent then o:Destroy() end
        end
        table.clear(V.AuraEffects)
    end

    function V.enableAura(c)
        V.disableAura()
        if not V.CurrentAuraModel then return end
        local tmp = V.CurrentAuraModel:Clone()
        for _, o in ipairs(tmp:GetDescendants()) do
            if not o:IsA("BasePart") then
                local cl = o:Clone()
                local pn = o.Parent and o.Parent.Name
                local tgt = pn and c:FindFirstChild(pn) or c:FindFirstChildWhichIsA("BasePart")
                if tgt and not tgt:FindFirstChild(cl.Name) then
                    cl.Parent = tgt
                    table.insert(V.AuraEffects, cl)
                end
            end
        end
        tmp:Destroy()
    end

    function V.updateAuraLogic()
        local id = V.CustomAuraID ~= "" and ("rbxassetid://" .. V.CustomAuraID:gsub("%D", "")) or V.AuraModels[V.AuraType]
        if not id then return end
        local ok, m = pcall(function() return game:GetObjects(id)[1] end)
        if ok and m then
            V.CurrentAuraModel = m
            if V.AuraEnabled and LocalPlayer.Character then
                V.enableAura(LocalPlayer.Character)
            end
        end
    end

    -- Respawn reapply
    local function vReapply(c)
        task.wait(1)
        if V.HatEnabled then V.addHat(c) end
        if V.TrailEnabled then V.addTrail(c) end
        if V.ForceFieldEnabled then V.applyForceField(c) end
        if V.AuraEnabled then V.enableAura(c) end
    end
    LocalPlayer.CharacterAdded:Connect(vReapply)
    if LocalPlayer.Character then
        task.defer(function() vReapply(LocalPlayer.Character) end)
    end

    -- Heartbeat loop
    RunService.Heartbeat:Connect(function()
        if V.HatEnabled then V.updateHats() end
        if V.TrailEnabled then V.updateTrails() end
        if V.ForceFieldEnabled then V.updateForceField() end
    end)

    -- ====================== XOCO UI ======================
