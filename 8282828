-- ====================== ANCHOR GRAB v2 (Server-Side SNO) ======================
-- Completely rewritten: uses SetNetworkOwner spam instead of client-side Anchored/BodyMovers
-- - Server-side position freeze via SNO every frame
-- - Anti-grab: detects other players grabbing anchored items, reclaims ownership instantly
-- - User can move own anchored items (pauses freeze while user grabs, re-anchors on release)
-- - Works on items AND players

do
    local AnchorEnabled = false
    local AnchorCoro = nil
    local AnchorHBConn = nil
    local AnchorAntiGrabConn = nil
    local AnchorParts = {} -- {part=part, pos=CFrame}
    local AnchorConns = {}
    local AnchorPaused = {} -- set of parts currently being grabbed by user (temporarily un-anchored)
    local SNO = nil
    local DestroyLine = nil

    local function InitGrabEvents()
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if GE then
            SNO = GE:FindFirstChild("SetNetworkOwner")
            DestroyLine = GE:FindFirstChild("DestroyGrabLine")
        end
    end
    InitGrabEvents()

    local function IsDescOf(target, ancestor)
        local c = target.Parent
        while c do
            if c == ancestor then return true end
            c = c.Parent
        end
        return false
    end

    local function CleanConns(t)
        for _, c in ipairs(t) do
            if c and c.Connected then c:Disconnect() end
        end
        table.clear(t)
    end

    local function MakeAnchorHighlight(parent)
        local existing = parent:FindFirstChild("GrabAnchorHL")
        if existing then existing:Destroy() end
        local h = Instance.new("Highlight")
        h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.FillTransparency = 1
        h.Name = "GrabAnchorHL"
        h.OutlineColor = Color3.new(0, 1, 0)
        h.OutlineTransparency = 0.3
        h.Parent = parent
        return h
    end

    local function IsAnchoredPart(part)
        for _, data in ipairs(AnchorParts) do
            if data.part == part then return true end
        end
        return false
    end

    local function IsPaused(part)
        for _, p in ipairs(AnchorPaused) do
            if p == part then return true end
        end
        return false
    end

    local function RemoveFromAnchor(part)
        for i, data in ipairs(AnchorParts) do
            if data.part == part then
                table.remove(AnchorParts, i)
                -- Remove highlight
                local parent = part.Parent
                if parent then
                    local hl = parent:FindFirstChild("GrabAnchorHL")
                    if hl then hl:Destroy() end
                end
                return true
            end
        end
        return false
    end

    local function AddToAnchor(part)
        if IsAnchoredPart(part) then return end
        local parent = part.Parent
        if not parent then return end
        MakeAnchorHighlight(parent)
        table.insert(AnchorParts, {part = part, pos = part.CFrame})
        -- Monitor PartOwner changes for anti-grab
        local conn = parent.DescendantAdded:Connect(function(d)
            if d.Name ~= "PartOwner" then return end
            -- If someone else takes ownership, reclaim immediately
            if d.Value ~= "" and d.Value ~= LocalPlayer.Name then
                local hl = parent:FindFirstChild("GrabAnchorHL")
                if hl then hl.OutlineColor = Color3.new(1, 0, 0) end
                -- Spam SNO back to reclaim
                task.spawn(function()
                    for _ = 1, 10 do
                        if not IsAnchoredPart(part) or not AnchorEnabled then return end
                        pcall(function()
                            if SNO then SNO:FireServer(part, part.CFrame) end
                            if DestroyLine then DestroyLine:FireServer(part) end
                        end)
                        RunService.Heartbeat:Wait()
                    end
                    -- Reset highlight color after reclaim
                    if IsAnchoredPart(part) then
                        local hl2 = parent:FindFirstChild("GrabAnchorHL")
                        if hl2 then hl2.OutlineColor = Color3.new(0, 1, 0) end
                    end
                end)
            else
                local hl = parent:FindFirstChild("GrabAnchorHL")
                if hl then hl.OutlineColor = Color3.new(0, 1, 0) end
            end
        end)
        table.insert(AnchorConns, conn)
    end

    -- Main loop: detect when user releases a grabbed object, anchor it
    local function AnchorLoop()
        while AnchorEnabled do
            pcall(function()
                local gf = Workspace:FindFirstChild("GrabParts")
                if not gf then return end
                local gp = gf:FindFirstChild("GrabPart")
                if not gp then return end
                local w = gp:FindFirstChild("WeldConstraint")
                if not w or not w.Part1 then return end
                local prim = w.Part1.Parent and w.Part1.Parent.PrimaryPart
                if not prim then return end
                -- Skip map parts
                local mapFolder = Workspace:FindFirstChild("Map")
                if mapFolder and IsDescOf(prim, mapFolder) then return end
                -- Skip if already anchored
                if IsAnchoredPart(prim) then return end
                -- Wait for user to release (GrabParts disappears)
                while Workspace:FindFirstChild("GrabParts") do
                    task.wait()
                end
                -- Now anchor it at current position
                if prim and prim.Parent then
                    AddToAnchor(prim)
                end
            end)
            task.wait()
        end
    end

    -- Heartbeat: server-side freeze via SNO spam every frame
    local function StartHeartbeat()
        if AnchorHBConn then return end
        AnchorHBConn = RunService.Heartbeat:Connect(function()
            if not AnchorEnabled then return end
            for _, data in ipairs(AnchorParts) do
                local part = data.part
                if part and part.Parent and not IsPaused(part) then
                    pcall(function()
                        -- Force position on server via SNO (this IS server-side)
                        if SNO then
                            SNO:FireServer(part, data.pos)
                        end
                        -- Zero velocity (replicates when you have network ownership)
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
        end)
    end

    -- Anti-grab: if ANY GrabParts appears targeting our anchored items, destroy it
    local function StartAntiGrab()
        if AnchorAntiGrabConn then return end
        AnchorAntiGrabConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name ~= "GrabParts" or not AnchorEnabled then return end
            task.spawn(function()
                task.wait(0.02)
                if not AnchorEnabled then return end
                local gp = child:FindFirstChild("GrabPart")
                if not gp then return end
                local w = gp:FindFirstChild("WeldConstraint")
                if not w or not w.Part1 then return end
                local grabbedPart = w.Part1.Parent and w.Part1.Parent.PrimaryPart
                if not grabbedPart then return end
                -- Check if this is one of our anchored objects
                if IsAnchoredPart(grabbedPart) then
                    -- Check if it's US grabbing (allow self-grab to move)
                    local partOwner = grabbedPart:FindFirstChild("PartOwner")
                    if partOwner and partOwner.Value == LocalPlayer.Name then
                        -- User is grabbing their own anchored item - pause anchoring
                        table.insert(AnchorPaused, grabbedPart)
                        -- Wait until user releases
                        while child.Parent and AnchorEnabled do
                            task.wait()
                        end
                        -- Re-anchor at NEW position
                        for i = 1, #AnchorPaused do
                            if AnchorPaused[i] == grabbedPart then
                                table.remove(AnchorPaused, i)
                                break
                            end
                        end
                        if grabbedPart and grabbedPart.Parent and IsAnchoredPart(grabbedPart) and AnchorEnabled then
                            -- Update anchor position to where user placed it
                            for _, data in ipairs(AnchorParts) do
                                if data.part == grabbedPart then
                                    data.pos = grabbedPart.CFrame
                                    break
                                end
                            end
                        end
                    else
                        -- Another player is grabbing - DESTROY their grab immediately
                        for _ = 1, 5 do
                            pcall(function()
                                if SNO then SNO:FireServer(grabbedPart, grabbedPart.CFrame) end
                                if DestroyLine then DestroyLine:FireServer(grabbedPart) end
                            end)
                        end
                    end
                end
            end)
        end)
    end

    local function StopHeartbeat()
        if AnchorHBConn then AnchorHBConn:Disconnect() AnchorHBConn = nil end
    end

    local function StopAntiGrab()
        if AnchorAntiGrabConn then AnchorAntiGrabConn:Disconnect() AnchorAntiGrabConn = nil end
    end

    local function ReleaseAllAnchor()
        StopHeartbeat()
        StopAntiGrab()
        for _, data in ipairs(AnchorParts) do
            local part = data.part
            if part and part.Parent then
                local parent = part.Parent
                local hl = parent:FindFirstChild("GrabAnchorHL")
                if hl then hl:Destroy() end
                pcall(function()
                    part.Anchored = false
                    if SNO then SNO:FireServer(part, part.CFrame) end
                end)
            end
        end
        CleanConns(AnchorConns)
        table.clear(AnchorParts)
        table.clear(AnchorPaused)
    end

    GrabsAnchorGroup:AddCheckbox("AnchorGrab", {
        Text = "Anchor Grab",
        Default = false,
        Callback = function(Value)
            AnchorEnabled = Value
            if Value then
                InitGrabEvents()
                if not SNO then
                    Library:Notify({Title = "Ethereal", Content = "GrabEvents not found!", Duration = 3})
                    AnchorEnabled = false
                    return
                end
                StartHeartbeat()
                StartAntiGrab()
                if not AnchorCoro or coroutine.status(AnchorCoro) == "dead" then
                    AnchorCoro = coroutine.create(AnchorLoop)
                    coroutine.resume(AnchorCoro)
                end
                Library:Notify({Title = "Ethereal", Content = "Anchor Grab v2 enabled! (Server-Side)", Duration = 2})
            else
                if AnchorCoro and coroutine.status(AnchorCoro) ~= "dead" then
                    coroutine.close(AnchorCoro)
                    AnchorCoro = nil
                end
                ReleaseAllAnchor()
                Library:Notify({Title = "Ethereal", Content = "Anchor Grab disabled!", Duration = 2})
            end
        end
    })

    GrabsAnchorGroup:AddButton({Text = "Release All Anchors", Func = function()
        ReleaseAllAnchor()
        Library:Notify({Title = "Ethereal", Content = "All anchors released!", Duration = 2})
    end})

end

