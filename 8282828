local spinKickActive = false
local spinKickTask = nil
BlobGroup:AddCheckbox("SpinKick", {
    Text = "Spin Kick",
    Default = false,
    Callback = function(on)
        spinKickActive = on
        if on then
            if not selectedTarget then
                Library:Notify({Title = "Ethereal", Content = "Select target first!", Duration = 3})
                spinKickActive = false
