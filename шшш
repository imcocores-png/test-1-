local function doGucciX()
    if gucciBusyX then return end
    gucciBusyX = true
    pcall(function()
        local char, hum, hrp = getCharX()
        if not (char and hum and hrp) then return end
        local inv = getInvX()
        if inv then
            for _, v in ipairs(inv:GetChildren()) do
                if v.Name == "GucciBlobX" or v.Name == gucciMethodX then
                    pcall(function() ReplicatedStorage.MenuToys.DestroyToy:FireServer(v) end)
                end
            end
        end
        local blob = SpawnToyX(gucciMethodX)
        if not blob then return end
        blob.Name = "GucciBlobX"
        local seat = blob:FindFirstChild("VehicleSeat") or blob:FindFirstChildWhichIsA("VehicleSeat")
        if not seat then
            pcall(function() ReplicatedStorage.MenuToys.DestroyToy:FireServer(blob) end)
            return
        end
        local tR = tick()
        while tick() - tR < 0.5 do
            pcall(function() ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0) end)
            task.wait()
        end
        local tS = tick()
        while not hum.SeatPart and tick() - tS < 5 do
            seat:Sit(hum)
            task.wait(0.1)
        end
        if not hum.SeatPart then return end
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        task.spawn(function()
            local w = tick()
            while tick() - w < 3 and seat.Parent and seat:FindFirstChild("SeatWeld") do task.wait() end
            if blob.Parent then
                blob:PivotTo(CFrame.new(0, 1e6, 0))
                local bp = Instance.new("BodyPosition")
                bp.Position = Vector3.new(0, 1e6, 0)
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bp.P = 10000; bp.D = 4000
                bp.Parent = blob.PrimaryPart or seat
            end
        end)
    end)
    gucciBusyX = false
end

