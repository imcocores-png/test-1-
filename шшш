local function ClearKunaiX()
    local inv = getInvX()
    if not inv then return end
    for _, v in ipairs(inv:GetChildren()) do
        if v.Name == "AntiKickX" or v.Name == "NinjaShuriken" then
            pcall(function() ReplicatedStorage.MenuToys.DestroyToy:FireServer(v) end)
        end
    end
end

local function StickKunaiX(kunai)
    local sticky = kunai:FindFirstChild("StickyPart")
    if not sticky then return false end
    local _, _, hrp = getCharX()
    local fire = hrp and hrp:FindFirstChild("FirePlayerPart")
    if not fire then return false end
    local function restick()
        snoX(sticky)
        pcall(function()
            ReplicatedStorage.PlayerEvents.StickyPartEvent:FireServer(sticky, fire, CFrame.Angles(0, math.rad(90), math.rad(90)))
        end)
    end
    restick()
    local t0 = tick()
    while tick() - t0 < 0.7 do
        task.wait()
        sticky = kunai:FindFirstChild("StickyPart")
        if not sticky or not sticky.Parent then return false end
        local weld = sticky:FindFirstChild("StickyWeld")
        if weld and weld.Part1 == fire then return true end
        local owner = sticky:FindFirstChild("PartOwner")
        if owner and owner.Value ~= LocalPlayer.Name then
            restick()
            t0 = tick()
        end
    end
    return false
end

