end

local function SpawnToyX(toyName)
    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    if canSpawn then
        local t0 = tick()
        while not canSpawn.Value and tick() - t0 < 3 do task.wait(0.1) end
    end
    local _, _, hrp = getCharX()
    local container = getInvX()
    if not (hrp and container) then return nil end
    local spawned = nil
    local con = container.ChildAdded:Connect(function(child)
        if child.Name == toyName then spawned = child end
    end)
    task.spawn(function()
        pcall(function()
            ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(toyName, hrp.CFrame * CFrame.new(0, 5, 8), Vector3.zero)
        end)
    end)
    local t0 = tick()
    while not spawned and tick() - t0 < 2.5 do task.wait() end
    con:Disconnect()
    return spawned
end

