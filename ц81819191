--================ POOP: INFINITE AMMO v2 ================--
local ammoEnabled = false
local ammoConns = {}
local ammoValues = {}

local AMMO_KEYWORDS = {
    "ammo", "ammunition", "clip", "mag", "magazine",
    "shell", "bullet", "round", "charge"
}
local MAX_AMMO = 9999

local function isAmmoName(name)
    local n = name:lower()
    for _, kw in ipairs(AMMO_KEYWORDS) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function watchValue(v)
    for _, already in ipairs(ammoValues) do
        if already == v then return end
    end
    table.insert(ammoValues, v)
    v.Value = MAX_AMMO
    -- как только игра потратит патрон — мгновенно возвращаем
    table.insert(ammoConns, v.Changed:Connect(function()
        if ammoEnabled and v.Value ~= MAX_AMMO then v.Value = MAX_AMMO end
    end))
end

local function watchTool(tool)
    if not tool:IsA("Tool") then return end
    -- значения внутри оружия
    for _, v in ipairs(tool:GetDescendants()) do
        if (v:IsA("IntValue") or v:IsA("NumberValue")) and isAmmoName(v.Name) then
            watchValue(v)
        end
    end
    -- атрибуты оружия
    for name in pairs(tool:GetAttributes()) do
        if type(tool:GetAttribute(name)) == "number" and isAmmoName(name) then
            tool:SetAttribute(name, MAX_AMMO)
            table.insert(ammoConns, tool:GetAttributeChangedSignal(name):Connect(function()
                if ammoEnabled and tool:GetAttribute(name) ~= MAX_AMMO then
                    tool:SetAttribute(name, MAX_AMMO)
                end
            end))
        end
    end
    -- новые значения, появляющиеся внутри оружия
    table.insert(ammoConns, tool.DescendantAdded:Connect(function(v)
        if ammoEnabled and (v:IsA("IntValue") or v:IsA("NumberValue")) and isAmmoName(v.Name) then
            task.wait(0.05)
            if v.Parent then watchValue(v) end
        end
    end))
end

local function scanContainer(container)
    table.insert(ammoConns, container.ChildAdded:Connect(function(t)
        if ammoEnabled then
            task.wait(0.1)
            if t.Parent then watchTool(t) end
        end
    end))
    for _, t in ipairs(container:GetChildren()) do
        watchTool(t)
    end
end

local function setAmmo(state)
    ammoEnabled = state
    for _, c in ipairs(ammoConns) do c:Disconnect() end
    table.clear(ammoConns)
    table.clear(ammoValues)

    if state then
        scanContainer(LocalPlayer.Backpack)
        if LocalPlayer.Character then scanContainer(LocalPlayer.Character) end
        table.insert(ammoConns, LocalPlayer.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            if ammoEnabled then scanContainer(c) end
        end))
    end
end

--================ FUN: FULLBRIGHT MAX ================--
local savedLighting = {}
local savedAtmo = nil
local fbCC = nil

local function applyFullbright(state)
    if state then
        savedLighting = {
            Brightness           = Lighting.Brightness,
            Ambient              = Lighting.Ambient,
            OutdoorAmbient       = Lighting.OutdoorAmbient,
            GlobalShadows        = Lighting.GlobalShadows,
            FogEnd               = Lighting.FogEnd,
            FogStart             = Lighting.FogStart,
            ExposureCompensation = Lighting.ExposureCompensation,
        }
        Lighting.Brightness     = 5
        Lighting.Ambient        = Color3.fromRGB(215, 215, 215)
        Lighting.OutdoorAmbient = Color3.fromRGB(215, 215, 215)
        Lighting.GlobalShadows  = false
        Lighting.FogEnd         = 1e6
        Lighting.FogStart       = 0
        Lighting.ExposureCompensation = 0.5

        savedAtmo = Lighting:FindFirstChildOfClass("Atmosphere")
        if savedAtmo then savedAtmo.Parent = nil end

        fbCC = Instance.new("ColorCorrectionEffect")
        fbCC.Name = "FB_Boost"
        fbCC.Brightness = 0.07
        fbCC.Contrast = 0.08
        fbCC.Saturation = 0.15
        fbCC.Parent = Lighting
    else
        for k, v in pairs(savedLighting) do Lighting[k] = v end
        if savedAtmo then savedAtmo.Parent = Lighting savedAtmo = nil end
        if fbCC then fbCC:Destroy() fbCC = nil end
    end
end

local savedTime = Lighting.ClockTime

local function applyDay(state)
    if state then
        savedTime = Lighting.ClockTime
        Lighting.ClockTime = 12
    else
        Lighting.ClockTime = savedTime
    end
end

