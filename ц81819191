--================ POOP: GOD MODE v2 ================--
local godEnabled = false
local godConns = {}

local function godApply(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.MaxHealth = 1e9
    hum.Health = 1e9
    hum.BreakJointsOnDeath = false
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) -- запрещаем состояние смерти
    end)
    -- мгновенный откат любого урона
    table.insert(godConns, RunService.Heartbeat:Connect(function()
        if godEnabled and hum.Parent and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end))
end

local function setGod(state)
    godEnabled = state
    for _, c in ipairs(godConns) do c:Disconnect() end
    table.clear(godConns)

    if state then
        if LocalPlayer.Character then godApply(LocalPlayer.Character) end
        table.insert(godConns, LocalPlayer.CharacterAdded:Connect(function(c)
            task.wait(0.3)
            if godEnabled then godApply(c) end
        end))
    else
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.MaxHealth = 100
            hum.Health = math.min(hum.Health, 100)
        end
    end
end

