--================ ESP ИГРОКОВ (ЗЕЛЁНЫЙ) ================--
local espEnabled = false
local espObjects = {}

local function addESP(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char then return end
    local old = espObjects[plr]
    if old and old.Parent == char then return end
    if old then old:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "HorrorESP"
    hl.FillColor = C_GREEN
    hl.OutlineColor = Color3.fromRGB(0, 140, 45)
    hl.FillTransparency = 0.5
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    espObjects[plr] = hl
end

local function removeESP(plr)
    if espObjects[plr] then espObjects[plr]:Destroy() espObjects[plr] = nil end
end

local function setESP(state)
    espEnabled = state
    for _, plr in ipairs(Players:GetPlayers()) do
        if state then addESP(plr) else removeESP(plr) end
    end
end

local function hookChar(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.6)
        if espEnabled then addESP(plr) end
    end)
end

Players.PlayerAdded:Connect(hookChar)
for _, plr in ipairs(Players:GetPlayers()) do hookChar(plr) end

--================ ESP МОНСТРОВ (СИНИЙ) ================--
local monstersEnabled = false
local monsterHighlights = {}

local MONSTER_KEYWORDS = {
    "monster", "entity", "demon", "ghost", "enemy",
    "npc", "creature", "boss", "mob", "wee", "rig", "doll"
}

local function isMonster(obj)
    if not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    if obj:FindFirstChildOfClass("Humanoid") then return true end
    local n = obj.Name:lower()
    for _, kw in ipairs(MONSTER_KEYWORDS) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function addMonsterESP(model)
    if monsterHighlights[model] and monsterHighlights[model].Parent == model then return end
    if monsterHighlights[model] then monsterHighlights[model]:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "HorrorMonsterESP"
    hl.FillColor = C_BLUE
    hl.OutlineColor = Color3.fromRGB(0, 60, 160)
    hl.FillTransparency = 0.45
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    monsterHighlights[model] = hl
end

local function removeMonsterESP(model)
    if monsterHighlights[model] then monsterHighlights[model]:Destroy() monsterHighlights[model] = nil end
end

local function setMonsterESP(state)
    monstersEnabled = state
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isMonster(obj) then addMonsterESP(obj) end
        end
    else
        for m in pairs(monsterHighlights) do removeMonsterESP(m) end
    end
end

--================ ESP ПРЕДМЕТОВ (ЖЁЛТЫЙ) ================--
local itemsEnabled = false
local itemHighlights = {}

local ITEM_KEYWORDS = {
    "item", "pickup", "battery", "ammo", "shell", "key",
    "medkit", "health", "food", "candle", "fuse", "valve"
}

local function isWorldItem(obj)
    if obj:IsA("Tool") then
        local par = obj.Parent
        if par and par:FindFirstChildOfClass("Humanoid") then return false end
        return true
    end
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then return false end
    local n = obj.Name:lower()
    for _, kw in ipairs(ITEM_KEYWORDS) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function addItemESP(obj)
    if itemHighlights[obj] and itemHighlights[obj].Parent == obj then return end
    if itemHighlights[obj] then itemHighlights[obj]:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "HorrorItemESP"
    hl.FillColor = C_YELLOW
    hl.OutlineColor = Color3.fromRGB(160, 110, 0)
    hl.FillTransparency = 0.4
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = obj
    itemHighlights[obj] = hl
end

local function removeItemESP(obj)
    if itemHighlights[obj] then itemHighlights[obj]:Destroy() itemHighlights[obj] = nil end
end

local function setItemESP(state)
    itemsEnabled = state
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isWorldItem(obj) then addItemESP(obj) end
        end
    else
        for o in pairs(itemHighlights) do removeItemESP(o) end
    end
end

