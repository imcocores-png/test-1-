local function enlargeIcon(img)
    if not img or not img.Parent then return false end
    if img:GetAttribute("EthBig") then return true end
    if not (img:IsA("ImageLabel") or img:IsA("ImageButton")) then return false end

    local gui = img:FindFirstAncestorOfClass("ScreenGui")
    if not gui then return false end

    local okW, w = pcall(function() return img.AbsoluteSize.X end)
    if not okW or w < 8 or w > 26 then return false end

    local okX, relX = pcall(function() return img.AbsolutePosition.X - gui.AbsolutePosition.X end)
    if not okX or relX < -30 or relX > 160 then return false end

    local p = img.Parent
    pcall(function()
        local pw = p.AbsoluteSize.X
        local ph = p.AbsoluteSize.Y
        if pw > 0 and ph > 0 then
            local cx = img.AbsolutePosition.X + img.AbsoluteSize.X / 2 - p.AbsolutePosition.X
            local cy = img.AbsolutePosition.Y + img.AbsoluteSize.Y / 2 - p.AbsolutePosition.Y
            img.AnchorPoint = Vector2.new(0.5, 0.5)
            img.Position = UDim2.new(cx / pw, 0, cy / ph, 0)
        end
        img.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
    end)
    img:SetAttribute("EthBig", true)
    return true
end

local function addBottomBars(gui)
    if UI.state.BarsAdded then return end

    local title
    for _, tl in ipairs(gui:GetDescendants()) do
        if tl:IsA("TextLabel") and tl.Text and tl.Text:lower():find("ethereal") then
            title = tl
            break
        end
    end
    if not title then return end

    local node = title.Parent
    local win
    while node and node ~= gui do
        if node:IsA("Frame") then
            local okSz, sz = pcall(function() return node.AbsoluteSize end)
            local hasCorner = node:FindFirstChildOfClass("UICorner") ~= nil
            if okSz and hasCorner and sz.X >= 300 and sz.Y >= 200 then
                win = node
                break
            end
        end
        node = node.Parent
    end
    if not win then return end
    UI.state.BarsAdded = true

    local holder = Instance.new("Frame")
    holder.Name = "EtherealBottomBars"
    holder.AnchorPoint = Vector2.new(0.5, 1)
    holder.Position = UDim2.new(0.5, 0, 1, 0)
    holder.Size = UDim2.new(1, 0, 0, 9)
    holder.BackgroundTransparency = 1
    holder.ZIndex = 100
    holder.Parent = win

    local bar1 = Instance.new("Frame")
    bar1.Name = "BarAccent"
    bar1.AnchorPoint = Vector2.new(0.5, 1)
    bar1.Position = UDim2.new(0.5, 0, 1, 0)
    bar1.Size = UDim2.new(1, 0, 0, 5)
    bar1.BackgroundColor3 = MOON
    bar1.BorderSizePixel = 0
    bar1.ZIndex = 101
    bar1.Parent = holder
    setCorner(bar1, UDim.new(0, 3))

    local bar2 = Instance.new("Frame")
    bar2.Name = "BarThin"
    bar2.AnchorPoint = Vector2.new(0.5, 1)
    bar2.Position = UDim2.new(0.5, 0, 1, -7)
    bar2.Size = UDim2.new(1, 0, 0, 2)
    bar2.BackgroundColor3 = Color3.fromRGB(95, 95, 102)
    bar2.BorderSizePixel = 0
    bar2.ZIndex = 101
    bar2.Parent = holder
end

task.spawn(function()
    for _ = 1, 10 do
        local gui = findGuiRoot()
        if gui then
            pcall(function()
                for _, obj in ipairs(gui:GetDescendants()) do
                    if obj:IsA("TextBox") then
                        local n = (obj.Name or ""):lower()
                        local ph = (obj.PlaceholderText or ""):lower()
                        if n:find("search") or ph:find("search") then
                            local target = obj
                            local p = obj.Parent
                            if p and p:IsA("GuiObject") and p.AbsoluteSize.X < 500 then
                                target = p
                            end
                            target.AnchorPoint = Vector2.new(1, 0.5)
                            target.Position = UDim2.new(1, -SEARCH_RIGHT_OFFSET, 0.5, 0)
                            target.Size = UDim2.new(0, SEARCH_WIDTH, target.Size.Y.Scale, target.Size.Y.Offset)
                        end
                    end
                end
            end)

            local iconsLeft = 0
            pcall(function()
                for _, obj in ipairs(gui:GetDescendants()) do
                    boldify(obj)
                    if (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
                        and not enlargeIcon(obj) then
                        local okW, w = pcall(function() return obj.AbsoluteSize.X end)
                        if okW and w >= 8 and w <= 26 then
                            iconsLeft += 1
                        end
                    end
                end
            end)

            pcall(function() addBottomBars(gui) end)

            if iconsLeft == 0 and UI.state.BarsAdded then break end
        end
        task.wait(1)
    end
end)

