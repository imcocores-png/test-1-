    UI.state.LoopLocOn    = false
    UI.state.SpawnLocOn   = false
    UI.state.BreakPlotOn  = false
    UI.state.Viewing      = false

    -- player features cleanup
    pcall(function()
        local hum = getChar() and getChar():FindFirstChildOfClass("Humanoid")
        local hrp = getChar() and getChar():FindFirstChild("HumanoidRootPart")
        if hum then
            hum.WalkSpeed = 16
            hum.UseJumpPower = true
            hum.JumpPower = 50
            hum.Sit = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if hrp then
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
            pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
        end
        local c = getChar()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then pcall(function() p.CanCollide = true end) end
            end
        end
        local cam = workspace.CurrentCamera
        if cam and hum then pcall(function() cam.CameraSubject = hum end) end
        if cam then pcall(function() cam.CameraType = Enum.CameraType.Custom end) end
    end)

    State.ThirdPerson = false
    if UI.state.TPUnload then pcall(UI.state.TPUnload) end
    if UI.state.ESPStop then pcall(UI.state.ESPStop) end
    if UI.state.PCLDStop then pcall(UI.state.PCLDStop) end

    -- connections
    pcall(function()
        if UI.state.WorkerConn then UI.state.WorkerConn:Disconnect() end
        if UI.state.Avatar3DSpin then UI.state.Avatar3DSpin:Disconnect() end
        if UI.state.SelUpdater then task.cancel(UI.state.SelUpdater) end
        if UI.state.TgtLeaveConn then UI.state.TgtLeaveConn:Disconnect() end
        if UI.state.InfJumpConn then UI.state.InfJumpConn:Disconnect() end
        if UI.state.SpawnConn then UI.state.SpawnConn:Disconnect() end
        if UI.state.LocFolderConn then UI.state.LocFolderConn:Disconnect() end
        if UI.state.dgConn then UI.state.dgConn:Disconnect() end
        for _, c in ipairs(UI.state.antiGrabConns or {}) do pcall(function() c:Disconnect() end) end
        for _, c in ipairs(UI.state.ragConns or {}) do pcall(function() c:Disconnect() end) end
        for _, c in ipairs(UI.state.UnloadConns or {}) do pcall(function() c:Disconnect() end) end
        if UI.state.flyConn then pcall(function() UI.state.flyConn:Disconnect() end) end
        if UI.state.roundConn then pcall(function() UI.state.roundConn:Disconnect() end) end
        if UI.state.tpConn then pcall(function() UI.state.tpConn:Disconnect() end) end
        if UI.state.tpHeart then pcall(function() UI.state.tpHeart:Disconnect() end) end
    end)

    pcall(function() workspace.FallenPartsDestroyHeight = -100 end)
    pcall(function() Obsidian:Unload() end)
    getgenv().ETHEREAL_UNLOAD = nil
end

