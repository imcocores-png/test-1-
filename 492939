            end,
        })

        gESP:AddToggle("ESPRainbow", {
            Text = "Rainbow ESP",
            Default = false,
            Callback = function(v) esp.rainbow = v end,
        })

        UI.state.ESPStop = stopESP
    end)

    --====================================================================--
    --  PCLD ESP: boxes on character location detectors                    --
    --====================================================================--
    pcall(function()
        local pcld = { on = false, rainbow = false, boxes = {}, conns = {} }

        local function isTarget(obj)
            if not obj:IsA("BasePart") then return false end
            local n = string.lower(obj.Name)
            return n == "partesp" or n == "playercharacterlocationdetector"
        end

        local function addBox(obj)
            if pcld.boxes[obj] then return end
            local box = Instance.new("BoxHandleAdornment")
            box.Adornee = obj
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Color3 = Color3.fromRGB(0, 255, 255)
            box.Transparency = 0.3
            box.Size = obj.Size
            local boxParent = game.CoreGui
            pcall(function()
                if typeof(gethui) == "function" then boxParent = gethui() end
            end)
            box.Parent = boxParent
            pcld.boxes[obj] = box

            local conn = obj.AncestryChanged:Connect(function(_, parent)
                if not parent and pcld.boxes[obj] then
                    pcall(function() pcld.boxes[obj]:Destroy() end)
                    pcld.boxes[obj] = nil
                end
            end)
            table.insert(pcld.conns, conn)
        end

        local function removeAll()
            for _, box in pairs(pcld.boxes) do
                if box then pcall(function() box:Destroy() end) end
            end
            pcld.boxes = {}
            for _, c in ipairs(pcld.conns) do pcall(function() c:Disconnect() end) end
            pcld.conns = {}
        end

        local function scan()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if pcld.on and isTarget(obj) then addBox(obj) end
            end
        end

        local gP = TabVisuals:AddRightGroupbox("PCLD ESP")

        gP:AddToggle("PCLDESP", {
            Text = "Enable PCLD ESP",
            Default = false,
            Callback = function(v)
                pcld.on = v
                if v then
                    scan()
                    local conn = workspace.DescendantAdded:Connect(function(obj)
                        if pcld.on and isTarget(obj) then addBox(obj) end
                    end)
                    table.insert(pcld.conns, conn)
                else
                    removeAll()
                end
            end,
        })

        gP:AddToggle("PCLDRainbow", {
            Text = "Rainbow PCLD",
            Default = false,
            Callback = function(v)
                pcld.rainbow = v
                task.spawn(function()
                    while pcld.rainbow do
                        local col = Color3.fromHSV(tick() % 1, 1, 1)
                        for _, box in pairs(pcld.boxes) do
                            pcall(function() box.Color3 = col end)
                        end
                        task.wait(0.05)
                    end
                end)
            end,
        })

        UI.state.PCLDStop = removeAll
    end)
end

--========================================================================--
--  MISC: BREAK SAFE ZONES (plots)                                          --
--========================================================================--
pcall(function()
    local StickyEvent = nil
    pcall(function()
        local pe = ReplicatedStorage:FindFirstChild("PlayerEvents")
            or ReplicatedStorage:WaitForChild("PlayerEvents", 5)
        StickyEvent = pe and pe:FindFirstChild("StickyPartEvent")
    end)

    local SpawnToyRF = nil
    pcall(function()
        local mt = ReplicatedStorage:FindFirstChild("MenuToys")
            or ReplicatedStorage:WaitForChild("MenuToys", 5)
        SpawnToyRF = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
    end)

    local CF_NAN  = CFrame.new(0 / 0, math.huge, 0 / 0)
    local CF_BIG  = CFrame.new(1099511627776, 1099511627776, 1099511627776)
    local CF_BIG2 = CFrame.new(1e45, math.huge, 1e98)

    local function plotIsIntact(area)
        local ok, p = pcall(function() return area.Position end)
        if not ok or not p then return false end
        if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return false end -- NaN check
        return p.Magnitude < 1e6
    end

    local function findUsableToy(exclude)
        local candidates = {}
        local mine = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if mine then
            for _, t in ipairs(mine:GetChildren()) do table.insert(candidates, t) end
        end
        local pi = workspace:FindFirstChild("PlotItems")
        if pi then
            for _, sub in ipairs(pi:GetChildren()) do
                if sub.Name ~= "PlayersInPlots" and (sub:IsA("Model") or sub:IsA("Folder")) then
                    for _, t in ipairs(sub:GetChildren()) do table.insert(candidates, t) end
                end
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            local f = workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
            if f then
                for _, t in ipairs(f:GetChildren()) do table.insert(candidates, t) end
            end
        end
        for _, t in ipairs(candidates) do
            if t ~= exclude and t.Parent and t:FindFirstChild("StickyPart") then
                return t
            end
        end
        return nil
    end

    local function spawnShuriken()
        if not SpawnToyRF then return nil end
        local hrp = getChar() and getChar():FindFirstChild("HumanoidRootPart")
        local cf = hrp and (hrp.CFrame * CFrame.new(0, 6, 0)) or CFrame.new(0, 60, 0)
        local ok, toy = pcall(function()
            return SpawnToyRF:InvokeServer("NinjaShuriken", cf, Vector3.zero)
        end)
        if ok and toy then return toy end
        return nil
    end

    local function stickyBreak(sticky, area)
        local sp = sticky and sticky:FindFirstChild("StickyPart")
        if not (sp and StickyEvent) then return false end
        local ok = pcall(function()
            if DestroyGrabRemote then
                local base = sticky:FindFirstChildOfClass("BasePart")
                if base then DestroyGrabRemote:FireServer(base) end
            end
            StickyEvent:FireServer(sp, area, CF_NAN)
        end)
        return ok
    end

    local function breakOnePlot(plot, area, usedToys)
        -- method 1: direct network ownership fling of the plot area
        pcall(function() if SetNetworkOwner then SetNetworkOwner:FireServer(area, CF_BIG) end end)
        pcall(function() if SetNetworkOwner then SetNetworkOwner:FireServer(area, CF_BIG2) end end)
        if not plotIsIntact(area) then return true end
        -- method 2: sticky toys with NaN CFrame (up to 2 per plot)
        for _ = 1, 2 do
            local sticky = findUsableToy(usedToys)
            if not sticky then
                sticky = spawnShuriken()
                if sticky then
                    local t0 = os.clock()
                    while sticky.Parent and os.clock() - t0 < 5 and not sticky:FindFirstChild("StickyPart") do
                        task.wait(0.1)
                    end
                end
            end
            if sticky and stickyBreak(sticky, area) then
                usedToys[sticky] = true
            end
            if not plotIsIntact(area) then return true end
        end
        return not plotIsIntact(area)
    end

    local function breakAllPlots()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then
            return 0, 0
        end
        local usedToys = {}
        local total, broken = 0, 0
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model") then
                local area = plot:FindFirstChild("PlotArea")
                if area and area:IsA("BasePart") then
                    total += 1
                    if breakOnePlot(plot, area, usedToys) then
                        broken += 1
                    end
                end
            end
        end
        -- local cleanup: remove own PlayersInPlots entry so items can be placed
        pcall(function()
            local pip = workspace.PlotItems
                and workspace.PlotItems:FindFirstChild("PlayersInPlots")
            local entry = pip and pip:FindFirstChild(LocalPlayer.Name)
            if entry then entry:Destroy() end
        end)
        return broken, total
    end

    local gPlot = TabMisc:AddLeftGroupbox("Break Plot", "hammer")

    local StatusLabel = gPlot:AddLabel("<font color=\"#888888\">Status: idle</font>")

    gPlot:AddToggle("BreakSafeZones", {
        Text = "Break Safe Zones (auto)",
        Default = false,
        Tooltip = "Keeps all plot safe zones broken: grab players and place items anywhere",
        Callback = function(v)
            UI.state.BreakPlotOn = v
            if v then
                UI.notify("Break Safe Zones: ON")
            else
                pcall(function() StatusLabel:SetText("<font color=\"#888888\">Status: idle</font>") end)
                UI.notify("Break Safe Zones: OFF")
            end
        end,
    })

    gPlot:AddButton({ Text = "Break All Plots Now", Func = function()
        task.spawn(function()
            local broken, total = breakAllPlots()
            if total == 0 then
                UI.notify("Break Plot: no plots found")
                return
            end
            pcall(function()
                StatusLabel:SetText("Status: <b>" .. broken .. "/" .. total .. "</b> plots broken")
            end)
            UI.notify("Break Plot: " .. broken .. "/" .. total .. " broken")
        end)
    end })

    -- auto re-break loop
    task.spawn(function()
        while UI.Alive do
            if UI.state.BreakPlotOn then
                local ok, broken, total = pcall(breakAllPlots)
                if ok and total > 0 then
                    pcall(function()
                        StatusLabel:SetText("Status: <b>" .. broken .. "/" .. total .. "</b> plots broken")
                    end)
                end
            end
            task.wait(5)
        end
    end)

    local gMiscInfo = TabMisc:AddRightGroupbox("Info")
    gMiscInfo:AddLabel("Break Plot = break safe zones")
    gMiscInfo:AddLabel("After breaking you can grab players")
    gMiscInfo:AddLabel("and place items inside any plot")
    gMiscInfo:AddLabel("Auto mode re-breaks every 5s")
end)

