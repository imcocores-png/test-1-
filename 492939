local function styleSlider(s)
    if not s then return end
    local base = s.Base or s.Bar
    local fill = s.Fill or s.Slider
    if base then
        pcall(function() base.BackgroundColor3 = Color3.fromRGB(40, 40, 46) end)
        setCorner(base, UDim.new(1, 0))
    end
    if fill then
        pcall(function() fill.BackgroundColor3 = MOON end)
        setCorner(fill, UDim.new(1, 0))
    end
    if (base or fill) and not UI.SliderElement then
        UI.SliderElement = base or fill
    end
end

