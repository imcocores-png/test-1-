local function setCorner(obj, radius)
    if not obj then return end
    pcall(function()
        local c = obj:FindFirstChildOfClass("UICorner")
        if not c then
            c = Instance.new("UICorner")
            c.Parent = obj
        end
        c.CornerRadius = radius
    end)
