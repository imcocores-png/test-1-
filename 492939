    UI.state.DGAnti       = false
    UI.state.FlyOn        = false
    UI.state.SpinOn       = false
    UI.state.NoclipOn     = false
    UI.state.WalkOn       = false
    UI.state.JumpOn       = false
    UI.state.Spectating   = false
