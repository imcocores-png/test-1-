        if Avatar3D.holder then return true end
        local ok = pcall(function()
            local holder = Instance.new("Frame")
            holder.Name = "EtherealAvatar3D"
            holder.Size = UDim2.new(1, 0, 0, 150)
            holder.BackgroundColor3 = Color3.fromRGB(10, 10, 13)
            holder.BorderSizePixel = 0
            holder.Parent = gProf.Container
            setCorner(holder, UDim.new(0, 8))
            local str = Instance.new("UIStroke")
            str.Color = Color3.fromRGB(45, 45, 52)
            str.Thickness = 1
            str.Parent = holder

            local vp = Instance.new("ViewportFrame")
            vp.Name = "VP"
            vp.Size = UDim2.fromScale(1, 1)
            vp.BackgroundTransparency = 1
            vp.Ambient = Color3.fromRGB(140, 140, 150)
            vp.LightColor = Color3.fromRGB(255, 255, 240)
            vp.LightDirection = Vector3.new(-0.4, -1, -0.6)
            vp.Parent = holder

            local world = Instance.new("WorldModel")
            world.Parent = vp

            local cam = Instance.new("Camera")
            cam.FieldOfView = 30
            cam.Parent = vp
            vp.CurrentCamera = cam

            Avatar3D.holder, Avatar3D.vp, Avatar3D.world, Avatar3D.cam = holder, vp, world, cam
        end)
        return ok and Avatar3D.vp ~= nil
    end

    local function clearAvatarClone()
        if Avatar3D.clone then
            pcall(function() Avatar3D.clone:Destroy() end)
            Avatar3D.clone = nil
        end
        Avatar3D.shownChar = nil
    end

    local function frameCameraOn(clone)
        local focusPart = clone:FindFirstChild("HumanoidRootPart")
            or clone:FindFirstChildWhichIsA("BasePart")
        if not (focusPart and Avatar3D.cam) then return end
        local focus = focusPart.Position + Vector3.new(0, 0.9, 0)
        Avatar3D.cam.CFrame = CFrame.lookAt(
            focus + Vector3.new(3.0, 1.4, 6.6),
            focus + Vector3.new(0, 0.25, 0)
        )
    end

    local function showAvatar3D(plr)
        if not buildAvatarHolder() then return end
        plr = plr or LocalPlayer
        Avatar3D.plr = plr
        if not plr.Parent then
            clearAvatarClone()
            return
        end
        local char = plr and plr.Character
        if not char or not char.Parent then return end -- respawn gap: keep last frame
        if Avatar3D.shownChar == char then return end

        clearAvatarClone()
        local clone
        pcall(function()
            local old = char.Archivable
            char.Archivable = true
            clone = char:Clone()
            char.Archivable = old
        end)
        if not clone then return end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BaseScript") or d:IsA("Script") or d:IsA("LocalScript") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = true
            elseif d:IsA("Humanoid") then
                d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            end
        end
        clone.Name = "AvatarClone"
        clone.Parent = Avatar3D.world
        Avatar3D.clone = clone
        Avatar3D.shownChar = char
        frameCameraOn(clone)
    end

    -- slow turntable rotation
    Avatar3D.spin = RunService.RenderStepped:Connect(function(dt)
        local clone = Avatar3D.clone
        if clone and clone.Parent then
            pcall(function()
                clone:PivotTo(clone:GetPivot() * CFrame.Angles(0, dt * 0.9, 0))
            end)
        end
    end)
