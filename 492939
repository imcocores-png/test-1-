do
    --====================================================================--
    --  PLAYER ESP: one RenderStepped loop (auto respawn / leave)          --
    --====================================================================--
    pcall(function()
        local esp = {
            on = false, rainbow = false,
            color = Color3.fromRGB(0, 255, 255),
            objects = {}, conn = nil,
        }

        local function destroyObj(obj)
            if obj.hl then pcall(function() obj.hl:Destroy() end) end
            if obj.bb then pcall(function() obj.bb:Destroy() end) end
            if obj.dbb then pcall(function() obj.dbb:Destroy() end) end
        end

        local function clearAll()
            for _, obj in pairs(esp.objects) do destroyObj(obj) end
            esp.objects = {}
        end

        local function ensureFor(plr)
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not (char and hrp) then return end
            local obj = esp.objects[plr]
            if obj and obj.char == char and obj.hl and obj.hl.Parent then return end
            if obj then destroyObj(obj) end

            local hl = Instance.new("Highlight")
            hl.Name = "EtherealESP"
            hl.Adornee = char
            hl.FillColor = esp.color
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            pcall(function() hl.Parent = char end)

            local bb = Instance.new("BillboardGui")
            bb.Name = "EtherealESPName"
            bb.Adornee = hrp
            bb.Size = UDim2.new(0, 220, 0, 26)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            pcall(function() bb.Parent = hrp end)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.BackgroundTransparency = 1
            lbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.TextStrokeTransparency = 0
            lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            lbl.Font = Enum.Font.GothamBold
            lbl.TextScaled = true
            lbl.Parent = bb

            local dbb = Instance.new("BillboardGui")
            dbb.Name = "EtherealESPDist"
            dbb.Adornee = hrp
            dbb.Size = UDim2.new(0, 110, 0, 20)
            dbb.StudsOffset = Vector3.new(0, -2.4, 0)
            dbb.AlwaysOnTop = true
            pcall(function() dbb.Parent = hrp end)

            local dlbl = Instance.new("TextLabel")
            dlbl.Size = UDim2.fromScale(1, 1)
            dlbl.BackgroundTransparency = 1
            dlbl.Text = ""
            dlbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            dlbl.TextStrokeTransparency = 0
            dlbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            dlbl.Font = Enum.Font.GothamBold
            dlbl.TextScaled = true
            dlbl.Parent = dbb

            esp.objects[plr] = { char = char, hl = hl, bb = bb, dbb = dbb, dlbl = dlbl }
        end

        local function startESP()
            if esp.conn then return end
            esp.conn = RunService.RenderStepped:Connect(function()
                if esp.rainbow then
                    esp.color = Color3.fromHSV(tick() % 1, 1, 1)
                end
                local lhrp = getChar() and getChar():FindFirstChild("HumanoidRootPart")
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        ensureFor(plr)
                    end
                end
                for plr, obj in pairs(esp.objects) do
                    if not plr.Parent or not plr.Character then
                        destroyObj(obj)
                        esp.objects[plr] = nil
                    else
                        if obj.hl then pcall(function() obj.hl.FillColor = esp.color end) end
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and lhrp and obj.dlbl then
                            local d = math.floor((hrp.Position - lhrp.Position).Magnitude)
                            pcall(function() obj.dlbl.Text = d .. " studs" end)
                        end
                    end
                end
            end)
        end

        local function stopESP()
            if esp.conn then
                pcall(function() esp.conn:Disconnect() end)
                esp.conn = nil
            end
            clearAll()
        end

        local gESP = TabVisuals:AddLeftGroupbox("Player ESP")

        gESP:AddToggle("PlayerESP", {
