-- ====================== ANTI GRAB V2 (УЛУЧШЕННЫЙ, ВСЁ-В-ОДНОМ) ======================
local ag2Enabled = false
local ag2Conns = {}

local function stopAG2Conns()
    for _, c in ipairs(ag2Conns) do pcall(function() c:Disconnect() end) end
    ag2Conns = {}
end

local function StartAG2()
    local char = LocalPlayer.Character
    local BeingHeld = LocalPlayer:FindFirstChild("IsHeld")
    if not (char and BeingHeld) then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not (hrp and hum and head) then return end

    -- ОСНОВНОЙ ЗАЩИТНЫЙ ЦИКЛ (запускается пока нас держат)
    local function engageDefense()
        if not ag2Enabled then return end

        -- Collision Ghosting
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        -- LOOP 1: серверная защита (Struggle + Ragdoll + StopAllVelocity)
        task.spawn(function()
            while ag2Enabled and BeingHeld.Value do
                pcall(function()
                    ReplicatedStorage.CharacterEvents.Struggle:FireServer()
                    ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                    local gce = ReplicatedStorage:FindFirstChild("GameCorrectionEvents")
                    if gce then
                        local sav = gce:FindFirstChild("StopAllVelocity")
                        if sav then sav:FireServer() end
                    end
                end)
                task.wait()
            end
        end)

        -- LOOP 2: физика (анкор + вертикальная стабильность + состояние)
        task.spawn(function()
            while ag2Enabled and BeingHeld.Value do
                pcall(function()
                    hum.Sit = false
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    if hrp then
                        hrp.Anchored = true
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end)
                task.wait()
            end
            if hrp then hrp.Anchored = false end
            -- вернуть коллизии
            if char and char.Parent then
                pcall(function()
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = true end
                    end
                end)
            end
        end)

        -- LOOP 3: ходьба при захвате (MoveDirection из XOCO)
        task.spawn(function()
            while ag2Enabled and BeingHeld.Value do
                pcall(function()
                    if hrp and hum then
                        hrp.CFrame = hrp.CFrame + hum.MoveDirection * 0.43
                    end
                end)
                task.wait()
            end
        end)
    end

    -- Ватчер 1: IsHeld
    table.insert(ag2Conns, BeingHeld:GetPropertyChangedSignal("Value"):Connect(function()
        if BeingHeld.Value and ag2Enabled then
            engageDefense()
        end
    end))

    -- Ватчер 2: PartOwner на голове
    table.insert(ag2Conns, head.ChildAdded:Connect(function(obj)
        if obj.Name == "PartOwner" and ag2Enabled then
            pcall(function()
                ReplicatedStorage.CharacterEvents.Struggle:FireServer(LocalPlayer)
            end)
            task.spawn(function()
                while ag2Enabled and head:FindFirstChild("PartOwner") do
                    pcall(function()
                        ReplicatedStorage.CharacterEvents.Struggle:FireServer(LocalPlayer)
                        ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0)
                    end)
                    task.wait()
                end
            end)
        end
    end))

    -- Если уже держат при включении — сразу защита
    if BeingHeld.Value or head:FindFirstChild("PartOwner") then
        engageDefense()
    end
end

