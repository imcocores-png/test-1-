-- ====================== ANTI RAGDOLL (УЛУЧШЕННЫЙ + WELDHRP ФИКС) ======================
local arEnabled = false
local arConns = {}

local function stopARConns()
    for _, c in ipairs(arConns) do pcall(function() c:Disconnect() end) end
    arConns = {}
end

local function applyAntiRagdoll(char)
    if not char or not arEnabled then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local head = char:WaitForChild("Head", 5)
        if not (hum and hrp and head) then return end
        local ragVal = hum:WaitForChild("Ragdolled", 5)

        -- отключение констрейнтов рэгдолла
        local function disableConstraints()
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                    v.BallSocketConstraint.Enabled = false
                    if v:FindFirstChild("RagdollLimbPart") then
                        v.RagdollLimbPart.WeldConstraint.Enabled = false
                    end
                end
            end
        end

        disableConstraints()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        -- Ватчер 1: флаг Ragdolled
        if ragVal then
            table.insert(arConns, ragVal.Changed:Connect(function()
                if ragVal.Value and arEnabled then
                    task.spawn(function()
                        disableConstraints()
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
            end))
        end

        -- Ватчер 2: WeldHRP (фикс головы при рэгдолле — из XOCO BEST)
        local weldHRP = hrp:WaitForChild("WeldHRP", 5)
        if weldHRP then
            table.insert(arConns, weldHRP.Changed:Connect(function()
                if weldHRP.Enabled and arEnabled then
                    task.spawn(function()
                        hum.AutoRotate = true
                        hum.HipHeight = 1
                        while weldHRP.Enabled and arEnabled and hrp.Parent do
                            pcall(function()
                                head.CFrame = hrp.CFrame + Vector3.new(0, 1.35, 0)
                            end)
                            task.wait()
                        end
                        if hum and hum.Parent then
                            hum.HipHeight = 0
                        end
                    end)
                end
            end))
        end
    end)
end

