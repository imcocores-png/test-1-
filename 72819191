task.delay(3, function()
    pcall(function()
        local root = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        for _, g in ipairs(root:GetChildren()) do
            if g:IsA("ScreenGui") and g.Name:lower():find("obsidian") then
                for _, obj in ipairs(g:GetDescendants()) do
                    pcall(function()
                        if obj:IsA("Frame") then
                            local y = obj.AbsoluteSize.Y
                            local x = obj.AbsoluteSize.X
                            if y >= 4 and y <= 16 and x >= 60 then
                                local c = Instance.new("UICorner")
                                c.CornerRadius = UDim.new(1, 0)
                                c.Parent = obj
                            elseif y >= 24 and y <= 40 and x >= 80 then
                                local c = Instance.new("UICorner")
                                c.CornerRadius = UDim.new(0, 8)
                                c.Parent = obj
                            end
                        end
                        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                            local s = obj.Size
                            if s.X.Offset >= 12 and s.X.Offset <= 30
                                and s.Y.Offset >= 12 and s.Y.Offset <= 30 then
                                obj.Size = UDim2.fromOffset(s.X.Offset + 10, s.Y.Offset + 10)
                            end
                        end
                    end)
                end
            end
        end
    end)
