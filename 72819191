local Platform = {
    IsMobile = false,
    IsTouch  = false,
    IsPhone  = false,
}

do
    --// Детект мобильного устройства //--
    pcall(function()
        if UserInputService.TouchEnabled
           and not UserInputService.MouseEnabled
           and not UserInputService.KeyboardEnabled then
            Platform.IsMobile = true
            Platform.IsTouch  = true
        end
        --// Доп. проверка: маленький экран //--
        local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize
        if vp and vp.Y < 600 then
            Platform.IsPhone = true
        end
        --// GuiService также помогает //--
        if UserInputService.TouchEnabled then
            Platform.IsTouch = true
            --// На телефоне мышь не нужна — считаем мобильным //--
            Platform.IsMobile = true
        end
    end)
end

--// Универсальный notify (работает и на Дельте, и на мобиле) //--
