--========================================================================--
--  GRAB KICK v25                                                           --
--  Умное владение + Create/Destroy линий + Struggle-спам + CFrame-дребезг --
--========================================================================--
local Kick = {
    Enabled = false,
    SavedPos = nil,
    HoldHeight = 20,
    Twitch = true,
}

local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
local SetNetworkOwner = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
local DestroyGrabLine = GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine")
local CreateGrabLine  = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")

local CharacterEvents = ReplicatedStorage:FindFirstChild("CharacterEvents")
local Struggle = CharacterEvents and CharacterEvents:FindFirstChild("Struggle")

local function setNetworkOwner(part)
    pcall(function()
        SetNetworkOwner:FireServer(part, part.CFrame)
    end)
end

local function destroyGrabLine(part)
    pcall(function()
        DestroyGrabLine:FireServer(part)
    end)
end

local function weOwn(part)
    if not part or not part.Parent then return false end
    local po = part:FindFirstChild("PartOwner")
    return po ~= nil
end

local function attachKickAlign(hrp)
    if hrp:FindFirstChild("KickAlign") then return end
    local oldBp = hrp:FindFirstChildOfClass("BodyPosition")
    if oldBp then oldBp:Destroy() end

    local att0 = Instance.new("Attachment")
    att0.Name = "KickAtt0"
    att0.Parent = hrp

    local att1 = Instance.new("Attachment")
    att1.Name = "KickAtt1"
    att1.Parent = workspace.Terrain

    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "KickAlign"
    alignPos.Attachment0 = att0
    alignPos.Attachment1 = att1
    alignPos.MaxForce = math.huge
    alignPos.Responsiveness = 250
    alignPos.Parent = hrp

    local alignRot = Instance.new("AlignOrientation")
    alignRot.Name = "KickRot"
    alignRot.Attachment0 = att0
    alignRot.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignRot.CFrame = CFrame.new()
    alignRot.MaxTorque = math.huge
    alignRot.Responsiveness = 200
    alignRot.Parent = hrp
end

local function detachKickAlign(char)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local align = hrp:FindFirstChild("KickAlign")
    if align then
        if align.Attachment1 then align.Attachment1:Destroy() end
        align:Destroy()
    end
    local rot = hrp:FindFirstChild("KickRot")
    if rot then rot:Destroy() end
    local att0 = hrp:FindFirstChild("KickAtt0")
    if att0 then att0:Destroy() end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum.Sit = false
        hum.AutoRotate = true
    end
    destroyGrabLine(hrp)
end

local function kickLoop()
    task.spawn(function()
        local target = Players:FindFirstChild(State.SelectedName or "")
        if not target or not target.Parent then
            Kick.Enabled = false
            UI.notify("Цель не выбрана")
            return
        end

        local myChar = getChar()
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not (myChar and myHRP) then
            Kick.Enabled = false
            return
        end

        Kick.SavedPos = myHRP.CFrame
        local fetched = false
        local ownCheck = 0

        local burstOn = 0
        local burstOff = 0
        local phase = true
        local step = 0

        while Kick.Enabled and RunService.Heartbeat:Wait() do
            target = Players:FindFirstChild(State.SelectedName or "")
            if not target or not target.Parent then break end

            myChar = getChar()
            myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myHead = myChar and myChar:FindFirstChild("Head")

            local tChar = target.Character
            local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

            if not (myChar and myHRP and myHead) or not (tHRP and tHum) or tHum.Health <= 0 then
                continue
            end

            local dist = (tHRP.Position - myHRP.Position).Magnitude

            if dist > 30 then
                pcall(function()
                    myChar:PivotTo(tHRP.CFrame * CFrame.new(0, 2, 4))
                end)
                setNetworkOwner(tHRP)
                attachKickAlign(tHRP)
                fetched = true
            else
                if not fetched then
                    fetched = true
                    attachKickAlign(tHRP)
                    pcall(function()
                        myChar:PivotTo(Kick.SavedPos)
                        tHRP.CFrame = Kick.SavedPos * CFrame.new(0, Kick.HoldHeight, 0)
                    end)
                end

                local holdPos = myHead.Position + Vector3.new(0, Kick.HoldHeight, 0)
                local align = tHRP:FindFirstChild("KickAlign")
                if align and align.Attachment1 then
                    align.Attachment1.WorldPosition = holdPos
                end
                local rot = tHRP:FindFirstChild("KickRot")
                if rot then rot.CFrame = CFrame.Angles(0, 0, 0) end

                pcall(function()
                    tHRP.AssemblyLinearVelocity = Vector3.zero
                    tHRP.AssemblyAngularVelocity = Vector3.zero
                    tHum.PlatformStand = true
                end)

                pcall(function()
                    tHum.Sit = true
                    tHum.AutoRotate = false
                end)

                ownCheck += 1
                if ownCheck % 6 == 0 then
                    if not weOwn(tHRP) then
                        setNetworkOwner(tHRP)
                    end
                end

                if phase then
                    step += 1
                    local s = step % 3
                    if s == 1 then
                        pcall(function()
                            CreateGrabLine:FireServer(tHRP, CFrame.new(holdPos))
                        end)
                    elseif s == 2 then
                        destroyGrabLine(tHRP)
                    else
                        setNetworkOwner(tHRP)
                    end

                    if Struggle and step % 2 == 0 then
                        pcall(function() Struggle:FireServer() end)
                    end

                    if Kick.Twitch then
                        pcall(function()
                            tHRP.CFrame = CFrame.new(tHRP.Position)
                                * CFrame.Angles(
                                    (math.random() - 0.5) * 0.5,
                                    (math.random() - 0.5) * 0.5,
                                    (math.random() - 0.5) * 0.5
                                )
                        end)
                    end

                    burstOn += 1
                    if burstOn >= 8 then
                        phase = false
                        burstOn = 0
                        burstOff = 0
                    end
                else
                    burstOff += 1
                    if burstOff == 2 then
                        setNetworkOwner(tHRP)
                    end
                    if burstOff >= 3 then
                        phase = true
                        step = 0
                    end
                end
            end
        end

        if target and target.Character then
            detachKickAlign(target.Character)
        end
        pcall(function()
            local ch = getChar()
            if ch and Kick.SavedPos then ch:PivotTo(Kick.SavedPos) end
        end)
        Kick.Enabled = false
    end)
end

