--========================================================================--
--  PLAYER                                                                  --
--  Movement + Fly + Cosmetics + Server Players  (source: rr9)             --
--========================================================================--
pcall(function()
    local HttpService = game:GetService("HttpService")

    --// Состояние модуля Player //--
    local PlayerMod = {
        WalkspeedEnabled = false,
        WalkspeedValue   = 16,
        InfJump          = false,
        NoClip           = false,
        NoClipConn       = nil,
        FlyEnabled       = false,
        FlySpeed         = 120,
        FlyConn          = nil,
        FlyVelocity      = nil,
        FlyGyro          = nil,
        CosmeticsEnabled = false,
        CosmeticChoice   = "Both",
        RespawnPersist   = false,
        SavedHeadData    = nil,
    }

    --====================================================================--
    --  MOVEMENT                                                          --
    --====================================================================--
    local gMove = TabPlayer:AddLeftGroupbox("Movement")

    gMove:AddToggle("Walkspeed", {
        Text = "Walkspeed",
        Default = false,
        Callback = function(v) PlayerMod.WalkspeedEnabled = v end,
    })

    gMove:AddSlider("WalkspeedValue", {
        Text = "Speed",
        Default = 16, Min = 0, Max = 500, Rounding = 0,
        Callback = function(v) PlayerMod.WalkspeedValue = v end,
    })

    gMove:AddToggle("InfiniteJump", {
        Text = "Infinite Jump",
        Default = false,
        Callback = function(v) PlayerMod.InfJump = v end,
    })

    gMove:AddToggle("NoClip", {
        Text = "No Clip",
        Default = false,
        Callback = function(v)
            PlayerMod.NoClip = v
            if PlayerMod.NoClipConn then
                PlayerMod.NoClipConn:Disconnect()
                PlayerMod.NoClipConn = nil
            end
            if v then
                PlayerMod.NoClipConn = RunService.Stepped:Connect(function()
                    local char = getChar()
                    if not char then return end
                    --// Оптимизация: проверяем только основные части тела, не всех потомков //--
                    for _, name in ipairs({"Head","Torso","HumanoidRootPart","Left Arm","Right Arm","Left Leg","Right Leg","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftHand","RightHand","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot"}) do
                        local part = char:FindFirstChild(name)
                        if part and part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end)
            end
        end,
    })

    --// Walkspeed применение //--
    RunService.RenderStepped:Connect(function()
        if not PlayerMod.WalkspeedEnabled then return end
        local char = getChar()
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        local dir = hum.MoveDirection
        if dir.Magnitude > 0 then
            root.AssemblyLinearVelocity = Vector3.new(
                dir.Unit.X * PlayerMod.WalkspeedValue,
                root.AssemblyLinearVelocity.Y,
                dir.Unit.Z * PlayerMod.WalkspeedValue
            )
        end
    end)

    --// Infinite Jump //--
    UserInputService.JumpRequest:Connect(function()
        if not PlayerMod.InfJump then return end
        local char = getChar()
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    --====================================================================--
    --  FLY                                                               --
    --====================================================================--
    local gFly = TabPlayer:AddLeftGroupbox("Fly")

    local function stopFly()
        if PlayerMod.FlyConn then
            PlayerMod.FlyConn:Disconnect()
            PlayerMod.FlyConn = nil
        end
        if PlayerMod.FlyVelocity then PlayerMod.FlyVelocity:Destroy() end
        if PlayerMod.FlyGyro then PlayerMod.FlyGyro:Destroy() end
        PlayerMod.FlyVelocity = nil
        PlayerMod.FlyGyro = nil
        local char = getChar()
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function startFly()
        stopFly()
        if not PlayerMod.FlyEnabled then return end
        PlayerMod.FlyConn = RunService.RenderStepped:Connect(function()
            local char = getChar()
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root then return end
            local controlPart = (hum.Sit and hum.SeatPart and hum.SeatPart.AssemblyRootPart) or root
            if not PlayerMod.FlyVelocity or PlayerMod.FlyVelocity.Parent ~= controlPart then
                if PlayerMod.FlyVelocity then PlayerMod.FlyVelocity:Destroy() end
                PlayerMod.FlyVelocity = Instance.new("BodyVelocity")
                PlayerMod.FlyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                PlayerMod.FlyVelocity.Parent = controlPart
            end
            if not PlayerMod.FlyGyro or PlayerMod.FlyGyro.Parent ~= controlPart then
                if PlayerMod.FlyGyro then PlayerMod.FlyGyro:Destroy() end
                PlayerMod.FlyGyro = Instance.new("BodyGyro")
                PlayerMod.FlyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                PlayerMod.FlyGyro.D = 100
                PlayerMod.FlyGyro.Parent = controlPart
            end
            local move = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move + Vector3.new(0, -1, 0) end
            local camCF = workspace.CurrentCamera.CFrame
            local speed = PlayerMod.FlySpeed or 120
            if move.Magnitude > 0 then
                PlayerMod.FlyVelocity.Velocity = (camCF.LookVector * -move.Z + camCF.RightVector * move.X + Vector3.new(0, move.Y, 0)) * speed
            else
                PlayerMod.FlyVelocity.Velocity = Vector3.zero
            end
            PlayerMod.FlyGyro.CFrame = CFrame.new(controlPart.Position, controlPart.Position + camCF.LookVector)
            hum.PlatformStand = not hum.Sit
        end)
    end

    gFly:AddToggle("FlyToggle", {
        Text = "Fly",
        Default = false,
        Callback = function(v)
            PlayerMod.FlyEnabled = v
            if v then startFly() else stopFly() end
        end,
    })

    gFly:AddSlider("FlySpeed", {
        Text = "Fly Speed",
        Default = 120, Min = 1, Max = 1000, Rounding = 0,
        Callback = function(v) PlayerMod.FlySpeed = v end,
    })

    --====================================================================--
    --  COSMETICS (Headless / Korblox)                                    --
    --====================================================================--
    local gCosm = TabPlayer:AddRightGroupbox("Cosmetics")

    local KORBLOX_MESH  = "101851696"
    local KORBLOX_TEX   = "101851254"
    local HEADLESS_MESH = "134082579"
    local HEADLESS_TEX  = "134082627"

    local function snapshotHead()
        local char = getChar()
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        PlayerMod.SavedHeadData = {
            Transparency = head.Transparency,
            BrickColor = head.BrickColor,
            Material = head.Material,
            Meshes = {},
            Decals = {},
        }
        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("SpecialMesh") then
                table.insert(PlayerMod.SavedHeadData.Meshes, {
                    MeshType = obj.MeshType, MeshId = obj.MeshId,
                    TextureId = obj.TextureId, Scale = obj.Scale,
                    Offset = obj.Offset, VertexColor = obj.VertexColor, Name = obj.Name,
                })
            elseif obj:IsA("Decal") then
                table.insert(PlayerMod.SavedHeadData.Decals, {
                    Texture = obj.Texture, Face = obj.Face,
                    Transparency = obj.Transparency, Name = obj.Name,
                })
            end
        end
    end

    local function wearHeadless()
        local char = getChar()
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        snapshotHead()
        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("Decal") or obj:IsA("SpecialMesh") then obj:Destroy() end
        end
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. HEADLESS_MESH
        mesh.TextureId = "rbxassetid://" .. HEADLESS_TEX
        mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
        mesh.Name = "PhantomHeadlessMesh"
        mesh.Parent = head
        head.Transparency = 0.1
        head.BrickColor = BrickColor.new("Really black")
        head.Material = Enum.Material.Plastic
    end

    local function wearKorblox()
        local char = getChar()
        local rleg = char and (char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg"))
        if not rleg then return end
        local old = char:FindFirstChild("PhantomKorbloxLeg")
        if old then old:Destroy() end
        local fakeLeg = Instance.new("Part")
        fakeLeg.Name = "PhantomKorbloxLeg"
        fakeLeg.Size = rleg.Size
        fakeLeg.CFrame = rleg.CFrame
        fakeLeg.Anchored = false
        fakeLeg.CanCollide = false
        fakeLeg.Transparency = 0
        fakeLeg.BrickColor = BrickColor.new("Really black")
        fakeLeg.Material = Enum.Material.Plastic
        fakeLeg.Parent = char
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. KORBLOX_MESH
        mesh.TextureId = "rbxassetid://" .. KORBLOX_TEX
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = fakeLeg
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rleg; weld.Part1 = fakeLeg; weld.Parent = rleg
        rleg.Transparency = 1
    end

    local function applyCosmetics()
        local char = getChar()
        if not char then return end
        if PlayerMod.CosmeticChoice == "Headless" then wearHeadless()
        elseif PlayerMod.CosmeticChoice == "Korblox" then wearKorblox()
        elseif PlayerMod.CosmeticChoice == "Both" then wearHeadless(); wearKorblox() end
    end

    local function stripCosmetics()
        local char = getChar()
        if not char then return end
        local head = char:FindFirstChild("Head")
        if head then
            local m = head:FindFirstChild("PhantomHeadlessMesh")
            if m then m:Destroy() end
            if PlayerMod.SavedHeadData then
                head.Transparency = PlayerMod.SavedHeadData.Transparency
                head.BrickColor = PlayerMod.SavedHeadData.BrickColor
                head.Material = PlayerMod.SavedHeadData.Material
                for _, m2 in ipairs(PlayerMod.SavedHeadData.Meshes) do
                    local nm = Instance.new("SpecialMesh")
                    nm.MeshType = m2.MeshType; nm.MeshId = m2.MeshId
                    nm.TextureId = m2.TextureId; nm.Scale = m2.Scale
                    nm.Offset = m2.Offset; nm.VertexColor = m2.VertexColor
                    nm.Name = m2.Name; nm.Parent = head
                end
                for _, d in ipairs(PlayerMod.SavedHeadData.Decals) do
                    local decal = Instance.new("Decal")
                    decal.Texture = d.Texture; decal.Face = d.Face
                    decal.Transparency = d.Transparency; decal.Name = d.Name
                    decal.Parent = head
                end
                PlayerMod.SavedHeadData = nil
            else
                head.Transparency = 0
            end
        end
        local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        if rleg then
            rleg.Transparency = 0
            local w = rleg:FindFirstChildOfClass("WeldConstraint")
            if w then w:Destroy() end
        end
        local fl = char:FindFirstChild("PhantomKorbloxLeg")
        if fl then fl:Destroy() end
    end

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        PlayerMod.SavedHeadData = nil
        if PlayerMod.CosmeticsEnabled and PlayerMod.RespawnPersist then
            applyCosmetics()
        end
    end)

    gCosm:AddToggle("CosmeticsEnable", {
        Text = "Включить косметику",
        Default = false,
        Callback = function(v)
            PlayerMod.CosmeticsEnabled = v
            if v then applyCosmetics() else stripCosmetics() end
        end,
    })

    gCosm:AddDropdown("CosmeticType", {
        Text = "Стиль",
        Values = {"Headless", "Korblox", "Both"},
        Default = "Both",
        Callback = function(v)
            PlayerMod.CosmeticChoice = v
            if PlayerMod.CosmeticsEnabled then
                stripCosmetics()
                applyCosmetics()
            end
        end,
    })

    gCosm:AddToggle("CosmeticsRespawn", {
        Text = "Переустанавливать при респавне",
        Default = false,
        Callback = function(v) PlayerMod.RespawnPersist = v end,
    })

    --====================================================================--
    --  SERVER PLAYERS                                                    --
    --====================================================================--
    local gServer = TabPlayer:AddRightGroupbox("Server Players")

    local plrNames = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(plrNames, p.DisplayName .. " (@" .. p.Name .. ")")
        end
    end
    if #plrNames == 0 then plrNames = {"-"} end

    local plrDrop = gServer:AddDropdown("PlayerList", {
        Text = "Игрок",
        Values = plrNames,
        Multi = false,
        Callback = function() end,
    })

    local function refreshPlrList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(list, p.DisplayName .. " (@" .. p.Name .. ")")
            end
        end
        if #list == 0 then list = {"-"} end
        pcall(function() plrDrop:SetValues(list) end)
    end

    --// Оптимизация: debounce обновления списка игроков //--
    local refreshDebounced = nil
    local function scheduleRefresh()
        if refreshDebounced then return end
        refreshDebounced = task.delay(0.3, function()
            refreshDebounced = nil
            refreshPlrList()
        end)
    end

    Players.PlayerAdded:Connect(scheduleRefresh)
    Players.PlayerRemoving:Connect(scheduleRefresh)

    gServer:AddButton({
        Text = "Скопировать профиль",
        Func = function()
            local sel = plrDrop and plrDrop.Value
            if not sel or sel == "-" then UI.notify("Игрок не выбран"); return end
            local username = sel:match("@(.+)%)$") or sel
            local target = Players:FindFirstChild(username)
