getgenv().ETHEREAL_UNLOAD = function()
    Kick.Enabled = false
    if UI.state then
        UI.state.AntiBanana = false
        UI.state.AntiSnowball = false
        UI.state.AntiBlob = false
    end
    local t = State.SelectedName and Players:FindFirstChild(State.SelectedName)
    if t and t.Character then pcall(detachKickAlign, t.Character) end
    pcall(function() workspace.FallenPartsDestroyHeight = -100 end)
    local s = State.SavedCam
    if s then
        pcall(function()
            LocalPlayer.CameraMode = s.Mode
            LocalPlayer.CameraMinZoomDistance = s.Min
            LocalPlayer.CameraMaxZoomDistance = s.Max
        end)
    end
    --// Cleanup визуалов: шапочка + скайбокс //--
    pcall(function()
        if UI.removeHat and LocalPlayer.Character then UI.removeHat(LocalPlayer.Character) end
        if UI.restoreDefaultSky then UI.restoreDefaultSky() end
    end)
    --// Cleanup Player модуля: Fly + NoClip + Cosmetics //--
    pcall(function()
        if UI.stopFly then UI.stopFly() end
        if UI.PlayerMod then
            UI.PlayerMod.FlyEnabled = false
            UI.PlayerMod.NoClip = false
            UI.PlayerMod.WalkspeedEnabled = false
            UI.PlayerMod.InfJump = false
            if UI.PlayerMod.NoClipConn then
                UI.PlayerMod.NoClipConn:Disconnect()
                UI.PlayerMod.NoClipConn = nil
            end
            UI.PlayerMod.CosmeticsEnabled = false
        end
        if UI.stripCosmetics then UI.stripCosmetics() end
    end)
    --// Cleanup мобильной кнопки //--
    pcall(function()
        if MobileToggleBtn then MobileToggleBtn:Destroy() end
    end)
    --// Cleanup оптимизации //--
    pcall(function()
        if UI.OptState and UI.OptState.LowFPSCheckConn then
            UI.OptState.LowFPSCheckConn:Disconnect()
            UI.OptState.LowFPSCheckConn = nil
        end
    end)
    pcall(function() Obsidian:Unload() end)
    getgenv().ETHEREAL_UNLOAD = nil
end

