    --// Шапочка (source: XOCU) //--
    local function removeHat(c)
        local h = Vis.HatParts[c]
        if h then h:Destroy(); Vis.HatParts[c] = nil end
    end

    local function addHat(c)
        task.wait(0.1)
        local head = c and c:FindFirstChild("Head")
        if not head then return end
        removeHat(c)
        local hat = Instance.new("Part")
        hat.Name = "Hat"
        hat.Transparency = Vis.HatTransparency
        hat.Color = Vis.HatColor
        hat.Material = Enum.Material.Neon
        hat.CanCollide = false; hat.CanTouch = false; hat.CanQuery = false; hat.Massless = true
        local m = Instance.new("SpecialMesh")
        m.MeshId = "rbxassetid://1033714"
        m.Scale = Vector3.new(2.4, 1.6, 2.4)
        m.Parent = hat
        local w = Instance.new("WeldConstraint")
        w.Part0 = head; w.Part1 = hat; w.Parent = hat
        hat.CFrame = head.CFrame * CFrame.new(0, 1.1, 0)
        hat.Parent = c
        Vis.HatParts[c] = hat
    end

    local function updateHats()
        for c, h in pairs(Vis.HatParts) do
            if h and h.Parent and c == LocalPlayer.Character then
                h.Transparency = Vis.HatTransparency
                h.Color = Vis.HatRainbow and Color3.fromHSV((tick() % 5) / 5, 1, 1) or Vis.HatColor
            end
        end
    end

    --// Скайбокс функции (source: rr9) //--
    local function applySkybox(name)
        local s = Vis.SkyboxAssets[name]
        if not s then return end
        local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
        sky.Name = "Sky"
        sky.SkyboxBk = s.Bk; sky.SkyboxDn = s.Dn; sky.SkyboxFt = s.Ft
        sky.SkyboxLf = s.Lf; sky.SkyboxRt = s.Rt; sky.SkyboxUp = s.Up
    end

    local function restoreDefaultSky()
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if sky and Vis.DefaultSkySettings.SkyboxBk then
            sky.SkyboxBk = Vis.DefaultSkySettings.SkyboxBk
            sky.SkyboxDn = Vis.DefaultSkySettings.SkyboxDn
            sky.SkyboxFt = Vis.DefaultSkySettings.SkyboxFt
            sky.SkyboxLf = Vis.DefaultSkySettings.SkyboxLf
            sky.SkyboxRt = Vis.DefaultSkySettings.SkyboxRt
            sky.SkyboxUp = Vis.DefaultSkySettings.SkyboxUp
        elseif sky then
            sky:Destroy()
        end
    end

