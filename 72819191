                UI.notify("Профиль скопирован: @" .. username)
            end
        end,
    })

    gServer:AddButton({
        Text = "Обновить список",
        Func = function() refreshPlrList() UI.notify("Список обновлён") end,
    })

    --// Сохраняем ссылки для выгрузки //--
    UI.PlayerMod = PlayerMod
    UI.stopFly = stopFly
    UI.stripCosmetics = stripCosmetics
end)

