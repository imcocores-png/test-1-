                    seat:Sit(hum)
                    task.delay(0.25, function()
                        while hum and hum.SeatPart do
                            pcall(function()
                                ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 1)
                            end)
                            task.wait(0.05)
                        end
                        ragSit = false
                    end)
                end)
            end
        end))
