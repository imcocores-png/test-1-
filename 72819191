--========================================================================--
--  DELTA INJECTOR SUPPORT                                                 --
--  Дельта обрезает часть функций — добавляем безопасные обёртки          --
--========================================================================--
local getgenv = getgenv or function() return _G end
if getgenv().ETHEREAL_UNLOAD then
    pcall(getgenv().ETHEREAL_UNLOAD)
    task.wait(0.1)
end

--// Delta-specific: безопасные shim'ы для отсутствующих функций //--
local isDelta = false
do
    local ok, ident = pcall(function()
        if type(identifyexecutor) == "function" then
            return identifyexecutor()
        end
        return ""
    end)
    if ok and type(ident) == "string" and ident:lower():find("delta") then
        isDelta = true
    end
    --// Также ловим по getgenv флагам Delta //--
    if not isDelta then
        pcall(function()
            if getgenv().DELTA_HOOKED or getgenv().Delta then
                isDelta = true
            end
        end)
    end
end

--// Shim'ы: gethui, syn, drawlib и пр. — чтобы скрипт не падал на Дельте //--
if typeof(gethui) ~= "function" then
    getgenv().gethui = function()
        local cg = game:GetService("CoreGui")
        local ok, hidden = pcall(function()
            return cg:FindFirstChild("RobloxGui")
        end)
        return cg
    end
end

if typeof(getcustomasset) ~= "function" then
    getgenv().getcustomasset = function(path)
        return path
    end
end

if typeof(writefile) ~= "function" then
    getgenv().writefile = function() end
end

if typeof(isfile) ~= "function" then
    getgenv().isfile = function() return false end
end

if typeof(readfile) ~= "function" then
    getgenv().readfile = function() return "" end
end

if typeof(loadstring) ~= "function" then
    --// На совсем урезанных инжекторах пробуем через LoadString //--
    getgenv().loadstring = function(src)
        local fn, err = load(src, "ethereal_chunk")
        if not fn then return function() end end
        return fn
    end
end

--// request / http_get shim //--
if typeof(http_request) ~= "function" then
    if typeof(syn) == "table" and typeof(syn.request) == "function" then
        getgenv().http_request = syn.request
    elseif typeof(http_request) == "function" then
        --// уже есть //--
    end
end

--// На Дельте иногда отсутствует setclipboard — глушим //--
if typeof(setclipboard) ~= "function" then
    getgenv().setclipboard = function() end
end

