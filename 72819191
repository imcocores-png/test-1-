    gL:AddToggle("AntiRagBlob", {
        Text = "Anti Ragdoll (On Blob)",
        Default = false,
        Callback = function(v)
            antiRagBlob = v
            ragSit = false
            for _, c in ipairs(ragConns) do c:Disconnect() end
            ragConns = {}
            if v then
                watchBlob(getChar())
                table.insert(ragConns, LocalPlayer.CharacterAdded:Connect(watchBlob))
            end
        end,
    })

    gL:AddToggle("AntiSnowball", {
        Text = "Anti Snowball",
        Default = false,
        Callback = function(v)
            UI.state.AntiSnowball = v
            if v then
                task.spawn(function()
                    while UI.state.AntiSnowball and task.wait(0.05) do
                        pcall(function()
