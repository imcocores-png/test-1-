-- Auto PCLD Break (из XOCO)
local PCLDActive = false
DefExtra:AddCheckbox("AutoPCLDBreak", {
    Text = "Auto PCLD Break", Default = false,
    Callback = function(Value)
        PCLDActive = Value
        if Value then
            task.spawn(function()
                local isFirstCycle = true
                while PCLDActive do
                    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    local hrp = char:WaitForChild("HumanoidRootPart", 5)
                    local hum = char:WaitForChild("Humanoid", 5)
                    if not (hrp and hum) then task.wait(0.5) continue end

                    if hum.Health <= 0 then
                        char = LocalPlayer.CharacterAdded:Wait()
                        hrp = char:WaitForChild("HumanoidRootPart", 5)
                        hum = char:WaitForChild("Humanoid", 5)
                    end
                    if not (hrp and hum) then continue end

                    if isFirstCycle then
                        local savedCFrame = hrp.CFrame
                        hrp.CFrame = CFrame.new(hrp.Position.X, 50000, hrp.Position.Z)
                        task.wait(0.05)
                        hum.Health = 0
                        char = LocalPlayer.CharacterAdded:Wait()
                        if not PCLDActive then break end
                        hrp = char:WaitForChild("HumanoidRootPart", 5)
                        hum = char:WaitForChild("Humanoid", 5)
                        if hrp and hum then
                            task.wait(0.1)
                            hrp.CFrame = savedCFrame
                            task.wait(0.05)
                            hum.Health = 0
                        end
                        isFirstCycle = false
                    else
                        task.wait(0.1)
                        if hum then
                            hum.Health = 0
                            pcall(function() char:BreakJoints() end)
                        end
                    end

                    char = LocalPlayer.CharacterAdded:Wait()
                    if not PCLDActive then break end
                    hum = char:WaitForChild("Humanoid", 5)
                    if hum then hum.Died:Wait() end
                end
            end)
        end
    end
})

