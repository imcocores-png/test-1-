-- ====================== ANTI RAGDOLL ULTRA ======================
local aruOn = false
local aruConns = {}

local function applyRagdollUltra(char)
    if not char or not aruOn then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local head = char:FindFirstChild("Head", 5)
        if not (hum and hrp and head) then return end
        local ragVal = hum:WaitForChild("Ragdolled", 5)

        local function disableCons()
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                    v.BallSocketConstraint.Enabled = false
                    if v:FindFirstChild("RagdollLimbPart") then
                        v.RagdollLimbPart.WeldConstraint.Enabled = false
                    end
                end
            end
        end

        disableCons()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        if ragVal then
            table.insert(aruConns, ragVal.Changed:Connect(function()
                if ragVal.Value and aruOn then
                    task.spawn(function()
                        disableCons()
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        hum.Sit = false
                        pcall(function() ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0) end)
                    end)
                end
            end))
        end

        local weldHRP = hrp:WaitForChild("WeldHRP", 5)
        if weldHRP then
            table.insert(aruConns, weldHRP.Changed:Connect(function()
                if weldHRP.Enabled and aruOn then
                    task.spawn(function()
                        hum.AutoRotate = true
                        hum.HipHeight = 1
                        while weldHRP.Enabled and aruOn and hrp.Parent do
                            pcall(function() head.CFrame = hrp.CFrame + Vector3.new(0, 1.35, 0) end)
                            task.wait()
                        end
                        if hum.Parent then hum.HipHeight = 0 end
                    end)
                end
            end))
        end

        table.insert(aruConns, RunService.Heartbeat:Connect(function()
            if aruOn and ragVal and ragVal.Value and hum.Parent then
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    disableCons()
                end)
            end
        end))
    end)
end

