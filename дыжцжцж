local function applyHDSkybox(name)
    local existing = Lighting:FindFirstChild("KiopSky")
    if existing then existing:Destroy() end
    if name == "Default" then
        if originalSkyCF then
            local cur = Lighting:FindFirstChildOfClass("Sky")
            if cur then cur:Destroy() end
            originalSkyCF:Clone().Parent = Lighting
        end
        return
    end
    local ids = hdSkyboxes[name]
    if not ids then return end
    local oldSky = Lighting:FindFirstChildOfClass("Sky")
    if oldSky then oldSky:Destroy() end
    local sky = Instance.new("Sky")
    sky.Name = "KiopSky"
    sky.SkyboxBk = "rbxassetid://" .. ids[1]
    sky.SkyboxDn = "rbxassetid://" .. ids[2]
    sky.SkyboxFt = "rbxassetid://" .. ids[3]
    sky.SkyboxLf = "rbxassetid://" .. ids[4]
    sky.SkyboxRt = "rbxassetid://" .. ids[5]
    sky.SkyboxUp = "rbxassetid://" .. ids[6]
    sky.StarCount = 3000
    sky.Parent = Lighting
end

local function applyCustomSkybox(id)
    if not id or id == "" then return end
    local existing = Lighting:FindFirstChild("KiopSky")
    if existing then existing:Destroy() end
    local oldSky = Lighting:FindFirstChildOfClass("Sky")
    if oldSky then oldSky:Destroy() end
    local sky = Instance.new("Sky")
    sky.Name = "KiopSky"
    local url = "rbxassetid://" .. id
    sky.SkyboxBk = url sky.SkyboxDn = url sky.SkyboxFt = url
    sky.SkyboxLf = url sky.SkyboxRt = url sky.SkyboxUp = url
    sky.Parent = Lighting
end

