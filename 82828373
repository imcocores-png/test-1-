				if item:IsA("BasePart") or item:IsA("Model") then
					local targetPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item

					if targetPart and not item:FindFirstChild("DemoHorror_ESP") then
						local highlight = Instance.new("Highlight")
						highlight.Name = "DemoHorror_ESP"
						highlight.Adornee = item:IsA("Model") and item or targetPart
						highlight.FillColor = Color3.fromRGB(0, 120, 255)
						highlight.FillTransparency = 0.5
						highlight.OutlineColor = Color3.fromRGB(0, 80, 255)
						highlight.OutlineTransparency = 0
						highlight.Parent = item:IsA("Model") and item or targetPart
						table.insert(itemHighlights, highlight)
					end
				end
			end
		end
	end

	-- ESP РЅР° РјРѕРЅСЃС‚СЂРѕРІ (РєСЂР°СЃРЅР°СЏ РїРѕРґСЃРІРµС‚РєР°)
	-- РњРѕРЅСЃС‚СЂС‹ РѕР±С‹С‡РЅРѕ РІ workspace/Entities РёР»Рё workspace/Monsters
	-- РђРґР°РїС‚РёСЂСѓР№ РїСѓС‚СЊ РїРѕРґ СЃРІРѕСЋ РёРіСЂСѓ!
