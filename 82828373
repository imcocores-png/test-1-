		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local char = player.Character
				local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChildWhichIsA("BasePart")

				if rootPart then
					-- РЎРѕР·РґР°С‘Рј РїРѕРґСЃРІРµС‚РєСѓ РµСЃР»Рё РЅРµС‚
